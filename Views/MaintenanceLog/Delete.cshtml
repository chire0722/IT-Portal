@model IT_Form.Models.MaintenanceLog

@{
    ViewData["Title"] = "Delete Maintenance Log";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>Delete Maintenance Log</h4>
            </div>
            <div class="card-body">
                <h5 class="card-title text-center mb-4">Are you sure you want to delete this log?</h5>

                <div class="bg-light p-3 rounded mb-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Asset:</dt>
                        <dd class="col-sm-8 fw-bold">@Model.ITAsset?.AssetTag</dd>

                        <dt class="col-sm-4">Date:</dt>
                        <dd class="col-sm-8">@Model.ServiceDate.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4">Description:</dt>
                        <dd class="col-sm-8">@Model.Description</dd>

                        <dt class="col-sm-4">Cost:</dt>
                        <dd class="col-sm-8">@(Model.Cost?.ToString("C") ?? "-")</dd>
                    </dl>
                </div>

                <div class="mb-4 text-center">
                    <label for="deleteConfirmation" class="form-label text-danger">Type <strong>DELETE</strong> below to
                        confirm:</label>
                    <input type="text" class="form-control text-center text-danger fw-bold mx-auto"
                        id="deleteConfirmation" autocomplete="off" style="max-width: 200px;" />
                </div>

                <form asp-action="Delete" class="d-flex justify-content-between">
                    <input type="hidden" asp-for="Id" />
                    <a asp-controller="ITAsset" asp-action="Details" asp-route-id="@Model.ITAssetId"
                        class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-danger" id="btnConfirmDelete" disabled>Yes, Delete Log</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const deleteInput = document.getElementById('deleteConfirmation');
            const deleteBtn = document.getElementById('btnConfirmDelete');

            deleteInput.addEventListener('input', function () {
                if (this.value === 'DELETE') {
                    deleteBtn.disabled = false;
                } else {
                    deleteBtn.disabled = true;
                }
            });
            deleteInput.focus();
        });
    </script>
}



    }

    .audit-row-failed td:first-child {
        box-shadow: inset 3px 0 0 rgba(220, 53, 69, 0.85);
    }

    .audit-row-correlated td:first-child {
        box-shadow: inset 3px 0 0 rgba(22, 79, 159, 0.75);
    }

    .audit-row-failed.audit-row-correlated td:first-child {
        box-shadow: inset 3px 0 0 rgba(220, 53, 69, 0.85);
    }

    .audit-empty-state {
        text-align: center;
        padding: 3.5rem 1.5rem;
    }

    .audit-empty-icon {
        width: 64px;
        height: 64px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        margin-bottom: 1rem;
        color: var(--audit-blue);
        background: var(--audit-blue-soft);

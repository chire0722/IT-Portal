@section Scripts {
    <script>
        // ─── Delete Software Modal ──────────────────────
        const deleteSoftwareModal = new bootstrap.Modal(document.getElementById('deleteSoftwareModal'));

        function openDeleteSoftware(id, name) {
            document.getElementById('deleteSoftwareDisplay').textContent = name;
            document.getElementById('deleteSoftwareForm').action = '/StandardSoftware/Delete/' + id;
            document.getElementById('deleteSoftwareError').classList.add('d-none');
            deleteSoftwareModal.show();
        }

        // ─── Delete Version Modal ────────────────────────
        const deleteVersionModal = new bootstrap.Modal(document.getElementById('deleteVersionModal'));

        function openDeleteVersion(id, name) {
            document.getElementById('deleteVersionDisplay').textContent = name;
            document.getElementById('deleteVersionForm').action = '/StandardSoftware/DeleteLicense/' + id;
            document.getElementById('deleteVersionError').classList.add('d-none');
            deleteVersionModal.show();
        }

        // ─── CSRF Token Helper ───────────────────────────
        const getToken = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        // ─── Employees cache ───────────────────────────
        let employeesCache = null;
        async function loadEmployees() {
            if (employeesCache) return employeesCache;
            try {
                const res = await fetch('/StandardSoftware/GetEmployees');
                employeesCache = await res.json();
            } catch { employeesCache = []; }
            return employeesCache;
        }

        // ─── Toggle keys panel and load via AJAX ────────
        function toggleKeys(versionId, parentId) {
            if (parentId) {
                const parentPanel = document.getElementById('versions_' + parentId);
                if (parentPanel && !parentPanel.classList.contains('show') && !parentPanel.classList.contains('collapsing')) {
                    bootstrap.Collapse.getOrCreateInstance(parentPanel).show();
                }
            }
            
            const panel = document.getElementById('keysPanel_' + versionId);
            const isOpening = !panel.classList.contains('show') && !panel.classList.contains('collapsing');
            
            bootstrap.Collapse.getOrCreateInstance(panel).toggle();

            if (isOpening) {
                loadKeys(versionId);
            }
        }

        // ─── Load Keys via AJAX ─────────────────────────
        async function loadKeys(versionId) {
            const container = document.getElementById('keysContainer_' + versionId);
            container.innerHTML = '<div class="text-center py-2"><div class="spinner-border spinner-border-sm text-primary" role="status"></div> <span class="text-muted small">Loading...</span></div>';

            try {
                const res = await fetch('/StandardSoftware/GetKeys?softwareId=' + versionId);
                const data = await res.json();
                const keys = data.keys;

                // Update badge count
                const badge = document.getElementById('keyCount_' + versionId);
                if (badge) badge.textContent = keys.length;

                if (keys.length === 0) {
                    container.innerHTML = '<p class="text-muted small fst-italic mb-0">No license keys added yet.</p>';
                    return;
                }

                let html = `<table class="table table-sm table-borderless mb-0" style="font-size:0.85rem;">
                                            <thead><tr class="text-muted">
                                                <th style="font-size:0.7rem;">LICENSE KEY</th>
                                                <th style="font-size:0.7rem;">STATUS</th>
                                                <th style="font-size:0.7rem;">ASSIGNED TO</th>
                                                <th class="text-end" style="font-size:0.7rem;">ACTIONS</th>
                                            </tr></thead><tbody>`;

                keys.forEach(k => {
                    const statusBadge = k.isAssigned
                        ? '<span class="badge bg-success">In Use</span>'
                        : '<span class="badge bg-secondary">Available</span>';

                    const assignedName = k.assignedTo || '—';

                    let safeKey = escapeHtml(k.keyValue).replace(/'/g, '&#39;');
                    let displayKey = `<code class="text-primary fw-bold">${safeKey}</code>`;
                    let canEdit = true;
                    
                    if (safeKey.startsWith('[Account-Linked]:')) {
                        const email = safeKey.replace('[Account-Linked]:', '').trim();
                        displayKey = `<span class="badge bg-primary bg-opacity-10 text-primary border border-primary"><i class="bi bi-envelope-check me-1" aria-hidden="true"></i>Account: ${email}</span>`;
                        safeKey = `Account Linked: ${email}`;
                        canEdit = false;
                    } else if (safeKey === 'Subscription Seat') {
                        displayKey = `<span class="text-muted fst-italic"><i class="bi bi-person-dash me-1" aria-hidden="true"></i>Unassigned Seat</span>`;
                        canEdit = false;
                    }

                    const editBtn = canEdit ? `<button class="btn btn-sm btn-outline-warning" onclick="openEditKey(${k.id}, '${safeKey}', ${versionId})" title="Edit Key"><i class="bi bi-pencil me-1" aria-hidden="true"></i>Edit</button>` : '';

                    const assignBtn = k.isAssigned
                        ? `<button class="btn btn-sm btn-outline-danger" onclick="openAssignKey(${k.id}, '${safeKey}', ${versionId}, ${k.onboardingRequestId || 0}, true)" title="Unassign Seat"><i class="bi bi-person-x me-1" aria-hidden="true"></i>Unassign</button>`
                        : `<button class="btn btn-sm btn-outline-success" onclick="openAssignKey(${k.id}, '${safeKey}', ${versionId}, ${k.onboardingRequestId || 0}, false)" title="Assign Seat"><i class="bi bi-person-check me-1" aria-hidden="true"></i>Assign</button>`;

                    const deleteBtn = k.isAssigned
                        ? '<button class="btn btn-sm btn-outline-secondary" disabled title="Cannot delete assigned key"><i class="bi bi-lock me-1" aria-hidden="true"></i>Locked</button>'
                        : `<button class="btn btn-sm btn-outline-danger" onclick="deleteKey(${k.id}, ${versionId})" title="Delete Key"><i class="bi bi-trash me-1" aria-hidden="true"></i>Delete</button>`;

                    html += `<tr>
                                                <td>${displayKey}</td>
                                                <td>${statusBadge}</td>
                                                <td class="text-muted small">${escapeHtml(assignedName)}</td>
                                                <td class="text-end">
                                                    <div class="d-flex gap-1 justify-content-end">
                                                        ${editBtn} ${assignBtn} ${deleteBtn}
                                                    </div>
                                                </td>
                                            </tr>`;
                });

                html += '</tbody></table>';
                container.innerHTML = html;
            } catch (err) {
                container.innerHTML = '<p class="text-danger small">Failed to load keys.</p>';
            }
        }

        // ─── Add Key (AJAX) ─────────────────────────────
        async function quickAllocate(versionId) {
            const msgEl = document.getElementById('addKeyMsg_' + versionId);
            const msgHeaderEl = document.getElementById('addKeyMsg_header_' + versionId);
            
            try {
                const res = await fetch('/StandardSoftware/QuickAllocateSeat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-XSRF-TOKEN': getToken() },
                    body: `softwareId=${versionId}`
                });
                
                const successHtml = '<span class="text-success"><i class="bi bi-check-circle me-1" aria-hidden="true"></i>Seat Added!</span>';
                
                if (res.ok) {
                    if (msgEl) msgEl.innerHTML = successHtml;
                    if (msgHeaderEl) msgHeaderEl.innerHTML = successHtml;
                    
                    setTimeout(() => {
                        if (msgEl) msgEl.innerHTML = '';
                        if (msgHeaderEl) msgHeaderEl.innerHTML = '';
                    }, 2000);
                    loadKeys(versionId);
                } else {
                    const msg = await res.text();
                    const errorHtml = `<span class="text-danger">${msg || 'Failed.'}</span>`;
                    if (msgEl) msgEl.innerHTML = errorHtml;
                    if (msgHeaderEl) msgHeaderEl.innerHTML = errorHtml;
                }
            } catch (err) {
                const networkError = '<span class="text-danger">Network error.</span>';
                if (msgEl) msgEl.innerHTML = networkError;
                if (msgHeaderEl) msgHeaderEl.innerHTML = networkError;
            }
        }

        async function addKey(versionId) {
            const input = document.getElementById('newKey_' + versionId);
            const msgEl = document.getElementById('addKeyMsg_' + versionId);
            const keyValue = input.value.trim();

            if (!keyValue) {
                input.classList.add('is-invalid');
                return;
            }
            input.classList.remove('is-invalid');

            try {
                const res = await fetch('/StandardSoftware/AddKey', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-XSRF-TOKEN': getToken() },
                    body: `softwareId=${versionId}&keyValue=${encodeURIComponent(keyValue)}`
                });
                if (res.ok) {
                    input.value = '';
                    msgEl.innerHTML = '<span class="text-success"><i class="bi bi-check-circle me-1" aria-hidden="true"></i>Added!</span>';
                    setTimeout(() => msgEl.innerHTML = '', 2000);
                    loadKeys(versionId);
                } else {
                    const msg = await res.text();
                    msgEl.innerHTML = `<span class="text-danger">${msg || 'Failed.'}</span>`;
                }
            } catch {
                msgEl.innerHTML = '<span class="text-danger">Network error.</span>';
            }
        }

        // ─── Delete Key Modal ────────────────────────────
        const deleteKeyModal = new bootstrap.Modal(document.getElementById('deleteKeyModal'));

        function deleteKey(keyId, versionId) {
            document.getElementById('deleteKeyId').value = keyId;
            document.getElementById('deleteKeyVersionId').value = versionId;
            document.getElementById('deleteKeyError').classList.add('d-none');
            // Grab key text from the table row
            const btn = document.querySelector(`button[onclick*="deleteKey(${keyId},"]`);
            const row = btn ? btn.closest('tr') : null;
            const keyText = row ? row.querySelector('code')?.textContent : '';
            document.getElementById('deleteKeyDisplay').textContent = keyText || 'Key #' + keyId;
            deleteKeyModal.show();
        }

        async function confirmDeleteKey() {
            const keyId = document.getElementById('deleteKeyId').value;
            const versionId = document.getElementById('deleteKeyVersionId').value;
            const errEl = document.getElementById('deleteKeyError');
            const btn = document.getElementById('confirmDeleteKeyBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Deleting...';

            try {
                const res = await fetch('/StandardSoftware/DeleteKey', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json', 'X-XSRF-TOKEN': getToken() },
                    body: `id=${keyId}`
                });
                if (res.ok) {
                    deleteKeyModal.hide();
                    loadKeys(versionId);
                } else {
                    let errMsg = 'Failed to delete key.';
                    try { errMsg = await res.text(); } catch { }
                    errEl.textContent = errMsg;
                    errEl.classList.remove('d-none');
                }
            } catch (e) {
                errEl.textContent = 'Network error: ' + e.message;
                errEl.classList.remove('d-none');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-trash me-1" aria-hidden="true"></i>Delete Key';
            }
        }

        // ─── Edit Key Modal ─────────────────────────────
        const editKeyModal = new bootstrap.Modal(document.getElementById('editKeyModal'));

        function openEditKey(keyId, keyValue, versionId) {
            document.getElementById('editKeyId').value = keyId;
            document.getElementById('editKeyVersionId').value = versionId;
            document.getElementById('editKeyValue').value = keyValue;
            document.getElementById('editKeyError').classList.add('d-none');
            editKeyModal.show();
        }

        async function saveEditKey() {
            const keyId = document.getElementById('editKeyId').value;
            const versionId = document.getElementById('editKeyVersionId').value;
            const keyValue = document.getElementById('editKeyValue').value.trim();
            const errEl = document.getElementById('editKeyError');

            if (!keyValue) {
                errEl.textContent = 'Key value is required.';
                errEl.classList.remove('d-none');
                return;
            }

            try {
                const res = await fetch('/StandardSoftware/UpdateKey', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-XSRF-TOKEN': getToken() },
                    body: `id=${keyId}&keyValue=${encodeURIComponent(keyValue)}`
                });
                if (res.ok) {
                    editKeyModal.hide();
                    loadKeys(versionId);
                } else {
                    errEl.textContent = await res.text() || 'Failed to update.';
                    errEl.classList.remove('d-none');
                }
            } catch {
                errEl.textContent = 'Network error.';
                errEl.classList.remove('d-none');
            }
        }

        // ─── Assign Key Modal ───────────────────────────
        const assignKeyModal = new bootstrap.Modal(document.getElementById('assignKeyModal'));

        async function openAssignKey(keyId, keyValue, versionId, currentEmployeeId, isAssigned) {
            document.getElementById('assignKeyId').value = keyId;
            document.getElementById('assignKeyVersionId').value = versionId;
            document.getElementById('isCurrentlyAssigned').value = isAssigned ? 'true' : 'false';
            document.getElementById('assignKeyDisplay').value = keyValue;
            document.getElementById('assignKeyError').classList.add('d-none');

            const header = document.getElementById('assignKeyModalHeader');
            const title = document.getElementById('assignKeyModalLabel');
            const saveBtn = document.getElementById('saveAssignKeyBtn');
            const warning = document.getElementById('unassignWarning');
            const wrapper = document.getElementById('assignEmployeeWrapper');

            if (isAssigned) {
                header.className = 'modal-header py-2 bg-danger bg-opacity-25 border-0';
                title.innerHTML = '<i class="bi bi-person-x me-2" aria-hidden="true"></i>Confirm Unassignment';
                saveBtn.className = 'btn btn-sm btn-danger';
                saveBtn.innerHTML = '<i class="bi bi-check-lg me-1" aria-hidden="true"></i>Confirm Unassign';
                
                warning.classList.remove('d-none');
                wrapper.classList.add('d-none');
            } else {
                header.className = 'modal-header py-2 bg-success bg-opacity-25 border-0';
                title.innerHTML = '<i class="bi bi-person-check me-2" aria-hidden="true"></i>Assign License Key';
                saveBtn.className = 'btn btn-sm btn-success';
                saveBtn.innerHTML = '<i class="bi bi-check-lg me-1" aria-hidden="true"></i>Save Assignment';

                warning.classList.add('d-none');
                wrapper.classList.remove('d-none');
            }

            const select = document.getElementById('assignEmployeeSelect');
            select.innerHTML = '<option value="">— Unassign —</option>';

            const employees = await loadEmployees();
            employees.forEach(emp => {
                const opt = document.createElement('option');
                opt.value = emp.id;
                opt.textContent = emp.name;
                if (emp.id === currentEmployeeId) opt.selected = true;
                select.appendChild(opt);
            });

            assignKeyModal.show();
        }

        async function saveAssignKey() {
            const keyId = document.getElementById('assignKeyId').value;
            const versionId = document.getElementById('assignKeyVersionId').value;
            const isAssigned = document.getElementById('isCurrentlyAssigned').value === 'true';
            
            // If in unassign mode, force employeeId to "" (Unassign)
            const employeeId = isAssigned ? "" : document.getElementById('assignEmployeeSelect').value;
            
            const errEl = document.getElementById('assignKeyError');

            try {
                const res = await fetch('/StandardSoftware/AssignKey', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-XSRF-TOKEN': getToken() },
                    body: `id=${keyId}&onboardingRequestId=${employeeId}`
                });
                if (res.ok) {
                    assignKeyModal.hide();
                    loadKeys(versionId);
                } else {
                    errEl.textContent = await res.text() || 'Failed to assign.';
                    errEl.classList.remove('d-none');
                }
            } catch {
                errEl.textContent = 'Network error.';
                errEl.classList.remove('d-none');
            }
        }

        // ─── Helpers ─────────────────────────────────────
        function toggleKeyInput(itemId, checkbox) {
            const keyWrapper = document.getElementById('keyWrapper_' + itemId);
            const subFields = document.getElementById('subFields_' + itemId);
            const isFree = document.getElementById('free_' + itemId).checked;
            const expiryCol = document.getElementById('expiryCol_' + itemId);

            if (keyWrapper) {
                keyWrapper.style.display = (checkbox.checked || isFree) ? 'none' : 'flex';
            }
            if (subFields) {
                subFields.style.display = (checkbox.checked && !isFree) ? 'flex' : 'none';
                
                // Toggle required tags (Vendor name no longer mandatory as requested)
                // const vendorInput = subFields.querySelector('input[name="vendorName"]');
                // if (vendorInput) vendorInput.required = checkbox.checked && !isFree;
            }
            
            if (expiryCol) {
                expiryCol.style.display = isFree ? 'none' : 'block';
            }
        }

        function toggleFreeInput(itemId, checkbox) {
            const subCheckbox = document.getElementById('sub_' + itemId);
            const subWrapper = document.getElementById('subWrapper_' + itemId);
            const keyWrapper = document.getElementById('keyWrapper_' + itemId);
            const subFields = document.getElementById('subFields_' + itemId);
            const expiryCol = document.getElementById('expiryCol_' + itemId);

            if (checkbox.checked) {
                if (subCheckbox) subCheckbox.checked = false; // Uncheck sub if Free is checked
                if (subWrapper) subWrapper.style.display = 'none';
                if (keyWrapper) keyWrapper.style.display = 'none';
                if (subFields) subFields.style.display = 'none';
                if (expiryCol) expiryCol.style.display = 'none';
            } else {
                if (subWrapper) subWrapper.style.display = 'block';
                if (expiryCol) expiryCol.style.display = 'block';
                toggleKeyInput(itemId, subCheckbox);
            }
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // ─── Edit Version Logic ─────────────────────────
        let verModalInstance = null;

        function openEditVersionModal(btn) {
            if (!verModalInstance) {
                const el = document.getElementById('editVersionModal');
                if (el) verModalInstance = new bootstrap.Modal(el);
            }

            const d = btn.dataset;
            document.getElementById('editVerId').value = d.id;
            document.getElementById('editVerName').value = d.name || '';
            document.getElementById('editVerDescription').value = d.description || '';
            document.getElementById('editVerIsSubscription').checked = d.issub === 'true';
            document.getElementById('editVerIsFree').checked = d.isfree === 'true';
            document.getElementById('editVerExpiryDate').value = d.expiry || '';
            document.getElementById('editVerContractLimit').value = d.limit || 0;
            document.getElementById('editVerVendor').value = d.vendor || '';
            document.getElementById('editVerSupport').value = d.support || '';
            const companyIds = (d.companyIds || '').split(',').filter(Boolean);
            document.getElementById('editVerCompanyIds').value = companyIds[0] || '';
            
            document.getElementById('editVerError').classList.add('d-none');
            toggleEditVerFields();
            
            if (verModalInstance) verModalInstance.show();
        }

        function toggleEditVerFields() {
            const isSub = document.getElementById('editVerIsSubscription');
            const isFree = document.getElementById('editVerIsFree');
            const subWrapper = document.getElementById('editVerSubWrapper');
            const subFields = document.getElementById('editVerSubFields');
            const expiryCol = document.getElementById('editVerExpiryCol');
            const seatLimitCol = document.getElementById('editVerSeatLimitCol');

            if (isFree.checked) {
                isSub.checked = false;
                subWrapper.style.display = 'none';
                subFields.style.display = 'none';
                expiryCol.style.display = 'none';
                seatLimitCol.style.display = 'none';
            } else {
                subWrapper.style.display = 'block';
                expiryCol.style.display = 'block';
                subFields.style.display = isSub.checked ? 'block' : 'none';
                seatLimitCol.style.display = isSub.checked ? 'block' : 'none';
            }
        }

        async function saveVersionEdit() {
            const btn = document.getElementById('saveVerEditBtn');
            const form = document.getElementById('editVersionForm');
            const errEl = document.getElementById('editVerError');
            
            const formData = new URLSearchParams(new FormData(form));
            // Ensure checkboxes send false if unchecked
            if (!document.getElementById('editVerIsSubscription').checked) formData.set('isSubscription', 'false');
            if (!document.getElementById('editVerIsFree').checked) formData.set('isFree', 'false');

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving...';
            errEl.classList.add('d-none');

            try {
                const res = await fetch('/StandardSoftware/EditLicense', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-XSRF-TOKEN': getToken() },
                    body: formData.toString()
                });
                
                const data = await res.json();
                if (data.success) {
                    if (verModalInstance) verModalInstance.hide();
                    window.location.reload(); // Reload to see visual changes in list
                } else {
                    errEl.textContent = data.message || 'Update failed.';
                    errEl.classList.remove('d-none');
                }
            } catch (e) {
                errEl.textContent = 'Network error: ' + e.message;
                errEl.classList.remove('d-none');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-lg me-1" aria-hidden="true"></i>Save Changes';
            }
        }
    </script>
}


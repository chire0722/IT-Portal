@* Project comment: Step2.cshtml renders part of the IT Form web user interface. *@

@model IT_Form.ViewModels.OnboardingViewModel
@using IT_Form.Helpers
@using IT_Form.Models.Enums
@{
    ViewData["Title"] = "Step 2 - IT Equipment";

    var assetCategoryOptions = Model.AssetCategoryOptions ?? new List<IT_Form.ViewModels.OnboardingAssetCategoryOptionViewModel>();
    var issuedAssets = Model.IssuedAssets ?? new List<IT_Form.ViewModels.AssetItemViewModel>();
    var categoryCount = Math.Min(assetCategoryOptions.Count, issuedAssets.Count);
    var selectedCategoryNames = assetCategoryOptions
        .Select(option => option.DisplayName)
        .ToHashSet(StringComparer.OrdinalIgnoreCase);
    var hasSeparateAccessoryCategories =
        selectedCategoryNames.Contains("Power Adaptor") ||
        selectedCategoryNames.Contains("Laptop Bag") ||
        selectedCategoryNames.Contains("Wireless Mouse") ||
        selectedCategoryNames.Contains("Wired Mouse");
}

<partial name="_WizardSteps" model="2" />

<div class="card animate-in" style="max-width: 900px; margin: 0 auto;">
    <div class="card-header">
        <h5 class="mb-0"><i class="fas fa-laptop me-2" style="color: var(--primary-light);" aria-hidden="true"></i>Assign IT Equipment & Accessories</h5>
        <small style="color: var(--text-muted);"><span class="badge bg-success me-1">HR</span> Select the required equipment. This is your final step before submitting the request to IT.</small>
    </div>
    <div class="card-body">
        <form asp-action="Step2" method="post" id="step2Form">
            <input type="hidden" asp-for="CurrentStep" />
            <input type="hidden" asp-for="Id" />

            <div id="fixedAssetsContainer">
                @if (categoryCount == 0)
                {
                    <div class="alert alert-warning py-2 mb-0" style="font-size: 0.85rem;">
                        <i class="fas fa-exclamation-triangle me-2" aria-hidden="true"></i>No default IT equipment categories are configured. You can still add custom equipment below.
                    </div>
                }
                else
                {
                    @for (int i = 0; i < categoryCount; i++)
                    {
                        var option = assetCategoryOptions[i];
                        var asset = issuedAssets[i];
                        var label = AssetCategoryHelper.GetRequestSelectionLabel(
                            option.AssetType,
                            option.OtherAssetType,
                            hasSeparateAccessoryCategories);

                        <input type="hidden" name="IssuedAssets[@i].AssetType" value="@((int)option.AssetType)" />
                        <input type="hidden" name="IssuedAssets[@i].OtherAssetType" value="@option.OtherAssetType" />
                        <input type="hidden" name="IssuedAssets[@i].Description" value="@asset.Description" />
                        <input type="hidden" name="IssuedAssets[@i].Qty" value="@(asset.Qty ?? 1)" />

                        <div class="d-flex align-items-center gap-3 py-2" style="border-bottom: 1px solid var(--border);">
                            <div class="fw-semibold" style="flex: 1;">@label</div>
                            <div class="d-flex align-items-center">
                                <div class="form-check mb-0">
                                    <input type="checkbox"
                                           name="IssuedAssets[@i].IsChecked"
                                           value="true"
                                           class="form-check-input asset-check"
                                           data-row="@i"
                                           id="assetCheck_@i"
                                           @(asset.IsChecked ? "checked" : "")
                                           style="cursor: pointer;" />
                                    <label class="form-check-label small text-muted fw-bold"
                                           for="assetCheck_@i"
                                           style="cursor: pointer; user-select: none;">Assign</label>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <h6 class="mt-4 mb-3 fw-bold">Custom or Other Equipment</h6>
            <div id="customAssetsContainer">
                @for (int i = categoryCount; i < issuedAssets.Count; i++)
                {
                    var asset = issuedAssets[i];
                    var isCustom = asset.AssetType == AssetType.Others && string.IsNullOrWhiteSpace(asset.OtherAssetType);

                    if (isCustom)
                    {
                        <div class="custom-asset-row d-flex align-items-center gap-3 py-2" style="border-bottom: 1px solid var(--border);">
                            <input type="hidden" name="IssuedAssets[@i].AssetType" value="@((int)AssetType.Others)" />
                            <input type="hidden" name="IssuedAssets[@i].OtherAssetType" value="" />
                            <input type="hidden" name="IssuedAssets[@i].IsChecked" value="true" />
                            <input type="hidden" name="IssuedAssets[@i].Qty" value="@(asset.Qty ?? 1)" />
                            <input type="text"
                                   name="IssuedAssets[@i].Description"
                                   value="@asset.Description"
                                   class="form-control form-control-sm"
                                   placeholder="Custom item description..."
                                   style="max-width: 400px;" />
                            <button type="button" class="btn btn-sm btn-outline-danger remove-custom-row ms-auto" title="Remove">&times;</button>
                        </div>
                    }
                }
            </div>

            <button type="button" id="btnAddMoreAsset" class="btn btn-sm btn-outline-secondary mt-2">
                <i class="fas fa-plus me-1" aria-hidden="true"></i> Add Another Custom Item
            </button>

            <div class="mt-3">
                <label asp-for="AssetRemarks" class="form-label"><i class="fas fa-comment me-1" aria-hidden="true"></i>Remarks</label>
                <textarea asp-for="AssetRemarks" class="form-control" rows="2" placeholder="Any additional notes about the equipment..."></textarea>
            </div>

            <div class="alert alert-info mt-3 py-2" style="font-size: 0.85rem;">
                <i class="fas fa-info-circle me-1" aria-hidden="true"></i>
                <strong>Note:</strong> Brand, model, and serial number will be filled in by the IT Admin after the equipment is assigned.
            </div>

            <div class="d-flex justify-content-between mt-4 pt-3" style="border-top: 1px solid var(--border);">
                <div>
                    <a asp-action="Step1" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-2" aria-hidden="true"></i>Previous
                    </a>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success" formnovalidate>
                        Review & Sign Form <i class="fas fa-arrow-right ms-2" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            let maxIndex = @(issuedAssets.Count - 1);

            document.getElementById('btnAddMoreAsset').addEventListener('click', function () {
                maxIndex++;

                const container = document.getElementById('customAssetsContainer');
                const row = document.createElement('div');
                row.className = 'custom-asset-row d-flex align-items-center gap-3 py-2 animate-in';
                row.style.borderBottom = '1px solid var(--border)';

                row.innerHTML = `
                    <input type="hidden" name="IssuedAssets[${maxIndex}].AssetType" value="@((int)AssetType.Others)" />
                    <input type="hidden" name="IssuedAssets[${maxIndex}].OtherAssetType" value="" />
                    <input type="hidden" name="IssuedAssets[${maxIndex}].IsChecked" value="true" />
                    <input type="hidden" name="IssuedAssets[${maxIndex}].Qty" value="1" />
                    <input type="text" name="IssuedAssets[${maxIndex}].Description" value=""
                        class="form-control form-control-sm" placeholder="Custom item description..."
                        style="max-width: 400px;" required />
                    <button type="button" class="btn btn-sm btn-outline-danger remove-custom-row ms-auto" title="Remove">&times;</button>
                `;

                container.appendChild(row);
            });

            document.getElementById('customAssetsContainer').addEventListener('click', function (e) {
                if (e.target.closest('.remove-custom-row')) {
                    const row = e.target.closest('.custom-asset-row');
                    row.remove();
                }
            });
        });
    </script>
}

@model IT_Form.Application.Features.Company.CompanyEditorPageViewModel
@using IT_Form.Helpers
@{ ViewData["Title"] = "Create Company"; }

<h2>Create Company</h2>
<div class="card shadow-sm border-0 mt-4" style="max-width: 600px;">
    <div class="card-body">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="mb-3">
                <label asp-for="Name" class="form-label font-weight-bold">Company Name</label>
                <input asp-for="Name" class="form-control shadow-sm" placeholder="e.g. YTC Precast" />
                <span asp-validation-for="Name" class="text-danger" aria-live="polite" aria-atomic="true"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Lot" class="form-label font-weight-bold">Lot / Address</label>
                <input asp-for="Lot" class="form-control shadow-sm" placeholder="Optional..." />
                <span asp-validation-for="Lot" class="text-danger" aria-live="polite" aria-atomic="true"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TimeZoneId" class="form-label font-weight-bold">Time Zone</label>
                <select asp-for="TimeZoneId" asp-items="CompanyTimeZoneHelper.GetSelectListItems(Model.TimeZoneId)" class="form-select shadow-sm time-zone-select" data-placeholder="Search a time zone by city or IANA ID">
                </select>
                <div class="form-text text-muted small">Used for signature dates and SLA deadline calculations. Type to search the full TZDB time zone list.</div>
                <span asp-validation-for="TimeZoneId" class="text-danger" aria-live="polite" aria-atomic="true"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="BusinessStartTime" class="form-label font-weight-bold">Business Start Time</label>
                    <input asp-for="BusinessStartTime" type="time" step="60" class="form-control shadow-sm" />
                    <span asp-validation-for="BusinessStartTime" class="text-danger" aria-live="polite" aria-atomic="true"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="BusinessEndTime" class="form-label font-weight-bold">Business End Time</label>
                    <input asp-for="BusinessEndTime" type="time" step="60" class="form-control shadow-sm" />
                    <span asp-validation-for="BusinessEndTime" class="text-danger" aria-live="polite" aria-atomic="true"></span>
                </div>
            </div>

            <div class="form-text text-muted small mb-4">
                These business hours and days are used when calculating onboarding and offboarding due date time for employees in this company.
            </div>

            <div class="mb-4">
                <label class="form-label font-weight-bold d-block">Business Days</label>
                <div class="d-flex flex-wrap gap-3">
                    <div class="form-check">
                        <input asp-for="WorksOnMonday" class="form-check-input" />
                        <label asp-for="WorksOnMonday" class="form-check-label">Mon</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="WorksOnTuesday" class="form-check-input" />
                        <label asp-for="WorksOnTuesday" class="form-check-label">Tue</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="WorksOnWednesday" class="form-check-input" />
                        <label asp-for="WorksOnWednesday" class="form-check-label">Wed</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="WorksOnThursday" class="form-check-input" />
                        <label asp-for="WorksOnThursday" class="form-check-label">Thu</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="WorksOnFriday" class="form-check-input" />
                        <label asp-for="WorksOnFriday" class="form-check-label">Fri</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="WorksOnSaturday" class="form-check-input" />
                        <label asp-for="WorksOnSaturday" class="form-check-label">Sat</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="WorksOnSunday" class="form-check-input" />
                        <label asp-for="WorksOnSunday" class="form-check-label">Sun</label>
                    </div>
                </div>
                <div class="form-text text-muted small">Due date time will skip any unchecked days for this company.</div>
            </div>

            <div class="mb-4">
                <label class="form-label font-weight-bold">Company Logo <span class="text-danger">*</span></label>
                <input type="file" name="Logo" id="Logo" class="form-control shadow-sm" accept="image/*" required data-drag-upload="true" />
                <div class="form-text text-muted small">Recommended size: 300x120px. Formats: JPG, PNG.</div>
                <span asp-validation-for="LogoPath" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsLoginPageLogo" class="form-check-input" />
                <label asp-for="IsLoginPageLogo" class="form-check-label">Use this logo on login page</label>
                <div class="form-text text-muted small">Only one company can be selected at a time.</div>
                <span asp-validation-for="IsLoginPageLogo" class="text-danger"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="IsActive" class="form-check-input" checked="checked" />
                <label asp-for="IsActive" class="form-check-label">Is Active</label>
            </div>

            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
        </form>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(function () {
            var placeholder = $('.time-zone-select').data('placeholder');
            $('.time-zone-select').select2({
                theme: 'bootstrap-5',
                width: '100%',
                minimumResultsForSearch: 0,
                placeholder: placeholder
            });
        });
    </script>

    <style>
        .select2-container--bootstrap-5 .select2-selection--single {
            min-height: calc(1.5em + 1rem + 2px);
            padding: 0.5rem 1rem;
            border-radius: 0.5rem;
            background-color: #fff;
        }

        .select2-container--bootstrap-5 .select2-selection__rendered {
            line-height: 1.5;
            padding-left: 0;
        }

        .select2-container--bootstrap-5 .select2-selection__arrow {
            height: 100%;
            right: 0.75rem;
        }
    </style>
}

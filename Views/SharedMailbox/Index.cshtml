@* Project comment: Index.cshtml renders part of the IT Form web user interface. *@

@model IT_Form.Application.Features.SharedMailbox.SharedMailboxIndexPageViewModel
@{
    ViewData["Title"] = "Shared Mailbox Management";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="h4 mb-0 fw-bold"><i class="bi bi-mailbox me-2 text-primary" aria-hidden="true"></i>Shared Mailbox Management</h2>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Report" class="btn btn-info text-white shadow-sm">
            <i class="bi bi-file-earmark-lock me-1" aria-hidden="true"></i> View All Access Report
        </a>
        <button class="btn btn-success shadow-sm rounded-pill px-4 py-2 fw-bold text-white" data-bs-toggle="modal" data-bs-target="#importModal">
            <i class="bi bi-upload me-1" aria-hidden="true"></i> Bulk Import
        </button>
        <a asp-action="Create" class="btn btn-primary shadow-sm d-inline-flex align-items-center justify-content-center gap-2">
            <i class="bi bi-plus-circle me-1"></i> Add Shared Mailbox
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label for="companyId" class="form-label">Company</label>
                <select name="companyId" class="form-select">
                    <option value="">All Companies</option>
                    @foreach (var company in Model.CompanyOptions)
                    {
                        if (Model.SelectedCompanyId == company.Id)
                        {
                            <option value="@company.Id" selected>@company.DisplayName</option>
                        }
                        else
                        {
                            <option value="@company.Id">@company.DisplayName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
            </div>
            <div class="col-6 col-md-2">
                <a asp-action="Index" class="btn btn-light border w-100">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">#</th>
                        <th>Mailbox Name</th>
                        <th>Mailbox Address</th>
                        <th style="min-width: 280px;">Company</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="ps-3 text-muted small">@item.Id</td>
                            <td class="fw-semibold">@item.MailboxName</td>
                            <td class="text-muted small">@item.MailboxAddress</td>
                            <td>
                                <div class="badge-group">
                                    @if (item.Companies != null && item.Companies.Any())
                                    {
                                        var companies = item.Companies.OrderBy(c => c).ToList();
                                        var displayCompanies = companies.Take(2);
                                        var remainingCount = companies.Count - 2;

                                        foreach (var c in displayCompanies)
                                        {
                                            <span class="badge-info">@c</span>
                                        }
                                        if (remainingCount > 0)
                                        {
                                            var allNames = string.Join(", ", companies);
                                            <span class="badge-overflow" data-bs-toggle="tooltip" data-bs-placement="top" title="@allNames">
                                                +@remainingCount more
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border shadow-sm" style="font-size: 0.75rem;">Global</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <a asp-action="Members" asp-route-id="@item.Id" class="btn btn-action-circle btn-outline-info me-1" title="View Members">
                                    <i class="bi bi-people"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-action-circle btn-outline-primary me-1" aria-label="Edit mailbox @item.MailboxName" title="Edit">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                    data-csp-confirm="Delete @item.MailboxName?">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-action-circle btn-outline-danger" aria-label="Delete mailbox @item.MailboxName" title="Delete"><i
                                            class="bi bi-trash" aria-hidden="true"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No shared mailboxes yet. Add one or use Bulk
                                Import.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Bulk Import Modal -->
<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 480px;">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header text-white border-0 py-3"
                style="background: linear-gradient(135deg,#1a9c56,#15803d);">
                <h5 class="modal-title fw-bold" id="importModalLabel">
                    <i class="bi bi-upload me-2" aria-hidden="true"></i>Shared Mailbox Bulk Import
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-info d-flex gap-2 py-2 px-3 rounded-3 mb-4" style="font-size:0.88rem;">
                    <i class="bi bi-info-circle-fill mt-1 flex-shrink-0" aria-hidden="true"></i>
                    <div>
                        <strong>Professional Template:</strong> Download the template — columns have the correct format
                        ready to fill.
                        <br />
                        <a asp-action="DownloadTemplate" class="fw-semibold text-decoration-none mt-1 d-inline-block">
                            <i class="bi bi-file-earmark-arrow-down me-1" aria-hidden="true"></i>Download Template (.xlsx)
                        </a>
                    </div>
                </div>
                <form asp-action="ImportExcel" method="post" enctype="multipart/form-data" id="importForm">
                    @Html.AntiForgeryToken()
                    <div class="mb-1">
                        <label class="form-label text-uppercase fw-bold"
                            style="font-size:0.72rem;letter-spacing:.08em;color:#6b7280;">
                            Select Excel File
                        </label>
                        <input type="file" name="file" accept=".xlsx,.xls" required data-drag-upload="true"
                            class="form-control border rounded-3" />
                    </div>
                    <p class="text-muted mb-0" style="font-size:0.78rem;">Maximum file size: 5MB. Only .xlsx files are
                        supported.</p>
                </form>
            </div>
            <div class="modal-footer border-0 px-4 pb-4 pt-0 gap-2">
                <button type="button" class="btn btn-light px-4 rounded-3" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="importForm" class="btn px-4 rounded-3 text-white fw-semibold"
                    style="background:linear-gradient(135deg,#1a9c56,#15803d);">
                    <i class="bi bi-cloud-upload me-2" aria-hidden="true"></i>Start Import
                </button>
            </div>
        </div>
    </div>

@section Scripts {
    <script>
        // Initialize Bootstrap Tooltips
        document.addEventListener('DOMContentLoaded', function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            });
        });
    </script>
}



                @if (hasITSig)
                {
                    <img src="@Model.ITAdminSignature" alt="IT Admin Signature" class="img-fluid border rounded bg-white p-2" style="max-height: 80px;" />
                    <p class="small text-success mt-2 mb-0">Signed by @(Model.ITAdminSignerName ?? "IT Admin")</p>
                    <p class="text-muted" style="font-size: 0.7rem;">@Model.ITAdminSignedAt?.ToString("g")</p>
                }
                else
                {
                    @if (isITUser && hasManagerSig)
                    {
                        <div class="p-3 bg-light border rounded text-muted small mb-2" style="border-style: dashed !important;">Awaiting IT Verification</div>
                        <form asp-action="SignOffITAdmin" method="post" class="d-grid gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            @if (!string.IsNullOrEmpty(Model.CurrentUserSignature))
                            {
                                <input type="hidden" name="signatureBase64" value="@Model.CurrentUserSignature" />
                                <button type="submit" class="btn btn-sm btn-primary">Sign & Complete Internal Approval</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-secondary" disabled>Signature Not Found</button>
                                <small class="text-muted">Set your signature in profile first.</small>
                            }
                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">Reject Request</button>
                        </form>
                    }
                    else if (isITUser)
                    {
                        <div class="p-3 bg-light border rounded text-muted small" style="border-style: dashed !important;">Please wait for Head of Department signature first.</div>
                    }
                    else
                    {
                        <div class="p-3 bg-light border rounded text-muted small" style="border-style: dashed !important;">Awaiting IT Signature</div>
                    }
                }
            </div>
        </div>

        <hr class="my-4" style="border-color: var(--border);" />
        <div class="text-center mb-4 mt-2">
            <h6 class="text-uppercase fw-bold text-muted mb-0" style="font-size: 0.85rem; letter-spacing: 1px;">
                <i class="bi bi-person-check me-2 text-primary" aria-hidden="true"></i>Employee Acknowledgements
            </h6>
        </div>

        <div class="row align-items-stretch g-4 justify-content-center">
            <!-- Employee Onboarding -->
            <div class="col-md-6 text-center border-end py-3">
                <h6 class="text-uppercase fw-bold text-muted mb-3" style="font-size: 0.8rem; letter-spacing: 0.5px;">Onboarding Acknowledgement</h6>
                <div class="d-flex flex-column align-items-center">
                    @if (Model.OnboardingRequest != null && !string.IsNullOrEmpty(Model.OnboardingRequest.EmployeeSignature))
                    {
                        <div class="d-flex align-items-center justify-content-center border rounded bg-white p-2 shadow-sm mb-2 mx-auto" style="width: 300px; height: 120px; max-width: 100%;">
                            <img src="@Model.OnboardingRequest.EmployeeSignature" alt="Employee Onboarding Signature" class="img-fluid" style="max-height: 100px;" />
                        </div>
                        <p class="text-success mt-1 mb-0 fw-medium" style="font-size: 0.75rem;"><i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i> Signed by @(Model.OnboardingRequest.EmployeeSignerName ?? Model.OnboardingRequest.FullName ?? "Employee") on @(Model.OnboardingRequest.EmployeeSignedAt?.ToString("dd/MM/yyyy HH:mm:ss"))</p>
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center p-3 bg-light border rounded text-muted text-center mx-auto shadow-sm" style="border-style: dashed !important; width: 300px; height: 120px; max-width: 100%;">
                            <div>
                                <i class="bi bi-slash-circle d-block mb-1 fs-5" aria-hidden="true"></i>
                                <span class="fw-bold text-uppercase" style="letter-spacing: 0.5px; font-size: 0.7rem;">No signature on record</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Employee Offboarding -->
            <div class="col-md-6 text-center py-3">
                <h6 class="text-uppercase fw-bold text-muted mb-3" style="font-size: 0.8rem; letter-spacing: 0.5px;">Offboarding Acknowledgement</h6>
                <div class="d-flex flex-column align-items-center">
                    @if (!string.IsNullOrEmpty(Model.EmployeeSignature))
                    {
                        <div class="d-flex align-items-center justify-content-center border rounded bg-white p-2 shadow-sm mb-2 mx-auto" style="width: 300px; height: 120px; max-width: 100%;">
                            <img src="@Model.EmployeeSignature" alt="Employee Offboarding Signature" class="img-fluid" style="max-height: 100px;" />
                        </div>
                        <p class="text-success mt-1 mb-0 fw-medium" style="font-size: 0.75rem;"><i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i> Signed by @(Model.EmployeeSignerName ?? Model.FullName ?? "Employee") on @(Model.EmployeeSignedAt?.ToString("dd/MM/yyyy HH:mm:ss"))</p>
                    }
                    else if (Model.Status == RequestStatus.PendingEmployeeSign)
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center p-3 bg-light border rounded text-warning text-center shadow-sm mb-3 mx-auto" style="border-style: dashed !important; width: 300px; height: 120px; max-width: 100%;">
                            <i class="bi bi-clock-history d-block mb-1 fs-5" aria-hidden="true"></i>
                            <span class="fw-bold text-uppercase" style="letter-spacing: 0.5px; font-size: 0.7rem;">Awaiting Signature</span>
                        </div>
                        
                        @if (isHRUser && !isITUser)

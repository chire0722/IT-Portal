@model IT_Form.Application.Features.ServerFolder.ServerFolderIndexPageViewModel
@{
    ViewData["Title"] = "Server Folder Management";
}

<div class="page-header animate-in">
    <div class="page-header-left">
        <h2><i class="bi bi-folder2-open me-2 text-primary" aria-hidden="true"></i>Server Folder Management</h2>
        <span class="subtitle">Manage company folder structures and baseline access rights</span>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Report" class="btn btn-sm btn-info text-white shadow-sm" aria-label="View global access report">
            <i class="bi bi-file-earmark-lock me-1" aria-hidden="true"></i> View All Access Report
        </a>
        <button type="button" class="btn btn-sm btn-success text-white shadow-sm" data-bs-toggle="modal" data-bs-target="#importModal">
            <i class="bi bi-upload me-1"></i> Bulk Import
        </button>
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="bi bi-folder-plus me-1"></i> Add Server Folder
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label for="companyId" class="form-label">Company</label>
                <select name="companyId" class="form-select">
                    <option value="">All Companies</option>
                    @foreach (var company in Model.CompanyOptions)
                    {
                        if (Model.SelectedCompanyId == company.Id)
                        {
                            <option value="@company.Id" selected>@company.DisplayName</option>
                        }
                        else
                        {
                            <option value="@company.Id">@company.DisplayName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
            </div>
            <div class="col-6 col-md-2">
                <a asp-action="Index" class="btn btn-light border w-100">Clear</a>
            </div>
        </form>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <div class="d-flex align-items-center">
            <i class="bi bi-check-circle-fill me-2 fs-5" aria-hidden="true"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["InfoMessage"] != null)
{
    <div class="alert alert-info alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <div class="d-flex align-items-center">
            <i class="bi bi-info-circle-fill me-2 fs-5" aria-hidden="true"></i>
            <div>@TempData["InfoMessage"]</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <div class="d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5" aria-hidden="true"></i>
            <div>@TempData["ErrorMessage"]</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card animate-in shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 80px;">ID</th>
                        <th>Folder Name</th>
                        <th style="min-width: 280px;">Company Scope</th>
                        <th>Status</th>
                        <th class="text-end pe-4" style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="ps-4 text-muted small">#@item.Id</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                        <i class="bi bi-folder-fill" aria-hidden="true"></i>
                                    </div>
                                    <span class="fw-bold text-dark">@item.FolderName</span>
                                </div>
                            </td>
                            <td>
                                <div class="badge-group">
                                    @if (item.Companies != null && item.Companies.Any())
                                    {
                                        var companies = item.Companies.OrderBy(c => c).ToList();
                                        var displayCompanies = companies.Take(2);
                                        var remainingCount = companies.Count - 2;

                                        foreach (var c in displayCompanies)
                                        {
                                            <span class="badge-info">@c</span>
                                        }
                                        if (remainingCount > 0)
                                        {
                                            var allNames = string.Join(", ", companies);
                                            <span class="badge-overflow" data-bs-toggle="tooltip" data-bs-placement="top" title="@allNames">
                                                +@remainingCount more
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border shadow-sm" style="font-size: 0.75rem;">Global</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge-approved">Active</span>
                                }
                                else
                                {
                                    <span class="badge-draft">Inactive</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="Members" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info"
                                       aria-label="View members for @item.FolderName" title="View Members">
                                        <i class="bi bi-people-fill"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"
                                       aria-label="Edit folder @item.FolderName" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Bulk Import Modal -->
<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 480px;">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header text-white border-0 py-3"
                style="background: var(--gradient-primary);">
                <h5 class="modal-title fw-bold" id="importModalLabel">
                    <i class="bi bi-upload me-2" aria-hidden="true"></i>Server Folder Bulk Import
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                    aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-info d-flex gap-2 py-2 px-3 rounded-3 mb-4" style="font-size:0.88rem;">
                    <i class="bi bi-info-circle-fill mt-1 flex-shrink-0" aria-hidden="true"></i>
                    <div>
                        <strong>Professional Template:</strong> Download the template — columns have the correct format
                        ready to fill.
                        <br />
                        <span class="text-muted small">Columns: <strong>Folder Name*</strong>,
                            <strong>Company*</strong>, <strong>Is Active (Yes/No)</strong></span>
                        <br />
                        <a asp-action="DownloadTemplate"
                            class="fw-semibold text-primary text-decoration-none mt-1 d-inline-block">
                            <i class="bi bi-file-earmark-arrow-down me-1" aria-hidden="true"></i>Download Template
                            (.xlsx)
                        </a>
                    </div>
                </div>
                <form asp-action="BulkImport" method="post" enctype="multipart/form-data" id="importForm">
                    @Html.AntiForgeryToken()
                    <div class="mb-1">
                        <label class="form-label text-uppercase fw-bold"
                            style="font-size:0.72rem;letter-spacing:.08em;color:#6b7280;">
                            Select Excel File
                        </label>
                        <input type="file" name="file" accept=".xlsx" required data-drag-upload="true" class="form-control border rounded-3" />
                    </div>
                    <p class="text-muted mb-0" style="font-size:0.78rem;">Maximum file size: 5MB. Only .xlsx files are
                        supported.</p>
                </form>
            </div>
            <div class="modal-footer border-0 px-4 pb-4 pt-0 gap-2">
                <button type="button" class="btn btn-light px-4 rounded-3 text-secondary fw-bold" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="importForm" class="btn px-4 rounded-3 text-white fw-bold"
                    style="background: var(--gradient-primary); border: none;">
                    <i class="bi bi-cloud-upload me-2" aria-hidden="true"></i>Start Import
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Initialize Bootstrap Tooltips
        document.addEventListener('DOMContentLoaded', function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            });
        });
    </script>
}

@* Project comment: Index.cshtml renders part of the IT Form web user interface. *@

@model IT_Form.Helpers.PaginatedList<IT_Form.Application.Features.Onboarding.GetOnboardingIndex.OnboardingIndexListItem>
@using IT_Form.Models.Enums
@using IT_Form.Helpers
@{
    ViewData["Title"] = "Dashboard";
    var currentFilter = ViewData["CurrentFilter"] as string;
    var statusFilter = ViewData["StatusFilter"] as RequestStatus?;
    var allRequests = Model;
    var slaTargetDays = ViewData["SlaTarget"] as int? ?? 3;
}

<div class="page-header">
    <div class="page-header-left">
        <h2><i class="bi bi-person-plus me-2" aria-hidden="true"></i>Onboarding Dashboard</h2>
        <span class="subtitle">Manage all employee onboarding requests</span>
    </div>
    <div class="d-flex gap-2">
        <button id="btnBulkExport" class="btn btn-sm btn-danger fw-bold shadow-sm px-3" style="display: none;">
            <i class="bi bi-file-earmark-zip me-2" aria-hidden="true"></i>Bulk PDF Sync (<span id="selectedCount">0</span>)
        </button>
        @if (!User.HasClaim("UserTitle", "IT"))
        {
            <a asp-action="ExportCsv" asp-route-searchString="@currentFilter"
               asp-route-status="@statusFilter" class="btn btn-sm btn-secondary shadow-sm px-3">
                <i class="bi bi-filetype-csv me-2" aria-hidden="true"></i>Export CSV
            </a>
            <a asp-controller="Onboarding" asp-action="Create" class="btn btn-sm btn-primary shadow-sm d-inline-flex align-items-center justify-content-center gap-2 px-3">
                <i class="bi bi-person-plus-fill me-1"></i> New Onboarding Request
            </a>
        }
    </div>
</div>

<div class="stats-row">
    <div class="stat-card stat-primary">
        <div class="stat-value">@Model.TotalCount</div>
        <div class="stat-label">Total Requests</div>
    </div>
    <div class="stat-card stat-warning">
        <div class="stat-value">@Model.Count(r => r.Status == RequestStatus.PendingITApproval)</div>
        <div class="stat-label">Pending IT Approval</div>
    </div>
    @if (User.HasClaim("UserTitle", "HR"))
    {
            <div class="stat-card stat-info">
                <div class="stat-value">@Model.Count(r => r.Status == RequestStatus.PendingEmployeeSign)</div>
                <div class="stat-label">Pending Employee Sign</div>
            </div>
    }
    <div class="stat-card stat-success">
        <div class="stat-value">@Model.Count(r => r.Status == RequestStatus.Completed || r.Status == RequestStatus.Approved)</div>
        <div class="stat-label">Completed</div>
    </div>
    <div class="stat-card stat-danger">
        <div class="stat-value">@Model.Count(r => r.Status == RequestStatus.Rejected)</div>
        <div class="stat-label">Rejected</div>
    </div>
</div>

<!-- Search & Filter -->
<div class="card animate-in mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small fw-bold">Search Name or ID</label>
                    <input type="text" name="searchString" class="form-control form-control-sm"
                        value="@currentFilter" placeholder="Search by name, ID, or department..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Status Filter</label>
                    <select name="status" class="form-select form-select-sm">
                        <option value="">All Statuses</option>
                        @foreach (var s in Enum.GetValues<RequestStatus>())
                        {
                            if (s == RequestStatus.PendingHODApproval) continue;
                                    <option value="@s" selected="@(statusFilter == s)">
                                @(s == RequestStatus.PendingITApproval ? "Pending IT Approval" : s == RequestStatus.PendingEmployeeSign ? "Pending Employee Sign" : s.ToString())
                                    </option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary btn-sm w-100">
                        <i class="bi bi-search me-1" aria-hidden="true"></i>Filter
                    </button>
                </div>
                <div class="col-md-2">
                    <a asp-action="Index" class="btn btn-secondary btn-sm w-100">
                        <i class="bi bi-x-circle me-1" aria-hidden="true"></i>Clear
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Requests Table -->
<div class="card animate-in">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
                                <div class="text-center py-5" style="color: var(--text-muted);">
                                    <i class="bi bi-clipboard-x" style="font-size: 3rem;" aria-hidden="true"></i>
                                    <h5 class="mt-3">No onboarding requests found</h5>
                                    <p>Try adjusting your search or filters, or click "New Request" to create one.</p>
                                </div>
        }
        else
        {
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th style="width: 40px;">
                                                    <input class="form-check-input" type="checkbox" id="selectAll" aria-label="Select all requests">
                                                </th>
                                                <th>#</th>
                                                <th data-sort="text">Employee</th>
                                                <th data-sort="text">Department</th>
                                                <th data-sort="text">Status</th>
                                                <th data-sort="date">Due Date Time</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                        @{
                            int idx = (Model.PageIndex - 1) * 10 + 1;
                        }
                        @foreach (var req in Model)
                        {
                            var badgeClass = req.Status switch
                            {
                                RequestStatus.Draft => "badge-draft",
                                RequestStatus.PendingITApproval => "badge-pending",
                                RequestStatus.PendingEmployeeSign => "badge-employeesign",
                                RequestStatus.Approved => "badge-completed",
                                RequestStatus.Completed => "badge-completed",
                                RequestStatus.Rejected => "badge-rejected",
                                _ => "badge-draft"
                            };
                                                                    <tr>
                                                                        <td>
                                                                            <input class="form-check-input row-checkbox" type="checkbox" value="@req.Id" aria-label="Select @req.FullName">
                                                                        </td>
                                                                        <td>@(idx++)</td>
                                                                        <td>
                                                                            <strong>@req.FullName</strong>
                                                                            <br /><small style="color: var(--text-muted);">@req.Designation</small>
                                                                        </td>
                                                                        <td>@req.Department</td>
                                                                        <td><span class="@badgeClass">@(req.Status == RequestStatus.PendingITApproval ? "Pending IT Approval" : req.Status == RequestStatus.PendingEmployeeSign ? "Pending Employee Sign" : req.Status == RequestStatus.Approved ? "Completed" : req.Status.ToString())</span></td>
                                                                        <td>
                                                                            @if (req.Status != RequestStatus.Completed && req.Status != RequestStatus.Rejected && req.Status != RequestStatus.Approved)
                                                                            {
                                                                                var deadline = req.SlaDeadline;
                                                                                var isOverdue = deadline.HasValue && DateTime.UtcNow > deadline.Value;
                                                                                <div class="@(isOverdue ? "text-danger fw-bold" : "")">
                                                                                    @CompanyTimeZoneHelper.FormatDateTime(deadline, req.CompanyTimeZoneId)
                                                                                </div>
                                                                                if (isOverdue)
                                                                                {
                                                                                    <span class="badge bg-danger mt-1" title="Overdue"><i class="bi bi-stopwatch me-1" aria-hidden="true"></i>Overdue</span>
                                                                                }
                                                                            }
                                                                            else
                                                                            {
                                                                                <small class="text-muted">Submitted: @req.RequestDate.ToString("dd/MM/yyyy")</small>
                                                                            }
                                                                        </td>
                                                                        <td>
                                                                            <div class="d-flex gap-1">
                                                                                <a asp-action="Details" asp-route-id="@req.Id" class="btn btn-sm btn-secondary" title="View" aria-label="View details for @req.FullName">
                                                                                    <i class="fas fa-eye" aria-hidden="true"></i>
                                                                                </a>
                                        @if (req.Status != RequestStatus.Draft)
                                        {
                                                                                    <a asp-action="GeneratePdf" asp-route-id="@req.Id"
                                                                                        class="btn btn-sm btn-outline-primary" title="Download PDF" aria-label="Download PDF for @req.FullName">
                                                                                        <i class="fas fa-file-pdf" aria-hidden="true"></i>
                                                                                    </a>
                                        }
                                        @if (req.Status == RequestStatus.Draft)
                                        {
                                                                                    <a asp-action="Edit" asp-route-id="@req.Id" class="btn btn-sm btn-outline-info" title="Edit" aria-label="Edit request for @req.FullName">
                                                                                        <i class="fas fa-edit" aria-hidden="true"></i>
                                                                                    </a>
                                        }
                                        @if (req.Status == RequestStatus.Draft || req.Status == RequestStatus.Rejected)
                                        {
                                                                                     <button type="button" class="btn btn-sm btn-outline-danger" title="Delete" aria-label="Delete request for @req.FullName"
                                                                                             data-csp-click="openDeleteModal" data-csp-arg0="@req.Id" data-csp-arg1="@(req.FullName ?? "Unknown")">
                                                                                             <i class="fas fa-trash-alt" aria-hidden="true"></i>
                                                                                         </button>
                                        }
                                                                            </div>
                                                                        </td>
                                                                    </tr>
                        }
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                                                    <div class="pagination-wrapper">
                                                        <span class="pagination-info">
                                                            Showing @((Model.PageIndex - 1) * 10 + 1)–@((Model.PageIndex - 1) * 10 + Model.Count) of @Model.TotalCount
                                                        </span>                                                        <nav aria-label="Pagination">
                                                            <ul class="pagination">
                                                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                                                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex - 1)"
                                                                       asp-route-searchString="@currentFilter" asp-route-status="@statusFilter" aria-label="Previous Page">
                                                                        <i class="bi bi-chevron-left" aria-hidden="true"></i>
                                                                    </a>
                                                                </li>
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                                                                    <li class="page-item @(i == Model.PageIndex ? "active" : "")" @(i == Model.PageIndex ? "aria-current=\"page\"" : "")>
                                                                                        <a class="page-link" asp-action="Index" asp-route-page="@i"
                                                                                           asp-route-searchString="@currentFilter" asp-route-status="@statusFilter">@i</a>
                                                                                    </li>
                            }
                                                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                                                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex + 1)"
                                                                       asp-route-searchString="@currentFilter" asp-route-status="@statusFilter" aria-label="Next Page">
                                                                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                                                    </a>
                                                                </li>
                                                            </ul>
                                                        </nav>
                                                    </div>
            }
        }
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg" style="border-radius:12px;">
            <div class="modal-header py-2 bg-danger bg-opacity-25 border-0" style="border-radius:12px 12px 0 0;">
                <h6 class="modal-title fw-bold text-danger" id="deleteModalLabel"><i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>Delete Request</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2 text-dark">Are you sure you want to delete this onboarding request?</p>
                <div class="bg-light rounded px-3 py-2">
                    <span class="fw-bold text-danger" id="deleteItemName"></span>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" action="" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger px-3 shadow-sm">
                        <i class="bi bi-trash me-1" aria-hidden="true"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const selectAll = document.getElementById('selectAll');
                const checkboxes = document.querySelectorAll('.row-checkbox');
                const btnBulkExport = document.getElementById('btnBulkExport');
                const selectedCount = document.getElementById('selectedCount');

                function updateBulkExportButton() {
                    const checked = document.querySelectorAll('.row-checkbox:checked').length;
                    if (checked > 0) {
                        selectedCount.textContent = checked;
                        btnBulkExport.style.display = 'inline-block';
                    } else {
                        btnBulkExport.style.display = 'none';
                        if (selectAll) selectAll.checked = false;
                    }
                }

                if (selectAll) {
                    selectAll.addEventListener('change', function () {
                        checkboxes.forEach(cb => cb.checked = this.checked);
                        updateBulkExportButton();
                    });
                }

                checkboxes.forEach(cb => {
                    cb.addEventListener('change', function () {
                        if (!this.checked && selectAll) selectAll.checked = false;
                        updateBulkExportButton();
                    });
                });

                if (btnBulkExport) {
                    // ... existing bulk export logic ...
                }

                // Delete Modal Logic
                const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
                window.openDeleteModal = function(id, name) {
                    document.getElementById('deleteItemName').textContent = name;
                    document.getElementById('deleteForm').action = '/Onboarding/Delete/' + id;
                    deleteModal.show();
                };
            });
        </script>
}




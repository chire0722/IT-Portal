@model IT_Form.Models.ViewModels.AuditLogIndexPageViewModel
@{
    ViewData["Title"] = "Audit Log";
    var entries = Model.Entries;
    string? entity = Model.Entity;
    string? action = Model.AuditAction;
    string? search = Model.Search;
    bool? isSuccess = Model.IsSuccess;
    string? startDate = Model.StartDate;
    string? endDate = Model.EndDate;

    var entities = new[]
    {
        ("ApplicationUser", "User Accounts"),
        ("UserTitle", "User Titles"),
        ("UserCompany", "User Companies"),
        ("OnboardingRequest", "Onboarding"),
        ("OffboardingRequest", "Offboarding"),
        ("SoftwareLicense", "Software License"),
        ("StandardSoftware", "Software Catalogue"),
        ("ITAsset", "IT Assets"),
        ("MaintenanceLog", "Maintenance"),
        ("Company", "Companies"),
        ("Department", "Departments"),
        ("EmailGroup", "Email Groups"),
        ("SharedMailbox", "Shared Mailboxes"),
        ("ServerFolder", "Server Folders"),
        ("EmailContact", "Contacts"),
        ("Command", "Command Pipeline")
    }.OrderBy(x => x.Item2).ToArray();

    var selectedEntityLabel = entities.FirstOrDefault(x => x.Item1 == entity).Item2 ?? "All entities";
    var selectedActionLabel = string.IsNullOrWhiteSpace(action) ? "All actions" : action;
    var selectedOutcomeLabel = isSuccess switch
    {
        true => "Success only",
        false => "Failures only",
        _ => "All outcomes"
    };
    var activeFilterCount = new[]
    {
        !string.IsNullOrWhiteSpace(entity),
        !string.IsNullOrWhiteSpace(action),
        isSuccess.HasValue,
        !string.IsNullOrWhiteSpace(startDate),
        !string.IsNullOrWhiteSpace(endDate),
        !string.IsNullOrWhiteSpace(search)
    }.Count(active => active);
    var maxFailedActionCount = Math.Max(Model.TopFailedActions.Any() ? Model.TopFailedActions.Max(x => x.Count) : 0, 1);
    var maxFailedActorCount = Math.Max(Model.TopFailedActors.Any() ? Model.TopFailedActors.Max(x => x.Count) : 0, 1);
    var maxTrendCount = Math.Max(Model.FailureTrend.Any() ? Model.FailureTrend.Max(x => x.Count) : 0, 1);
    var riskStatus = Model.FilteredFailureCount > 0 ? "Review needed" : "No failures";
    var riskStatusClass = Model.FilteredFailureCount > 0 ? "audit-state-danger" : "audit-state-success";
}

<style>
    .audit-shell {
        --audit-blue: #164f9f;
        --audit-blue-strong: #0f3f83;
        --audit-blue-soft: rgba(22, 79, 159, 0.08);
        --audit-red: #dc3545;
        --audit-red-soft: rgba(220, 53, 69, 0.09);
        --audit-green: #0f9f6e;
        --audit-green-soft: rgba(15, 159, 110, 0.1);
        --audit-ink: #1f2937;
        --audit-muted: #64748b;
        --audit-line: rgba(100, 116, 139, 0.18);
        --audit-panel: rgba(255, 255, 255, 0.92);
        display: grid;
        gap: 1.25rem;
    }

    .audit-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 1rem;
        align-items: start;
    }

    .audit-title-wrap {
        display: flex;
        gap: 0.9rem;
        align-items: flex-start;
        min-width: 0;
    }

    .audit-title-icon {
        width: 42px;
        height: 42px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
        color: var(--audit-blue);
        border: 1px solid rgba(22, 79, 159, 0.16);
        box-shadow: 0 10px 24px rgba(15, 63, 131, 0.08);
        flex: 0 0 auto;
    }

    .audit-title {
        margin: 0;
        color: var(--audit-ink);
        font-size: clamp(1.65rem, 2.8vw, 2.25rem);
        font-weight: 800;
        line-height: 1.05;
        letter-spacing: 0;
    }

    .audit-subtitle {
        margin: 0.45rem 0 0;
        color: var(--audit-muted);
        max-width: 62rem;
        font-size: 0.96rem;
    }

    .audit-hero-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.65rem;
    }

    .audit-btn {
        min-height: 40px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        font-weight: 700;
        padding: 0.6rem 0.95rem;
        text-decoration: none;
        border: 1px solid transparent;
        transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
        white-space: nowrap;
    }

    .audit-btn:hover {
        transform: translateY(-1px);
    }

    .audit-btn-primary {
        color: #fff;
        background: var(--audit-blue);
        box-shadow: 0 10px 18px rgba(22, 79, 159, 0.18);
    }

    .audit-btn-primary:hover {
        color: #fff;
        background: var(--audit-blue-strong);
    }

    .audit-btn-success {
        color: #fff;
        background: var(--audit-green);
        box-shadow: 0 10px 18px rgba(15, 159, 110, 0.16);
    }

    .audit-btn-success:hover {
        color: #fff;
        filter: brightness(0.96);
    }

    .audit-btn-ghost {
        color: var(--audit-blue);
        background: #fff;
        border-color: rgba(22, 79, 159, 0.2);
    }

    .audit-btn-ghost:hover {
        color: var(--audit-blue-strong);
        border-color: rgba(22, 79, 159, 0.38);
        box-shadow: 0 10px 18px rgba(15, 23, 42, 0.07);
    }

    .audit-filter-panel,
    .audit-metric,
    .audit-insight-panel,
    .audit-table-panel,
    .audit-empty-state {
        background: var(--audit-panel);
        border: 1px solid var(--audit-line);
        border-radius: 8px;
        box-shadow: 0 14px 36px rgba(15, 23, 42, 0.06);
    }

    .audit-filter-panel {
        padding: 1rem;
    }

    .audit-filter-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        padding-bottom: 0.9rem;
        border-bottom: 1px solid rgba(100, 116, 139, 0.14);
        margin-bottom: 1rem;
    }

    .audit-panel-title {
        margin: 0;
        color: var(--audit-ink);
        font-size: 1rem;
        font-weight: 800;
        letter-spacing: 0;
    }

    .audit-panel-subtitle {
        margin: 0.25rem 0 0;
        color: var(--audit-muted);
        font-size: 0.84rem;
    }

    .audit-active-filters {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.35rem;
    }

    .audit-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        min-height: 28px;
        border-radius: 999px;
        padding: 0.25rem 0.65rem;
        color: #334155;
        background: #f8fafc;
        border: 1px solid rgba(100, 116, 139, 0.16);
        font-size: 0.78rem;
        font-weight: 700;
        text-decoration: none;
    }

    .audit-chip-danger {
        color: #b42335;
        background: #fff1f3;
        border-color: rgba(220, 53, 69, 0.22);
    }

    .audit-chip-blue {
        color: var(--audit-blue);
        background: var(--audit-blue-soft);
        border-color: rgba(22, 79, 159, 0.18);
    }

    .audit-filter-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 0.85rem;
        align-items: end;
    }

    .audit-field {
        min-width: 0;
    }

    .audit-field label {
        margin-bottom: 0.35rem;
        color: #475569;
        font-size: 0.74rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .audit-field .form-control,
    .audit-field .form-select {
        min-height: 42px;
        border-radius: 8px;
        border-color: rgba(100, 116, 139, 0.24);
        font-size: 0.9rem;
        box-shadow: none;
    }

    .audit-field .form-control:focus,
    .audit-field .form-select:focus {
        border-color: rgba(22, 79, 159, 0.55);
        box-shadow: 0 0 0 0.2rem rgba(22, 79, 159, 0.12);
    }

    .audit-col-2 {
        grid-column: span 2;
    }

    .audit-col-3 {
        grid-column: span 3;
    }

    .audit-col-4 {
        grid-column: span 4;
    }

    .audit-col-actions {
        grid-column: span 2;
        display: flex;
        gap: 0.5rem;
    }

    .audit-filter-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 0.85rem;
    }

    .audit-kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
    }

    .audit-metric {
        padding: 1rem;
        min-height: 132px;
        position: relative;
        overflow: hidden;
    }

    .audit-metric::before {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: 4px;
        background: var(--metric-accent, var(--audit-blue));
    }

    .audit-metric-top {
        display: flex;
        justify-content: space-between;
        gap: 0.75rem;
        align-items: flex-start;
    }

    .audit-metric-label {
        color: var(--audit-muted);
        font-size: 0.76rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .audit-metric-icon {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--metric-accent, var(--audit-blue));
        background: color-mix(in srgb, var(--metric-accent, var(--audit-blue)) 10%, white);
        flex: 0 0 auto;
    }

    .audit-metric-value {
        margin-top: 0.55rem;
        color: var(--audit-ink);
        font-size: 2.1rem;
        line-height: 1;
        font-weight: 800;
        letter-spacing: 0;
    }

    .audit-metric-note {
        margin-top: 0.5rem;
        color: var(--audit-muted);
        font-size: 0.84rem;
    }

    .audit-state-danger {
        color: #b42335;
    }

    .audit-state-success {
        color: #087f5b;
    }

    .audit-insight-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(320px, 1.15fr);
        gap: 1rem;
    }

    .audit-insight-panel {
        min-height: 260px;
        padding: 1rem;
    }

    .audit-insight-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.9rem;
    }

    .audit-list {
        display: grid;
        gap: 0.75rem;
    }

    .audit-list-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0.75rem;
        align-items: center;
    }

    .audit-list-main {
        min-width: 0;
    }

    .audit-list-label {
        display: block;
        color: var(--audit-ink);
        font-weight: 700;
        font-size: 0.88rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .audit-bar-track {
        height: 6px;
        margin-top: 0.4rem;
        border-radius: 999px;
        background: rgba(100, 116, 139, 0.14);
        overflow: hidden;
    }

    .audit-bar {
        height: 100%;
        border-radius: inherit;
        background: var(--bar-color, var(--audit-blue));
    }

    .audit-count {
        min-width: 30px;
        height: 26px;
        border-radius: 999px;
        display: inline-flex;

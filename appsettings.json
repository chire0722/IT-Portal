{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=|DataDirectory|IT_FormDB.db"
  },
  "DatabaseBackup": {
    "BackupPath": "|DataDirectory|\\backups",
    "AdditionalBackupPath": ""
  },
   "DatabaseBackup2": {
    "AdditionalBackupPath": ""
  },
  "SmtpSettings": {
    "Host": "smtp.office365.com",
    "Port": 587,
    "Username": "no-reply@yengtong.com",
    "Password": "<SET_VIA_ENV_VAR: IT_FORM__SmtpSettings__Password>",
    "FromName": "IT Notification",
    "EnableSsl": true
  },
  "AppDomain": "",
  "LoginPageBranding": {
    "CompanyName": "YTC",
    "SystemName": "IT Portal",
    "Subtitle": "IT Asset & Access Management System",
    "BackgroundImagePath": "",
    "SystemVersion": ""
  },
  "InventorySync": {
    "ApiKey": "<SET_IN_USER_SECRETS_OR_ENV_VARS>"
  },
  "SignatureHmac": {
    "Key": "<SET_VIA_ENV_VAR: IT_FORM__SignatureHmac__Key>"
  },
  "SecuritySettings": {
    "MaxOtpAttempts": 5,
    "PasswordLockoutMinutes": [ 5, 15, 30, 120 ],
    "OtpExpiryMinutes": 3,
    "DeviceVerificationExpiryMinutes": 30,
    "AllowLegacyInventoryApiKey": false,
    "CookieSecurePolicy": "Always",
    "KnownProxies": [],
    "Argon2id": {
      "DegreeOfParallelism": 4,
      "MemorySize": 32768,
      "Iterations": 3,
      "SaltSize": 16,
      "HashSize": 32
    },
    "LegacyArgon2id": {
      "DegreeOfParallelism": 8,
      "MemorySize": 65536,
      "Iterations": 4,
      "SaltSize": 16,
      "HashSize": 32
    }
  }
}

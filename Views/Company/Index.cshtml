@* Project comment: Index.cshtml renders part of the IT Form web user interface. *@

@model IEnumerable<IT_Form.Application.Features.Company.CompanyIndexListItem>
@using IT_Form.Helpers
@{
    ViewData["Title"] = "Company Management";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="h4 mb-0 fw-bold"><i class="bi bi-building me-2 text-primary" aria-hidden="true"></i>Company Management</h2>
    <div class="d-flex gap-2 flex-wrap">
        <button type="button" class="btn btn-sm btn-warning shadow-sm rounded-pill d-inline-flex align-items-center justify-content-center gap-2 px-3 fw-bold text-dark" data-bs-toggle="modal" data-bs-target="#syncModal">
            <i class="bi bi-arrow-repeat me-1"></i> Sync All Company Names
        </button>
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm rounded-pill d-inline-flex align-items-center justify-content-center gap-2 px-3 fw-bold text-white">
            <i class="bi bi-plus-circle-fill me-1"></i> Add Company
        </a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 50px;">#</th>
                        <th style="width: 100px;">Logo</th>
                        <th>Name</th>
                        <th>Lot / Address</th>
                        <th>Time Zone</th>
                        <th>Business Hours</th>
                        <th>Business Days</th>
                        <th>Login Page</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 text-muted small">@item.Id</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.LogoPath))
                                {
                                    <div class="rounded border bg-light d-flex align-items-center justify-content-center overflow-hidden" style="width: 60px; height: 40px;">
                                        <img src="/@item.LogoPath" alt="@item.Name" class="img-fluid" style="max-height: 100%; object-fit: contain;" />
                                    </div>
                                }
                                else
                                {
                                    <div class="rounded border bg-light d-flex align-items-center justify-content-center text-muted" style="width: 60px; height: 40px; font-size: 0.6rem;">
                                        No Logo
                                    </div>
                                }
                            </td>
                            <td class="fw-semibold">@item.Name</td>
                            <td class="text-muted">@(item.Lot ?? "-")</td>
                            <td class="text-muted small">@CompanyTimeZoneHelper.GetDisplayName(item.TimeZoneId)</td>
                            <td class="text-muted">
                                @item.BusinessStartTime.ToString(@"hh\:mm") - @item.BusinessEndTime.ToString(@"hh\:mm")
                            </td>
                            <td class="text-muted small">
                                @IT_Form.Helpers.CompanyBusinessHoursHelper.FormatWorkingDays(
                                    item.WorksOnMonday,
                                    item.WorksOnTuesday,
                                    item.WorksOnWednesday,
                                    item.WorksOnThursday,
                                    item.WorksOnFriday,
                                    item.WorksOnSaturday,
                                    item.WorksOnSunday)
                            </td>
                            <td>
                                @if (item.IsLoginPageLogo)
                                {
                                    <span class="badge bg-primary">Selected</span>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-action-circle btn-outline-primary me-1" aria-label="Edit company @item.Name" title="Edit">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </a>
                                 <button type="button" class="btn btn-action-circle btn-outline-danger" aria-label="Delete company @item.Name" title="Delete" onclick="openDeleteModal(@item.Id, '@item.Name.Replace("'", "\\'")')">
                                     <i class="bi bi-trash" aria-hidden="true"></i>
                                 </button>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">No companies yet. Add one to get started.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Sync Confirmation Modal -->
<div class="modal fade" id="syncModal" tabindex="-1" aria-labelledby="syncModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:16px; overflow:hidden;">
            <div class="modal-header p-4 border-0 bg-warning bg-opacity-10">
                <div class="d-flex align-items-center">
                    <div class="bg-warning bg-opacity-25 rounded-circle p-3 me-3 text-dark">
                        <i class="bi bi-arrow-repeat fs-3"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0 text-dark" id="syncModalLabel">Sync Company Names</h5>
                        <p class="text-muted small mb-0">Bulk Data Address Update</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="mb-3 fw-bold text-dark" style="font-size: 1.1rem;">Update existing employee records?</p>
                <p class="text-muted mb-0">This will scan all active and completed requests to ensure their company names include the verified lot addresses from your database.</p>
                <div class="alert alert-info mt-4 mb-0 border-0 shadow-sm" style="border-radius:12px; background-color: #f0f7ff;">
                    <div class="d-flex">
                        <i class="bi bi-info-circle-fill me-3 fs-4 text-primary"></i>
                        <div>
                            <span class="fw-bold d-block text-primary">Standardization Impact</span>
                            <span class="small text-muted">This ensures that signature routing and logo display work correctly for all historical records.</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer p-4 border-0 bg-light">
                <button type="button" class="btn btn-link link-secondary text-decoration-none fw-bold me-auto" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="SyncCompanyNames" method="post" id="syncForm" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-warning shadow rounded-pill px-4 py-2 fw-bold text-dark">
                        <i class="bi bi-check-circle-fill me-2"></i> Start Sync Now
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg" style="border-radius:12px;">
            <div class="modal-header py-2 bg-danger bg-opacity-25 border-0" style="border-radius:12px 12px 0 0;">
                <h6 class="modal-title fw-bold text-danger" id="deleteModalLabel"><i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>Delete Company</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pb-0">
                <p class="mb-2">Are you sure you want to delete this company?</p>
                <div class="bg-light rounded px-3 py-2">
                    <span class="fw-bold text-danger" id="deleteItemName"></span>
                </div>
                <p class="small text-muted mt-2 mb-0"><i class="bi bi-info-circle me-1"></i> This action cannot be undone.</p>
            </div>
            <div class="modal-footer border-0 pt-3 px-3 pb-3">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" class="d-inline m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger px-3">
                        <i class="bi bi-trash me-1" aria-hidden="true"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

            window.openDeleteModal = function(id, name) {
                document.getElementById('deleteItemName').textContent = name;
                document.getElementById('deleteForm').action = '/Company/Delete/' + id;
                deleteModal.show();
            };

            // Optional: Add loading state to sync button when clicked
            const syncForm = document.getElementById('syncForm');
            if (syncForm) {
                syncForm.addEventListener('submit', function() {
                    const btn = this.querySelector('button[type="submit"]');
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Processing...';
                });
            }
        });
    </script>
}

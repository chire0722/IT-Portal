<!-- Clearance Acknowledgment -->
<div class="card animate-in mt-4" style="animation-delay: 0.25s;">
    <div class="card-body" style="background: var(--surface); border-radius: 12px;">
        <h6 style="color: var(--text-primary);"><i class="fas fa-file-signature me-2" aria-hidden="true"></i>Clearance Acknowledgment</h6>
        <p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 0;">
            By signing this form, I hereby acknowledge that I have completed the Employee Clearance Form and understand
            the responsibilities associated with the clearance process at <strong>YTC Precast</strong>. I confirm that I have
            returned all company property, settled any outstanding obligations, and had no further claims against the company.
        </p>
    </div>
</div>

<div class="card animate-in mt-4 mb-5" style="animation-delay: 0.3s;">
    <div class="card-header">
        <i class="bi bi-pen me-2" style="color: var(--primary-light);" aria-hidden="true"></i>Sign Off & Approvals
    </div>
    <div class="card-body">
        <div class="row g-4 text-center">

            <!-- HR Signature -->
            <div class="col-md-4 border-end">
                <small class="text-uppercase fw-bold text-muted d-block mb-3">Requestor Signature</small>
                <p class="small text-muted mb-3" style="font-size: 0.75rem;">I verify that the information provided is accurate and initiation of offboarding is authorized.</p>
                @if (hasHRSig)
                {
                    <img src="@Model.HRSignature" alt="Requestor Signature" class="img-fluid border rounded bg-white p-2" style="max-height: 80px;" />
                    <p class="small text-success mt-2 mb-0">Signed by @(Model.HRSignerName ?? "HR")</p>
                    <p class="text-muted" style="font-size: 0.7rem;">@Model.HRSignedAt?.ToString("g")</p>
                }
                else
                {
                    @if (isHRUser)
                    {
                        <div class="p-3 bg-light border rounded text-muted small mb-2" style="border-style: dashed !important;">Awaiting Signature</div>
                        <form asp-action="SignOffHR" method="post" class="d-grid gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            @if (!string.IsNullOrEmpty(Model.CurrentUserSignature))
                            {
                                <input type="hidden" name="signatureBase64" value="@Model.CurrentUserSignature" />
                                <button type="submit" class="btn btn-sm btn-primary">Sign & Continue</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-secondary" disabled>Signature Not Found</button>
                                <small class="text-muted">Set your signature in profile first.</small>
                            }
                        </form>
                    }
                    else
                    {
                        <div class="p-3 bg-light border rounded text-muted small" style="border-style: dashed !important;">Awaiting Signature</div>
                    }
                }
            </div>

            <!-- Manager Signature -->
            <div class="col-md-4 border-end">
                <small class="text-uppercase fw-bold text-muted d-block mb-3">Head of Department Signature</small>
                <p class="small text-muted mb-3" style="font-size: 0.75rem;">I confirm the separation instructions and verify return of physical assets.</p>
                @if (hasManagerSig)
                {
                    @if (Model.HODSignature!.StartsWith("data:image"))
                    {
                        <img src="@Model.HODSignature" alt="Manager Signature" class="img-fluid border rounded bg-white p-2" style="max-height: 80px;" />
                    }
                    else
                    {
                        <div class="border rounded bg-white p-3 text-primary fw-semibold">@Model.HODSignature</div>
                    }
                    <p class="small text-success mt-2 mb-0">Signed by @(Model.HODSignerName ?? "HOD")</p>
                    <p class="text-muted" style="font-size: 0.7rem;">@Model.HODSignedAt?.ToString("g")</p>
                }
                else
                {
                    @if (hasHRSig && isAssignedManager)
                    {
                        <div class="p-3 bg-light border rounded text-muted small mb-2" style="border-style: dashed !important;">Awaiting Signature</div>
                        <form asp-action="SignOffManager" method="post" class="d-grid gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            @if (!string.IsNullOrEmpty(Model.CurrentUserSignature))
                            {
                                <input type="hidden" name="signatureBase64" value="@Model.CurrentUserSignature" />
                                <button type="submit" class="btn btn-sm btn-primary">Sign & Notify IT</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-secondary" disabled>Signature Not Found</button>
                                <small class="text-muted">Set your signature in profile first.</small>
                            }
                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">Reject Request</button>
                        </form>
                    }
                    else if (isAssignedManager)
                    {
                        <div class="p-3 bg-light border rounded text-muted small" style="border-style: dashed !important;">Please wait for the Requestor to verify before signing.</div>
                    }
                    else
                    {
                        <div class="p-3 bg-light border rounded text-muted small" style="border-style: dashed !important;">Awaiting HOD Signature</div>
                    }
                }
            </div>

            <!-- IT Signature -->
            <div class="col-md-4">
                <small class="text-uppercase fw-bold text-muted d-block mb-3">IT Admin Signature</small>

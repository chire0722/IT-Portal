@model IT_Form.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - YTC IT Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <div class="auth-container">
        <div class="auth-card animate-in">
            <div class="auth-header">
                <div style="margin-bottom: 0.75rem;">
                    <img src="~/images/logo-combined.png" alt="PYT & YTC" style="max-width: 280px; height: auto;" />
                </div>
                <h1>Forgot Password?</h1>
                <p>Enter your username or email to receive an OTP</p>
            </div>
            <div class="auth-body">
                <form asp-action="ForgotPassword" method="post">
                    <div asp-validation-summary="All" class="alert alert-danger"
                        style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

                    <div class="mb-4">
                        <label asp-for="Username" class="form-label">
                            <i class="fas fa-id-badge me-1" aria-hidden="true"></i> @Html.DisplayNameFor(m => m.Username)
                        </label>
                        <input asp-for="Username" class="form-control" placeholder="Enter your username or email" autofocus />
                        <span asp-validation-for="Username" class="text-danger" aria-live="polite" aria-atomic="true"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">
                        <i class="fas fa-paper-plane me-2" aria-hidden="true"></i>Send Reset Code
                    </button>
                    
                    <div class="text-center">
                        <a asp-action="Login" class="text-decoration-none small" style="color: var(--text-muted);">
                            <i class="fas fa-arrow-left me-1" aria-hidden="true"></i> Back to Login
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>

</html>



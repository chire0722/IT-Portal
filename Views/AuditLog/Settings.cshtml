@model IT_Form.Models.SystemSetting

@{
    ViewData["Title"] = "Audit Notification Settings";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800">
            <i class="bi bi-gear-fill text-primary me-2" aria-hidden="true"></i> Audit Notification Settings
        </h2>
        <p class="text-muted small mb-0">Configure where to send real-time alerts for Create and Update events.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Back to Logs
    </a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form asp-action="Settings" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Key" />

                    <div class="mb-3">
                        <label asp-for="Value" class="form-label fw-bold">Notification Email Address(es)</label>
                        <input asp-for="Value" type="text" class="form-control" placeholder="itdept@ytcprecast.com; hr@ytcprecast.com" required />
                        <span asp-validation-for="Value" class="text-danger small"></span>
                        <div class="form-text mt-2">
                            Enter the email address(es) that will receive an automated alert. For multiple recipients, separate them with a <strong>comma (,)</strong> or <strong>semicolon (;)</strong>.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold">Description (Optional)</label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1" aria-hidden="true"></i> Save Settings
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card bg-light border-0 shadow-sm h-100">
            <div class="card-body">
                <h5 class="fw-bold mb-3"><i class="bi bi-info-circle me-2 text-info"></i> How it works</h5>
                <ul class="text-muted small">
                    <li class="mb-2">Notifications are sent for <strong>Created</strong> and <strong>Updated</strong> actions across all audited entities.</li>
                    <li class="mb-2">Each email contains the performer's name, timestamp, entity ID, and a summary of the changes.</li>
                    <li class="mb-2">SMTP settings from <code>appsettings.json</code> are used to deliver these messages.</li>
                    <li>To disable notifications, leave the email field blank (not recommended for security monitoring).</li>
                </ul>
                
                <div class="alert alert-warning border-0 small mt-4">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>Note:</strong> High-volume updates (like bulk imports) may generate multiple emails in a short period.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@* Project comment: ConfirmProfilePasswordChange.cshtml confirms profile password changes with OTP. *@

@model IT_Form.Application.Features.Account.Writes.ProfilePasswordChange.ConfirmProfilePasswordChangeInputModel
@{
    ViewData["Title"] = "Confirm Password Change";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card animate-in shadow-sm" style="border-radius: 16px;">
                <div class="card-header bg-transparent border-bottom-0 pb-0 pt-4 px-4">
                    <h3 class="fw-bold mb-0 text-primary">Confirm Password Change</h3>
                    <p class="text-muted small mt-1">Enter the verification code sent to your email.</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="ConfirmProfilePasswordChange" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="RequestId" />

                        <div class="mb-3">
                            <label asp-for="Code" class="form-label small fw-bold text-muted">Verification Code</label>
                            <input asp-for="Code" class="form-control text-center fw-bold" maxlength="6" inputmode="numeric" autocomplete="one-time-code" autofocus />
                            <span asp-validation-for="Code" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary rounded-pill px-4">
                                <i class="bi bi-check2-circle me-1" aria-hidden="true"></i>Confirm Change
                            </button>
                            <a class="btn btn-outline-secondary rounded-pill px-4" asp-action="Profile">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

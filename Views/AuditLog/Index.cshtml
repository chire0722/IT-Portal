@model IT_Form.Models.ViewModels.AuditLogIndexPageViewModel
@{
    ViewData["Title"] = "Audit Log";
    var entries = Model.Entries;
    string? entity = Model.Entity;
    string? action = Model.AuditAction;
    string? search = Model.Search;
    bool? isSuccess = Model.IsSuccess;
    string? startDate = Model.StartDate;
    string? endDate = Model.EndDate;
    var maxFailedActionCount = Math.Max(Model.TopFailedActions.Any() ? Model.TopFailedActions.Max(x => x.Count) : 0, 1);
    var maxFailedActorCount = Math.Max(Model.TopFailedActors.Any() ? Model.TopFailedActors.Max(x => x.Count) : 0, 1);
    var maxTrendCount = Math.Max(Model.FailureTrend.Any() ? Model.FailureTrend.Max(x => x.Count) : 0, 1);
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div class="page-header-left">
        <h2><i class="bi bi-clock-history me-2" aria-hidden="true"></i>Audit Log</h2>
        <span class="subtitle">Track both entity-level changes and command-level business actions across HR, IT, and API workflows.</span>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Settings" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-bold shadow-sm d-inline-flex align-items-center justify-content-center gap-2">
            <i class="bi bi-gear-fill me-1" aria-hidden="true"></i>Notification Settings
        </a>
        <a asp-action="ExportCsv" asp-route-search="@search" asp-route-entity="@entity" asp-route-auditAction="@action" asp-route-isSuccess="@isSuccess"
           asp-route-startDate="@startDate" asp-route-endDate="@endDate"
           class="btn btn-success fw-bold shadow-sm rounded-pill px-4 py-2 d-inline-flex align-items-center justify-content-center gap-2">
            <i class="bi bi-download me-1" aria-hidden="true"></i>Export CSV
        </a>
        <span class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm d-inline-flex align-items-center justify-content-center gap-2" style="cursor: default;">
            <i class="bi bi-collection me-1" aria-hidden="true"></i> @entries.TotalCount Total Entries
        </span>
    </div>
</div>

<form method="get" class="card shadow-sm mb-4 p-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-2">
            <label class="form-label small fw-bold">Entity Type</label>
            <select name="entity" class="form-select form-select-sm">
                <option value="">All Entities</option>
                @{
                    var entities = new[]
                    {
                        ("ApplicationUser", "User Accounts"),
                        ("UserTitle", "User Titles"),
                        ("UserCompany", "User Companies"),
                        ("OnboardingRequest", "Onboarding"),
                        ("OffboardingRequest", "Offboarding"),
                        ("SoftwareLicense", "Software License"),
                        ("StandardSoftware", "Software Catalogue"),
                        ("ITAsset", "IT Assets"),
                        ("MaintenanceLog", "Maintenance"),
                        ("Company", "Companies"),
                        ("Department", "Departments"),
                        ("EmailGroup", "Email Groups"),
                        ("SharedMailbox", "Shared Mailboxes"),
                        ("ServerFolder", "Server Folders"),
                        ("EmailContact", "Contacts"),
                        ("Command", "Command Pipeline")
                    }.OrderBy(x => x.Item2);
                }
                @foreach (var (val, label) in entities)
                {
                    <option value="@val" selected="@(entity == val)">@label</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-bold">Action</label>
            <select name="auditAction" class="form-select form-select-sm">
                <option value="">All Actions</option>
                <option value="Created" selected="@(action == "Created")">Created</option>
                <option value="Updated" selected="@(action == "Updated")">Updated</option>
                <option value="Deleted" selected="@(action == "Deleted")">Deleted</option>
                <option value="Rejected" selected="@(action == "Rejected")">Rejected</option>
                <option value="Login" selected="@(action == "Login")">Login</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-bold">Outcome</label>
            <select name="isSuccess" class="form-select form-select-sm">
                <option value="">All Outcomes</option>
                <option value="true" selected="@(isSuccess == true)">Success</option>
                <option value="false" selected="@(isSuccess == false)">Failed</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-bold">Start Date</label>
            <input type="date" name="startDate" class="form-control form-control-sm" value="@startDate" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-bold">End Date</label>
            <input type="date" name="endDate" class="form-control form-control-sm" value="@endDate" />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-bold">Search</label>
            <input type="text" name="search" class="form-control form-control-sm" value="@search"
                   placeholder="User, ID, error, details" />
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-search me-1" aria-hidden="true"></i>Filter</button>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 mt-3">
        <a asp-action="Index" asp-route-entity="Command" asp-route-isSuccess="false" class="btn btn-sm btn-outline-danger rounded-pill">Failed Commands</a>
        <a asp-action="Index" asp-route-entity="Command" class="btn btn-sm btn-outline-dark rounded-pill">All Command Audits</a>
        <a asp-action="Index" asp-route-isSuccess="false" class="btn btn-sm btn-outline-secondary rounded-pill">All Failures</a>
        <a asp-action="Index" class="btn btn-sm btn-light border rounded-pill">Reset</a>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold mb-2">Filtered Entries</div>
                <div class="display-6 fw-bolder mb-1">@entries.TotalCount</div>
                <div class="small text-muted">Current result set after filters.</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold mb-2">Failures</div>
                <div class="display-6 fw-bolder mb-1 text-danger">@Model.FilteredFailureCount</div>
                <div class="small text-muted">@Model.FilteredSuccessCount success entries remain in scope.</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold mb-2">Command Audits</div>
                <div class="display-6 fw-bolder mb-1">@Model.FilteredCommandCount</div>
                <div class="small text-muted">@Model.FailedCommandCount failed command executions.</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold mb-2">Failure Rate</div>
                <div class="display-6 fw-bolder mb-1">@(Model.FailureRate.ToString("0.0"))%</div>
                <div class="small text-muted">Failure share across the filtered result set.</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">Top Failed Actions</h5>
                    <a asp-action="Index" asp-route-isSuccess="false" class="btn btn-sm btn-outline-danger rounded-pill">Focus Failures</a>
                </div>
                @if (Model.TopFailedActions.Any())
                {
                    @foreach (var item in Model.TopFailedActions)
                    {
                        var width = Math.Max(10, (int)Math.Round(item.Count * 100.0 / maxFailedActionCount));
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="fw-semibold">@item.Action</span>
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">@item.Count</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar bg-danger" style="width:@width%"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted small">No failed actions in the current filter scope.</div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">Top Failed Users</h5>
                    <a asp-action="Index" asp-route-isSuccess="false" class="btn btn-sm btn-outline-secondary rounded-pill">View Failures</a>
                </div>
                @if (Model.TopFailedActors.Any())
                {
                    @foreach (var item in Model.TopFailedActors)
                    {
                        var width = Math.Max(10, (int)Math.Round(item.Count * 100.0 / maxFailedActorCount));
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="fw-semibold text-truncate me-2" title="@item.Actor">@item.Actor</span>
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">@item.Count</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar bg-secondary" style="width:@width%"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted small">No failed users in the current filter scope.</div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">Failure Trend</h5>
                    <span class="text-muted small">Most recent 14 days in scope</span>
                </div>
                @if (Model.FailureTrend.Any())
                {
                    <div class="d-flex align-items-end justify-content-between gap-2" style="height: 180px;">
                        @foreach (var point in Model.FailureTrend)
                        {
                            var heightPx = Math.Max(14, (int)Math.Round(point.Count * 120.0 / maxTrendCount));
                            <div class="flex-fill text-center">
                                <div class="small fw-bold mb-2">@point.Count</div>
                                <div class="mx-auto rounded-top bg-danger" style="width: 100%; max-width: 28px; height:@(heightPx)px;"></div>
                                <div class="text-muted mt-2" style="font-size: 0.72rem;">@point.Label</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted small">No failed entries available to plot for the current filter scope.</div>
                }
            </div>
        </div>
    </div>
</div>

@if (!entries.Any())
{
    <div class="alert alert-info text-center py-5">
        <i class="bi bi-journal-x display-4 d-block mb-3 text-secondary" aria-hidden="true"></i>
        <h5>No audit log entries found.</h5>
        <p class="text-muted mb-0">Try adjusting the filters above.</p>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light border-bottom">
                        <tr>
                            <th style="width: 150px;">Time (Local)</th>
                            <th style="width: 90px;">Outcome</th>
                            <th style="width: 110px;">Action</th>
                            <th style="width: 180px;">Entity</th>
                            <th>Details</th>
                            <th style="width: 170px;">Performed By</th>
                            <th style="width: 80px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            Guid? lastCorrelationId = null;
                            bool isEvenGroup = false;
                        }
                        @foreach (var log in entries)
                        {
                            var auditTime = log.CreatedAt == default ? log.Timestamp : log.CreatedAt;
                            var badgeClass = log.Action switch
                            {
                                "Created" => "bg-success-subtle text-success border border-success-subtle",
                                "Deleted" => "bg-danger-subtle text-danger border border-danger-subtle",
                                "Rejected" => "bg-danger-subtle text-danger border border-danger-subtle",
                                _ => "bg-warning-subtle text-warning-emphasis border border-warning-subtle"
                            };

                            var outcomeClass = log.IsSuccess
                                ? "bg-success-subtle text-success border border-success-subtle"
                                : "bg-danger-subtle text-danger border border-danger-subtle";

                            if (log.CorrelationId != lastCorrelationId)
                            {
                                isEvenGroup = !isEvenGroup;
                                lastCorrelationId = log.CorrelationId;
                            }

                            <tr class="@(isEvenGroup ? "group-even" : "group-odd") @(log.CorrelationId != null ? "has-correlation" : "")">
                                <td class="small text-muted">
                                    <div class="fw-bold">@auditTime.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    <div>@auditTime.ToLocalTime().ToString("HH:mm:ss")</div>
                                </td>
                                <td>
                                    <span class="badge py-1 px-2 @outcomeClass" style="min-width: 70px;">@(log.IsSuccess ? "Success" : "Failed")</span>
                                </td>
                                <td>
                                    <span class="badge py-1 px-2 @badgeClass" style="min-width: 70px;">@log.Action</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        @switch (log.EntityName)
                                        {
                                            case "ApplicationUser":
                                                <i class="bi bi-person-gear text-secondary me-2"></i><span>User Account</span>
                                                break;
                                            case "UserTitle":
                                                <i class="bi bi-person-badge text-secondary me-2"></i><span>User Title</span>
                                                break;
                                            case "UserCompany":
                                                <i class="bi bi-building-gear text-secondary me-2"></i><span>User Company</span>
                                                break;
                                            case "OnboardingRequest":
                                                <i class="bi bi-person-plus text-success me-2"></i><span>Onboarding</span>
                                                break;
                                            case "OffboardingRequest":
                                                <i class="bi bi-person-dash text-danger me-2"></i><span>Offboarding</span>
                                                break;
                                            case "SoftwareLicense":
                                                <i class="bi bi-key text-info me-2"></i><span>License</span>
                                                break;
                                            case "ITAsset":
                                                <i class="bi bi-pc-display text-primary me-2"></i><span>IT Asset</span>
                                                break;
                                            case "MaintenanceLog":
                                                <i class="bi bi-wrench text-warning me-2"></i><span>Maintenance</span>
                                                break;
                                            case "EmailContact":
                                                <i class="bi bi-person-rolodex text-primary me-2"></i><span>Contact</span>
                                                break;
                                            case "Command":
                                                <i class="bi bi-diagram-3 text-dark me-2"></i><span>Command Pipeline</span>
                                                break;
                                            default:
                                                <i class="bi bi-file-earmark-text text-secondary me-2"></i><span>@log.EntityName</span>
                                                break;
                                        }
                                    </div>
                                    <div class="text-muted extra-small">ID: #@log.EntityId</div>
                                </td>
                                <td class="small">
                                    <div class="text-wrap" style="max-width: 420px; word-break: break-word;">
                                        @(string.IsNullOrWhiteSpace(log.Details) ? log.ErrorMessage : log.Details)
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(log.ErrorMessage))
                                    {
                                        <div class="text-danger extra-small mt-1">@log.ErrorMessage</div>
                                    }
                                </td>
                                <td class="small">
                                    <div class="fw-bold">@log.PerformedBy</div>
                                    @if (!string.IsNullOrWhiteSpace(log.UserId) && !string.Equals(log.UserId, log.PerformedBy, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <div class="text-muted extra-small">@log.UserId</div>
                                    }
                                    @if (!string.IsNullOrEmpty(log.IpAddress))
                                    {
                                        <div class="text-muted extra-small">@log.IpAddress</div>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@log.Id" class="btn btn-action-circle btn-outline-secondary" title="View Details">
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (entries.TotalPages > 1)
    {
        <div class="card-footer bg-transparent border-0 pt-0 pb-3">
            <div class="pagination-wrapper">
                <span class="pagination-info">
                    Showing @((entries.PageIndex - 1) * 25 + 1)-@((entries.PageIndex - 1) * 25 + entries.Count) of @entries.TotalCount
                </span>
                <nav aria-label="Pagination">
                    <ul class="pagination mb-0">
                        <li class="page-item @(!entries.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(entries.PageIndex - 1)"
                               asp-route-entity="@entity" asp-route-auditAction="@action" asp-route-search="@search"
                               asp-route-isSuccess="@isSuccess" asp-route-startDate="@startDate" asp-route-endDate="@endDate" aria-label="Previous Page">
                                <i class="bi bi-chevron-left" aria-hidden="true"></i>
                            </a>
                        </li>
                        @for (int i = 1; i <= entries.TotalPages; i++)
                        {
                            <li class="page-item @(i == entries.PageIndex ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-entity="@entity"
                                   asp-route-auditAction="@action" asp-route-search="@search"
                                   asp-route-isSuccess="@isSuccess" asp-route-startDate="@startDate" asp-route-endDate="@endDate">@i</a>
                            </li>
                        }
                        <li class="page-item @(!entries.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(entries.PageIndex + 1)"
                               asp-route-entity="@entity" asp-route-auditAction="@action" asp-route-search="@search"
                               asp-route-isSuccess="@isSuccess" asp-route-startDate="@startDate" asp-route-endDate="@endDate" aria-label="Next Page">
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    }
}

                <tr><td>4</td><td>Outlook & Email &mdash; Sign-out & forwarded</td><td class="text-center">@(Model.CheckEmailSignOut ? "Yes" : "No")</td></tr>
                <tr><td>5</td><td>Specific Software / Application &mdash; Deactivate</td><td class="text-center">@(Model.CheckSpecificSoftwareDeactivate ? "Yes" : "No")</td></tr>
                <tr><td>6</td><td>General Software / Application &mdash; Deactivate</td><td class="text-center">@(Model.CheckGeneralSoftwareDeactivate ? "Yes" : "No")</td></tr>
                <tr><td>7</td><td>Remove user from ADs Group</td><td class="text-center">@(Model.CheckAbcGroupRemove ? "Yes" : "No")</td></tr>
                <tr><td>8</td><td>Remove user from Email Mail Group</td><td class="text-center">@(Model.CheckEmailMailGroupRemove ? "Yes" : "No")</td></tr>

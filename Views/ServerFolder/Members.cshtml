@* Project comment: Members.cshtml renders part of the IT Form web user interface. *@

@model IT_Form.Application.Features.ServerFolder.ServerFolderMembersPageViewModel
@{
    ViewData["Title"] = $"Members - {Model.FolderName}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">Server Folders</a></li>
                <li class="breadcrumb-item active">Members</li>
            </ol>
        </nav>
        <h2 class="h4 mb-0 fw-bold">
            <i class="bi bi-people me-2 text-primary"></i>Members: @Model.FolderName
        </h2>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success py-2">@TempData["SuccessMessage"]</div>
}
@if (TempData["InfoMessage"] != null)
{
    <div class="alert alert-info py-2">@TempData["InfoMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger py-2">@TempData["ErrorMessage"]</div>
}

<div class="card shadow-sm border-0 mb-3">
    <div class="card-body">
        <h6 class="fw-bold mb-2">Add Current Employee to This Folder</h6>
        <form asp-action="AddCurrentEmployee" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.FolderId" />
            <div class="col-lg-6">
                <label class="form-label mb-1">Employee</label>
                <select name="onboardingRequestId" class="form-select" required>
                    <option value="">Select employee...</option>
                    @foreach (var employee in Model.CurrentEmployees)
                    {
                        if (Model.CurrentEmployeeId == employee.Id)
                        {
                            <option value="@employee.Id" selected="selected">@employee.Label</option>
                        }
                        else
                        {
                            <option value="@employee.Id">@employee.Label</option>
                        }
                    }
                </select>
                @if (!string.IsNullOrWhiteSpace(Model.CurrentEmployeeDisplayName))
                {
                    <div class="small text-muted mt-1">
                        Current context: @Model.CurrentEmployeeDisplayName
                    </div>
                }
            </div>
            <div class="col-lg-4">
                <label class="form-label mb-1 d-block">Permission</label>
                <div class="d-flex gap-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="canRead" value="true" checked id="canRead">
                        <label class="form-check-label" for="canRead">Read</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="canModify" value="true" id="canModify">
                        <label class="form-check-label" for="canModify">Modify</label>
                    </div>
                </div>
            </div>
            <div class="col-lg-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-person-plus me-1"></i>Add
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Employee Name</th>
                        <th>Department</th>
                        <th>Access Level</th>
                        <th>Request Type</th>
                        <th>Request Date</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Members)
                    {
                        var access = item.CanModify ? "Read & Modify" : "Read Only";

                        <tr>
                            <td class="ps-3 fw-semibold">@item.EmployeeName</td>
                            <td>@item.Department</td>
                            <td>
                                <span class="badge @(item.CanModify ? "bg-danger" : "bg-success")">@access</span>
                            </td>
                            <td>
                                <span class="badge bg-info bg-opacity-10 text-info">@item.RequestType</span>
                            </td>
                            <td class="text-muted small">@(item.RequestDate?.ToString("dd/MM/yyyy HH:mm"))</td>
                            <td>
                                @{
                                    var badgeClass = item.Status switch
                                    {
                                        IT_Form.Models.Enums.RequestStatus.Completed => "bg-success",
                                        IT_Form.Models.Enums.RequestStatus.Approved => "bg-primary",
                                        IT_Form.Models.Enums.RequestStatus.Rejected => "bg-danger",
                                        _ => "bg-warning text-dark"
                                    };
                                }
                                <span class="badge @badgeClass">@item.Status</span>
                            </td>
                            <td class="text-end pe-3">
                                <a href="/@item.ControllerName/Details/@item.RequestId" class="btn btn-sm btn-light border" title="View Request">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Members.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="bi bi-people display-6 d-block mb-2 opacity-25"></i>
                                No employees found for this folder yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

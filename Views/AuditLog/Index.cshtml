    }

    .audit-trend-value {
        color: var(--audit-ink);
        font-size: 0.8rem;
        font-weight: 800;
    }

    .audit-trend-bar-wrap {
        width: 100%;
        max-width: 30px;
        height: 124px;
        display: flex;
        align-items: flex-end;
        border-radius: 999px;
        background: rgba(220, 53, 69, 0.08);
        overflow: hidden;
    }

    .audit-trend-bar {
        width: 100%;
        min-height: 14px;
        border-radius: 999px 999px 0 0;
        background: var(--audit-red);
    }

    .audit-trend-label {
        color: var(--audit-muted);
        font-size: 0.7rem;
        white-space: nowrap;
    }

    .audit-muted-empty {
        color: var(--audit-muted);
        font-size: 0.9rem;
        padding: 1.25rem 0;
    }

    .audit-table-panel {
        overflow: hidden;
    }

    .audit-table-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 1rem 0.85rem;
        border-bottom: 1px solid rgba(100, 116, 139, 0.14);
    }

    .audit-table-count {
        color: var(--audit-muted);
        font-size: 0.84rem;
        font-weight: 700;
    }

    .audit-table {
        margin: 0;
    }

    .audit-table thead th {
        background: #f8fafc;
        color: #475569;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        border-bottom: 1px solid rgba(100, 116, 139, 0.16);
        padding-top: 0.8rem;
        padding-bottom: 0.8rem;
        white-space: nowrap;
    }

    .audit-table tbody td {
        padding-top: 0.95rem;
        padding-bottom: 0.95rem;
    }

    .audit-time {
        color: var(--audit-ink);
        font-weight: 800;
        white-space: nowrap;
    }

    .audit-time-sub,
    .audit-entity-id,
    .audit-user-sub {
        color: var(--audit-muted);
        font-size: 0.74rem;
    }

    .audit-badge {
        min-width: 78px;
        border-radius: 999px;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        padding: 0.32rem 0.58rem;
        font-size: 0.74rem;
        font-weight: 800;
        border: 1px solid transparent;
    }

    .audit-badge-success {
        color: #087f5b;
        background: var(--audit-green-soft);
        border-color: rgba(15, 159, 110, 0.18);
    }

    .audit-badge-danger {
        color: #b42335;
        background: var(--audit-red-soft);
        border-color: rgba(220, 53, 69, 0.2);
    }

    .audit-badge-warning {
        color: #8a5a00;
        background: #fff7d6;
        border-color: rgba(252, 209, 22, 0.38);
    }

    .audit-badge-neutral {
        color: #334155;
        background: #f1f5f9;
        border-color: rgba(100, 116, 139, 0.2);
    }

    .audit-entity-cell {
        display: flex;
        gap: 0.65rem;
        align-items: flex-start;
        min-width: 0;
    }

    .audit-entity-icon {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--audit-blue-soft);
        color: var(--audit-blue);
        flex: 0 0 auto;
    }

    .audit-details-text {
        max-width: 520px;
        color: #334155;
        font-size: 0.86rem;
        line-height: 1.45;
        word-break: break-word;
    }

    .audit-error-text {
        margin-top: 0.35rem;
        color: #b42335;
        font-size: 0.76rem;
        font-weight: 700;
    }

    .audit-row-failed {

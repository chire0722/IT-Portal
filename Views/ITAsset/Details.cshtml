@* Project comment: Details.cshtml renders part of the IT Form web user interface. *@

@model IT_Form.Models.ITAsset
@using System.Text.Json

@{
    ViewData["Title"] = "Asset Details";
    if (Model == null) return;

    static bool TryParseJson(string? rawJson, out JsonElement root)
    {
        root = default;

        if (string.IsNullOrWhiteSpace(rawJson))
        {
            return false;
        }

        try
        {
            using var document = JsonDocument.Parse(rawJson);
            root = document.RootElement.Clone();
            return true;
        }
        catch
        {
            return false;
        }
    }

    static string JsonTextOrDash(JsonElement element, string propertyName)
    {
        if (!element.ValueKind.Equals(JsonValueKind.Object) || !element.TryGetProperty(propertyName, out var prop))
        {
            return "-";
        }

        return prop.ValueKind switch
        {
            JsonValueKind.String => string.IsNullOrWhiteSpace(prop.GetString()) ? "-" : prop.GetString()!,
            JsonValueKind.Number => prop.ToString(),
            JsonValueKind.True => "True",
            JsonValueKind.False => "False",
            _ => "-"
        };
    }

    static string JsonArrayFirstOrDash(JsonElement element, string propertyName)
    {
        if (!element.ValueKind.Equals(JsonValueKind.Object) || !element.TryGetProperty(propertyName, out var prop))
        {
            return "-";
        }

        if (prop.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in prop.EnumerateArray())
            {
                var text = item.ValueKind == JsonValueKind.String ? item.GetString() : item.ToString();
                if (!string.IsNullOrWhiteSpace(text))
                {
                    return text!;
                }
            }
        }

        return "-";
    }

    static string BuildRamSummary(JsonElement root)
    {
        if (!root.ValueKind.Equals(JsonValueKind.Object) || !root.TryGetProperty("RAM", out var ram) || ram.ValueKind != JsonValueKind.Array)
        {
            return "-";
        }

        var modules = ram.EnumerateArray().ToList();
        var firstModule = modules.FirstOrDefault();
        if (modules.Count == 0)
        {
            return "-";
        }

        return $"{modules.Count} module(s), first: {JsonTextOrDash(firstModule, "CapacityGB")} GB @ {JsonTextOrDash(firstModule, "SpeedMHz")} MHz";
    }

    static string BuildStorageSummary(JsonElement root)
    {
        if (!root.ValueKind.Equals(JsonValueKind.Object) || !root.TryGetProperty("Storage", out var storage) || storage.ValueKind != JsonValueKind.Array)
        {
            return "-";
        }

        var firstDisk = storage.EnumerateArray().FirstOrDefault();
        if (firstDisk.ValueKind != JsonValueKind.Object)
        {
            return "-";
        }

        return $"{JsonTextOrDash(firstDisk, "Model")} ({JsonTextOrDash(firstDisk, "SizeGB")} GB)";
    }

    static string BuildNetworkSummary(JsonElement root)
    {
        if (!root.ValueKind.Equals(JsonValueKind.Object) || !root.TryGetProperty("Network", out var network) || network.ValueKind != JsonValueKind.Array)
        {
            return "-";
        }

        var firstAdapter = network.EnumerateArray().FirstOrDefault();
        if (firstAdapter.ValueKind != JsonValueKind.Object)
        {
            return "-";
        }

        return $"{JsonTextOrDash(firstAdapter, "Adapter")} / {JsonTextOrDash(firstAdapter, "MACAddress")} / {JsonArrayFirstOrDash(firstAdapter, "IPAddress")}";
    }

    JsonElement baselineHardwareAuditRoot = default;
    JsonElement latestHardwareAuditRoot = default;
    var hasBaselineHardwareAudit = TryParseJson(Model.HardwareAuditJson, out baselineHardwareAuditRoot);
    var hasLatestHardwareAudit = TryParseJson(Model.LatestHardwareAuditJson, out latestHardwareAuditRoot);

    var hasAnyFingerprintData =
        !string.IsNullOrWhiteSpace(Model.HardwareHash) ||
        !string.IsNullOrWhiteSpace(Model.LatestHardwareHash) ||
        hasBaselineHardwareAudit ||
        hasLatestHardwareAudit;

    var baselineGeneratedAt = "-";
    var baselineMotherboard = "-";
    var baselineBios = "-";
    var baselineCpu = "-";
    var baselineRam = "-";
    var baselineStorage = "-";
    var baselineNetwork = "-";
    var baselineOperatingSystem = "-";
    var baselineIdentity = "-";

    if (hasBaselineHardwareAudit)
    {
        var motherboard = baselineHardwareAuditRoot.TryGetProperty("Motherboard", out var mb) ? mb : default;
        var bios = baselineHardwareAuditRoot.TryGetProperty("BIOS", out var biosNode) ? biosNode : default;
        var cpu = baselineHardwareAuditRoot.TryGetProperty("CPU", out var cpuNode) ? cpuNode : default;
        var os = baselineHardwareAuditRoot.TryGetProperty("OS", out var osNode) ? osNode : default;
        var identity = baselineHardwareAuditRoot.TryGetProperty("Identity", out var identityNode) ? identityNode : default;

        baselineGeneratedAt = JsonTextOrDash(baselineHardwareAuditRoot, "GeneratedAtUtc");
        baselineMotherboard = $"{JsonTextOrDash(motherboard, "Manufacturer")} {JsonTextOrDash(motherboard, "Product")} / SN: {JsonTextOrDash(motherboard, "SerialNumber")}";
        baselineBios = $"{JsonTextOrDash(bios, "Manufacturer")} {JsonTextOrDash(bios, "Version")} / SN: {JsonTextOrDash(bios, "SerialNumber")}";
        baselineCpu = $"{JsonTextOrDash(cpu, "Name")} / ID: {JsonTextOrDash(cpu, "ProcessorId")}";
        baselineRam = BuildRamSummary(baselineHardwareAuditRoot);
        baselineStorage = BuildStorageSummary(baselineHardwareAuditRoot);
        baselineNetwork = BuildNetworkSummary(baselineHardwareAuditRoot);
        baselineOperatingSystem = $"{JsonTextOrDash(os, "Caption")} ({JsonTextOrDash(os, "Version")})";
        baselineIdentity = $"{JsonTextOrDash(identity, "ComputerName")} / {JsonTextOrDash(identity, "CurrentUser")}";
    }

    var latestGeneratedAt = "-";
    var latestMotherboard = "-";
    var latestBios = "-";
    var latestCpu = "-";
    var latestRam = "-";
    var latestStorage = "-";
    var latestNetwork = "-";
    var latestOperatingSystem = "-";
    var latestIdentity = "-";

    if (hasLatestHardwareAudit)
    {
        var motherboard = latestHardwareAuditRoot.TryGetProperty("Motherboard", out var mb) ? mb : default;
        var bios = latestHardwareAuditRoot.TryGetProperty("BIOS", out var biosNode) ? biosNode : default;
        var cpu = latestHardwareAuditRoot.TryGetProperty("CPU", out var cpuNode) ? cpuNode : default;
        var os = latestHardwareAuditRoot.TryGetProperty("OS", out var osNode) ? osNode : default;
        var identity = latestHardwareAuditRoot.TryGetProperty("Identity", out var identityNode) ? identityNode : default;

        latestGeneratedAt = JsonTextOrDash(latestHardwareAuditRoot, "GeneratedAtUtc");
        latestMotherboard = $"{JsonTextOrDash(motherboard, "Manufacturer")} {JsonTextOrDash(motherboard, "Product")} / SN: {JsonTextOrDash(motherboard, "SerialNumber")}";
        latestBios = $"{JsonTextOrDash(bios, "Manufacturer")} {JsonTextOrDash(bios, "Version")} / SN: {JsonTextOrDash(bios, "SerialNumber")}";
        latestCpu = $"{JsonTextOrDash(cpu, "Name")} / ID: {JsonTextOrDash(cpu, "ProcessorId")}";
        latestRam = BuildRamSummary(latestHardwareAuditRoot);
        latestStorage = BuildStorageSummary(latestHardwareAuditRoot);
        latestNetwork = BuildNetworkSummary(latestHardwareAuditRoot);
        latestOperatingSystem = $"{JsonTextOrDash(os, "Caption")} ({JsonTextOrDash(os, "Version")})";
        latestIdentity = $"{JsonTextOrDash(identity, "ComputerName")} / {JsonTextOrDash(identity, "CurrentUser")}";
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Asset Details: @Model.AssetTag</h2>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-warning shadow-sm px-3 text-dark">
            <i class="bi bi-pencil me-1"></i> Edit Asset
        </a>
        <a asp-action="Index" class="btn btn-sm btn-secondary shadow-sm px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<div class="row">
    <!-- Asset Info -->
    <div class="col-md-5 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0">Hardware Information</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Asset Tag</dt>
                    <dd class="col-sm-8 fw-bold">@Model.AssetTag</dd>

                    <dt class="col-sm-4">Type</dt>
                    <dd class="col-sm-8">
                        @if (Model.AssetType == IT_Form.Models.Enums.AssetType.Others && !string.IsNullOrEmpty(Model.OtherAssetType))
                        {
                            <span>@Model.OtherAssetType</span> <small class="text-muted">(Others)</small>
                        }
                        else
                        {
                            @Model.AssetType
                        }
                    </dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.Status == IT_Form.Models.Enums.AssetStatus.Available)
                        {
                            <span class="badge bg-success">@Model.Status</span>
                        }
                        else
                        {
                            <span class="badge bg-primary">@Model.Status</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Model / Make</dt>
                    <dd class="col-sm-8">@(Model.Model ?? "-")</dd>

                    <dt class="col-sm-4">Serial Number</dt>
                    <dd class="col-sm-8">@(Model.SerialNumber ?? "-")</dd>


                    @if (Model.AssetType == IT_Form.Models.Enums.AssetType.Laptop || 
                        Model.AssetType == IT_Form.Models.Enums.AssetType.DesktopPC || 
                        Model.AssetType == IT_Form.Models.Enums.AssetType.Others)
                    {
                        <dt class="col-sm-4 text-primary">RAM</dt>
                        <dd class="col-sm-8">@(Model.RAM ?? "-") @(string.IsNullOrEmpty(Model.DDRType) ? "" :
                        $"({Model.DDRType})")</dd>

                        <dt class="col-sm-4 text-primary">Storage</dt>
                        <dd class="col-sm-8">@(Model.Storage ?? "-")</dd>

                        <dt class="col-sm-4 text-primary">Windows Version</dt>
                        <dd class="col-sm-8">@(Model.WindowsVersion ?? "-")</dd>
                    }

                    <dt class="col-sm-4">Fingerprint Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.HasHardwareFingerprintMismatch)
                        {
                            <span class="badge bg-warning text-dark">Mismatch Detected</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(Model.HardwareHash) || !string.IsNullOrWhiteSpace(Model.LatestHardwareHash))
                        {
                            <span class="badge bg-success">Matches Baseline</span>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Baseline Hardware Hash</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrWhiteSpace(Model.HardwareHash))
                        {
                            <code>@Model.HardwareHash</code>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Latest Hardware Hash</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrWhiteSpace(Model.LatestHardwareHash))
                        {
                            <code>@Model.LatestHardwareHash</code>
                        }
                        else if (!string.IsNullOrWhiteSpace(Model.HardwareHash))
                        {
                            <code>@Model.HardwareHash</code>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Mismatch Flagged At</dt>
                    <dd class="col-sm-8">@(Model.HardwareFingerprintMismatchDetectedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "-")</dd>

                    <dt class="col-sm-4">Last Seen</dt>
                    <dd class="col-sm-8">@(Model.LastSeen?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "-")</dd>

                    <dt class="col-sm-4">Purchase Date</dt>
                    <dd class="col-sm-8">@(Model.PurchaseDate?.ToString("dd/MM/yyyy") ?? "-")</dd>

                    <dt class="col-sm-4">Warranty Expiry</dt>
                    <dd class="col-sm-8">@(Model.WarrantyExpiry?.ToString("dd/MM/yyyy") ?? "-")</dd>

                    <dt class="col-sm-4">Warranty Plan</dt>
                    <dd class="col-sm-8">
                        @if (Model.NoExtendWarranty)
                        {
                            <span class="badge bg-secondary">No Extend (Notifications Disabled)</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Extend / Monitor</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Assignment History -->
    <div class="col-md-7 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-info text-white">
                <h5 class="card-title mb-0">Assignment History</h5>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @if (Model.IssuedHistory != null && Model.IssuedHistory.Any())
                    {
                        foreach (var history in Model.IssuedHistory.OrderByDescending(h => h.Id))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    @if (history.OnboardingRequest != null)
                                    {
                                        <strong>@history.OnboardingRequest.FullName</strong>
                                        <br />
                                        <small class="text-muted">Req #@history.OnboardingRequestId - @history.OnboardingRequest.Department</small>
                                    }
                                    else if (!string.IsNullOrEmpty(history.CustomEmployeeName))
                                    {
                                        <strong>@history.CustomEmployeeName</strong> <span class="badge bg-light text-dark-50 border ms-1" style="font-size: 0.65em;">Manual</span>
                                        <br />
                                        <small class="text-muted">Direct Assignment</small>
                                    }
                                </div>
                                @if (history.OnboardingRequestId != null)
                                {
                                    <a asp-controller="Onboarding" asp-action="Details" asp-route-id="@history.OnboardingRequestId"
                                        class="btn btn-sm btn-outline-info">View Form</a>
                                }
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item text-muted text-center py-4">No assignment history.</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

@if (Model.HasHardwareFingerprintMismatch && !string.IsNullOrWhiteSpace(Model.HardwareFingerprintWarning))
{
    <div class="alert alert-warning shadow-sm d-flex align-items-start gap-3 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
        <div>
            <div class="fw-semibold mb-1">Hardware fingerprint mismatch detected</div>
            <div>@Model.HardwareFingerprintWarning</div>
        </div>
    </div>
}

@if (hasAnyFingerprintData)
{
    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">First Verified Fingerprint</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Captured At (UTC)</dt>
                        <dd class="col-sm-8">@baselineGeneratedAt</dd>

                        <dt class="col-sm-4">Hardware Hash</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrWhiteSpace(Model.HardwareHash))
                            {
                                <code>@Model.HardwareHash</code>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Motherboard</dt>
                        <dd class="col-sm-8">@baselineMotherboard</dd>

                        <dt class="col-sm-4">BIOS</dt>
                        <dd class="col-sm-8">@baselineBios</dd>

                        <dt class="col-sm-4">CPU</dt>
                        <dd class="col-sm-8">@baselineCpu</dd>

                        <dt class="col-sm-4">RAM</dt>
                        <dd class="col-sm-8">@baselineRam</dd>

                        <dt class="col-sm-4">Storage</dt>
                        <dd class="col-sm-8">@baselineStorage</dd>

                        <dt class="col-sm-4">Network</dt>
                        <dd class="col-sm-8">@baselineNetwork</dd>

                        <dt class="col-sm-4">Operating System</dt>
                        <dd class="col-sm-8">@baselineOperatingSystem</dd>

                        <dt class="col-sm-4">Identity</dt>
                        <dd class="col-sm-8">@baselineIdentity</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header @(Model.HasHardwareFingerprintMismatch ? "bg-warning text-dark" : "bg-success text-white")">
                    <h5 class="card-title mb-0">Latest Verification Fingerprint</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Captured At (UTC)</dt>
                        <dd class="col-sm-8">@latestGeneratedAt</dd>

                        <dt class="col-sm-4">Hardware Hash</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrWhiteSpace(Model.LatestHardwareHash))
                            {
                                <code>@Model.LatestHardwareHash</code>
                            }
                            else if (!string.IsNullOrWhiteSpace(Model.HardwareHash))
                            {
                                <code>@Model.HardwareHash</code>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Motherboard</dt>
                        <dd class="col-sm-8">@latestMotherboard</dd>

                        <dt class="col-sm-4">BIOS</dt>
                        <dd class="col-sm-8">@latestBios</dd>

                        <dt class="col-sm-4">CPU</dt>
                        <dd class="col-sm-8">@latestCpu</dd>

                        <dt class="col-sm-4">RAM</dt>
                        <dd class="col-sm-8">@latestRam</dd>

                        <dt class="col-sm-4">Storage</dt>
                        <dd class="col-sm-8">@latestStorage</dd>

                        <dt class="col-sm-4">Network</dt>
                        <dd class="col-sm-8">@latestNetwork</dd>

                        <dt class="col-sm-4">Operating System</dt>
                        <dd class="col-sm-8">@latestOperatingSystem</dd>

                        <dt class="col-sm-4">Identity</dt>
                        <dd class="col-sm-8">@latestIdentity</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
}

<!-- Maintenance Logs -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Maintenance & Repair Logs</h5>
        <a asp-controller="MaintenanceLog" asp-action="Create" asp-route-itAssetId="@Model.Id"
            class="btn btn-sm btn-light">Log Maintenance</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Service Provider</th>
                        <th>Cost</th>
                        <th>Notes</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.MaintenanceLogs != null && Model.MaintenanceLogs.Any())
                    {
                        foreach (var log in Model.MaintenanceLogs.OrderByDescending(m => m.ServiceDate))
                        {
                            <tr>
                                <td>@log.ServiceDate.ToString("dd/MM/yyyy")</td>
                                <td>@log.Description</td>
                                <td>@(log.ServiceProvider ?? "-")</td>
                                <td>@(log.Cost?.ToString("C") ?? "-")</td>
                                <td>@(log.Notes ?? "-")</td>
                                <td>
                                     <a asp-controller="MaintenanceLog" asp-action="Edit" asp-route-id="@log.Id"
                                         class="text-warning me-2" aria-label="Edit maintenance log #@log.Id"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                     <a asp-controller="MaintenanceLog" asp-action="Delete" asp-route-id="@log.Id"
                                         class="text-danger" aria-label="Delete maintenance log #@log.Id"><i class="bi bi-trash" aria-hidden="true"></i></a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No maintenance logs found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>



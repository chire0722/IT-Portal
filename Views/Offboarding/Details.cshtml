                            <div class="w-100" style="max-width: 300px;">
                                <div id="sigLinkSection-offboarding" class="bg-white p-3 border rounded shadow-sm">
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill w-100 mb-2 shadow-sm fw-bold" onclick="generateSignatureLink('offboarding', '@Model.AccessToken', 'Offboarding')">
                                        <i class="bi bi-link-45deg me-1" aria-hidden="true"></i> Generate Link
                                    </button>
                                    <div id="sigLinkBox-offboarding" style="display: none;">
                                        <div class="input-group shadow-sm mb-2">
                                            <input type="text" class="form-control form-control-sm border-primary" id="sigLinkInput-offboarding" readonly style="font-size: 0.7rem;" />
                                            <button class="btn btn-sm btn-primary px-2" type="button" onclick="copySigLink('offboarding')">

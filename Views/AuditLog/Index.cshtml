    }

    @@media (max-width: 1199.98px) {
        .audit-kpi-grid,
        .audit-insight-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .audit-insight-panel:last-child {
            grid-column: 1 / -1;
        }
    }

    @@media (max-width: 991.98px) {
        .audit-hero {
            grid-template-columns: 1fr;
        }

        .audit-hero-actions {
            justify-content: flex-start;
        }

        .audit-col-2,
        .audit-col-3,
        .audit-col-4,
        .audit-col-actions {
            grid-column: span 6;
        }
    }

    @@media (max-width: 767.98px) {
        .audit-kpi-grid,
        .audit-insight-grid {
            grid-template-columns: 1fr;
        }

        .audit-filter-head,
        .audit-table-head {
            flex-direction: column;
            align-items: stretch;
        }

        .audit-active-filters {
            justify-content: flex-start;
        }

        .audit-col-2,
        .audit-col-3,
        .audit-col-4,
        .audit-col-actions {
            grid-column: 1 / -1;
        }

        .audit-col-actions {
            flex-direction: column;
        }

        .audit-btn {
            width: 100%;
        }

        .audit-insight-panel {
            min-height: 0;
        }

        .audit-table {
            width: 100%;
            min-width: 0;
            table-layout: fixed;
        }

        .audit-table th:nth-child(4),
        .audit-table td:nth-child(4),
        .audit-table th:nth-child(5),
        .audit-table td:nth-child(5),
        .audit-table th:nth-child(6),
        .audit-table td:nth-child(6) {
            display: none;
        }

        .audit-table thead th,
        .audit-table tbody td {
            padding-left: 0.75rem;
            padding-right: 0.75rem;
        }

        .audit-table th:nth-child(1),
        .audit-table td:nth-child(1) {
            width: 112px !important;
        }

        .audit-table th:nth-child(2),
        .audit-table td:nth-child(2) {
            width: 104px !important;
        }

        .audit-table th:nth-child(3),
        .audit-table td:nth-child(3) {
            width: auto !important;
        }

        .audit-table th:nth-child(7),
        .audit-table td:nth-child(7) {
            width: 46px !important;
        }

        .audit-badge {
            display: inline-block;
            min-width: 0;
            max-width: 104px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            text-align: center;
            vertical-align: middle;
        }
    }
</style>

<div class="audit-shell">
    <section class="audit-hero" aria-labelledby="audit-log-title">
        <div class="audit-title-wrap">
            <span class="audit-title-icon" aria-hidden="true">
                <i class="bi bi-shield-check fs-4"></i>
            </span>
            <div>
                <h1 class="audit-title" id="audit-log-title">Audit Log</h1>
                <p class="audit-subtitle">
                    Review entity changes, command executions, failures, and related user activity across HR, IT, and API workflows.
                </p>
            </div>
        </div>
        <div class="audit-hero-actions" aria-label="Audit log actions">
            <a asp-action="Settings" class="audit-btn audit-btn-ghost">
                <i class="bi bi-gear-fill" aria-hidden="true"></i>
                <span>Notification Settings</span>
            </a>
            <a asp-action="ExportCsv" asp-route-search="@search" asp-route-entity="@entity" asp-route-auditAction="@action" asp-route-isSuccess="@isSuccess"
               asp-route-startDate="@startDate" asp-route-endDate="@endDate"
               class="audit-btn audit-btn-success">
                <i class="bi bi-download" aria-hidden="true"></i>
                <span>Export CSV</span>
            </a>
        </div>
    </section>

    <form method="get" class="audit-filter-panel" aria-label="Audit log filters">
        <div class="audit-filter-head">
            <div>
                <h2 class="audit-panel-title">Investigate Activity</h2>
                <p class="audit-panel-subtitle">Current scope: @selectedEntityLabel, @selectedActionLabel, @selectedOutcomeLabel.</p>
            </div>
            <div class="audit-active-filters" aria-label="Current filter summary">
                <span class="audit-chip audit-chip-blue"><i class="bi bi-funnel" aria-hidden="true"></i>@activeFilterCount active</span>
                <span class="audit-chip @riskStatusClass"><i class="bi bi-activity" aria-hidden="true"></i>@riskStatus</span>
            </div>
        </div>

        <div class="audit-filter-grid">
            <div class="audit-field audit-col-2">
                <label for="auditEntity">Entity Type</label>
                <select id="auditEntity" name="entity" class="form-select">
                    <option value="">All Entities</option>
                    @foreach (var (val, label) in entities)
                    {
                        <option value="@val" selected="@(entity == val)">@label</option>
                    }
                </select>
            </div>
            <div class="audit-field audit-col-2">
                <label for="auditAction">Action</label>
                <select id="auditAction" name="auditAction" class="form-select">
                    <option value="">All Actions</option>
                    <option value="Created" selected="@(action == "Created")">Created</option>
                    <option value="Updated" selected="@(action == "Updated")">Updated</option>
                    <option value="Deleted" selected="@(action == "Deleted")">Deleted</option>
                    <option value="Rejected" selected="@(action == "Rejected")">Rejected</option>
                    <option value="Login" selected="@(action == "Login")">Login</option>
                </select>
            </div>
            <div class="audit-field audit-col-2">
                <label for="auditOutcome">Outcome</label>
                <select id="auditOutcome" name="isSuccess" class="form-select">
                    <option value="">All Outcomes</option>
                    <option value="true" selected="@(isSuccess == true)">Success</option>
                    <option value="false" selected="@(isSuccess == false)">Failed</option>
                </select>
            </div>
            <div class="audit-field audit-col-2">
                <label for="auditStartDate">Start Date</label>
                <input id="auditStartDate" type="date" name="startDate" class="form-control" value="@startDate" />
            </div>
            <div class="audit-field audit-col-2">
                <label for="auditEndDate">End Date</label>
                <input id="auditEndDate" type="date" name="endDate" class="form-control" value="@endDate" />
            </div>
            <div class="audit-field audit-col-4">
                <label for="auditSearch">Search</label>
                <input id="auditSearch" type="text" name="search" class="form-control" value="@search"
                       placeholder="User, ID, IP address, error, or details" />
            </div>
            <div class="audit-col-actions">
                <button type="submit" class="audit-btn audit-btn-primary">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <span>Filter</span>
                </button>
                <a asp-action="Index" class="audit-btn audit-btn-ghost">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                    <span>Reset</span>
                </a>
            </div>
        </div>

        <div class="audit-filter-actions" aria-label="Common audit log views">
            <a asp-action="Index" asp-route-entity="Command" asp-route-isSuccess="false" class="audit-chip audit-chip-danger">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>Failed Commands
            </a>
            <a asp-action="Index" asp-route-entity="Command" class="audit-chip">
                <i class="bi bi-diagram-3" aria-hidden="true"></i>Command Audits
            </a>
            <a asp-action="Index" asp-route-isSuccess="false" class="audit-chip">
                <i class="bi bi-bug" aria-hidden="true"></i>All Failures
            </a>
        </div>
    </form>

    <section class="audit-kpi-grid" aria-label="Audit summary">
        <article class="audit-metric" style="--metric-accent: var(--audit-blue);">
            <div class="audit-metric-top">
                <span class="audit-metric-label">Filtered Entries</span>
                <span class="audit-metric-icon" aria-hidden="true"><i class="bi bi-collection"></i></span>
            </div>
            <div class="audit-metric-value">@entries.TotalCount</div>
            <div class="audit-metric-note">Records matching the current investigation scope.</div>
        </article>
        <article class="audit-metric" style="--metric-accent: var(--audit-red);">
            <div class="audit-metric-top">
                <span class="audit-metric-label">Failures</span>
                <span class="audit-metric-icon" aria-hidden="true"><i class="bi bi-exclamation-octagon"></i></span>
            </div>
            <div class="audit-metric-value">@Model.FilteredFailureCount</div>
            <div class="audit-metric-note">@Model.FilteredSuccessCount success entries remain in scope.</div>
        </article>
        <article class="audit-metric" style="--metric-accent: #7c3aed;">
            <div class="audit-metric-top">
                <span class="audit-metric-label">Command Audits</span>
                <span class="audit-metric-icon" aria-hidden="true"><i class="bi bi-terminal"></i></span>
            </div>
            <div class="audit-metric-value">@Model.FilteredCommandCount</div>
            <div class="audit-metric-note">@Model.FailedCommandCount failed command executions.</div>
        </article>
        <article class="audit-metric" style="--metric-accent: #f59f00;">
            <div class="audit-metric-top">
                <span class="audit-metric-label">Failure Rate</span>
                <span class="audit-metric-icon" aria-hidden="true"><i class="bi bi-percent"></i></span>
            </div>
            <div class="audit-metric-value">@Model.FailureRate.ToString("0.0")%</div>
            <div class="audit-metric-note">Failure share across filtered entries.</div>
        </article>
    </section>

    <section class="audit-insight-grid" aria-label="Failure insights">
        <article class="audit-insight-panel">
            <div class="audit-insight-head">
                <div>
                    <h2 class="audit-panel-title">Top Failed Actions</h2>
                    <p class="audit-panel-subtitle">Highest-volume failed operations.</p>
                </div>
                <a asp-action="Index" asp-route-isSuccess="false" class="audit-chip audit-chip-danger">Focus</a>
            </div>
            @if (Model.TopFailedActions.Any())
            {
                <div class="audit-list">
                    @foreach (var item in Model.TopFailedActions)
                    {
                        var width = Math.Max(10, (int)Math.Round(item.Count * 100.0 / maxFailedActionCount));
                        <div class="audit-list-row">
                            <div class="audit-list-main">
                                <span class="audit-list-label" title="@item.Action">@item.Action</span>
                                <div class="audit-bar-track" aria-hidden="true">
                                    <div class="audit-bar" style="--bar-color: var(--audit-red); width:@width%"></div>
                                </div>
                            </div>
                            <span class="audit-count">@item.Count</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="audit-muted-empty">No failed actions in the current filter scope.</div>
            }
        </article>

        <article class="audit-insight-panel">
            <div class="audit-insight-head">
                <div>
                    <h2 class="audit-panel-title">Top Failed Users</h2>
                    <p class="audit-panel-subtitle">Actors linked to failed records.</p>
                </div>
                <a asp-action="Index" asp-route-isSuccess="false" class="audit-chip">View</a>
            </div>
            @if (Model.TopFailedActors.Any())
            {
                <div class="audit-list">
                    @foreach (var item in Model.TopFailedActors)
                    {
                        var width = Math.Max(10, (int)Math.Round(item.Count * 100.0 / maxFailedActorCount));
                        <div class="audit-list-row">
                            <div class="audit-list-main">
                                <span class="audit-list-label" title="@item.Actor">@item.Actor</span>
                                <div class="audit-bar-track" aria-hidden="true">
                                    <div class="audit-bar" style="--bar-color: var(--audit-blue); width:@width%"></div>
                                </div>
                            </div>
                            <span class="audit-count">@item.Count</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="audit-muted-empty">No failed users in the current filter scope.</div>
            }
        </article>

        <article class="audit-insight-panel">
            <div class="audit-insight-head">
                <div>
                    <h2 class="audit-panel-title">Failure Trend</h2>
                    <p class="audit-panel-subtitle">Most recent 14 days in scope.</p>
                </div>
                <span class="audit-chip audit-chip-blue">@Model.FilteredFailureCount total</span>
            </div>
            @if (Model.FailureTrend.Any())
            {
                <div class="audit-trend-chart" role="img" aria-label="Failure trend for the most recent 14 days in scope">
                    @foreach (var point in Model.FailureTrend)
                    {
                        var heightPercent = Math.Max(12, (int)Math.Round(point.Count * 100.0 / maxTrendCount));
                        <div class="audit-trend-point">
                            <span class="audit-trend-value">@point.Count</span>
                            <span class="audit-trend-bar-wrap" aria-hidden="true">
                                <span class="audit-trend-bar" style="height:@heightPercent%"></span>
                            </span>
                            <span class="audit-trend-label">@point.Label</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="audit-muted-empty">No failed entries available to plot for the current filter scope.</div>
            }
        </article>
    </section>

    @if (!entries.Any())
    {
        <section class="audit-empty-state" aria-live="polite">
            <span class="audit-empty-icon" aria-hidden="true">
                <i class="bi bi-journal-x"></i>
            </span>
            <h2 class="audit-panel-title">No audit log entries found</h2>
            <p class="audit-panel-subtitle">Try widening the date range, clearing the search term, or resetting filters.</p>
        </section>
    }
    else
    {
        <section class="audit-table-panel" aria-labelledby="audit-table-title">
            <div class="audit-table-head">
                <div>
                    <h2 class="audit-panel-title" id="audit-table-title">Audit Trail</h2>
                    <p class="audit-panel-subtitle">Newest events first, grouped by correlation where available.</p>
                </div>
                <span class="audit-table-count">
                    Showing @((entries.PageIndex - 1) * 25 + 1)-@((entries.PageIndex - 1) * 25 + entries.Count) of @entries.TotalCount
                </span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle audit-table">
                    <thead>
                        <tr>
                            <th style="width: 150px;">Time</th>
                            <th style="width: 98px;">Outcome</th>
                            <th style="width: 112px;">Action</th>
                            <th style="width: 210px;">Entity</th>
                            <th>Details</th>
                            <th style="width: 180px;">Actor</th>
                            <th style="width: 72px;" class="text-end">Open</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in entries)
                        {
                            var auditTime = log.CreatedAt == default ? log.Timestamp : log.CreatedAt;
                            var actionClass = log.Action switch
                            {
                                "Created" => "audit-badge-success",
                                "Deleted" => "audit-badge-danger",
                                "Rejected" => "audit-badge-danger",
                                "Updated" => "audit-badge-warning",
                                _ => "audit-badge-neutral"
                            };
                            var rowClass = !log.IsSuccess ? "audit-row-failed" : (log.CorrelationId.HasValue ? "audit-row-correlated" : "");

                            <tr class="@rowClass">
                                <td>
                                    <div class="audit-time">@auditTime.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    <div class="audit-time-sub">@auditTime.ToLocalTime().ToString("HH:mm:ss")</div>
                                </td>
                                <td>
                                    <span class="audit-badge @(log.IsSuccess ? "audit-badge-success" : "audit-badge-danger")">
                                        @(log.IsSuccess ? "Success" : "Failed")
                                    </span>
                                </td>
                                <td>
                                    <span class="audit-badge @actionClass">@log.Action</span>
                                </td>
                                <td>
                                    <div class="audit-entity-cell">
                                        <span class="audit-entity-icon" aria-hidden="true">
                                            @switch (log.EntityName)
                                            {
                                                case "ApplicationUser":
                                                    <i class="bi bi-person-gear"></i>
                                                    break;
                                                case "UserTitle":
                                                    <i class="bi bi-person-badge"></i>
                                                    break;
                                                case "UserCompany":
                                                    <i class="bi bi-building-gear"></i>
                                                    break;
                                                case "OnboardingRequest":
                                                    <i class="bi bi-person-plus"></i>
                                                    break;
                                                case "OffboardingRequest":
                                                    <i class="bi bi-person-dash"></i>
                                                    break;
                                                case "SoftwareLicense":
                                                    <i class="bi bi-key"></i>
                                                    break;
                                                case "ITAsset":
                                                    <i class="bi bi-pc-display"></i>
                                                    break;
                                                case "MaintenanceLog":
                                                    <i class="bi bi-wrench"></i>
                                                    break;
                                                case "EmailContact":
                                                    <i class="bi bi-person-rolodex"></i>
                                                    break;
                                                case "Command":
                                                    <i class="bi bi-terminal"></i>
                                                    break;
                                                default:
                                                    <i class="bi bi-file-earmark-text"></i>
                                                    break;
                                            }
                                        </span>
                                        <span class="min-w-0">
                                            <span class="d-block fw-bold text-truncate" title="@log.EntityName">
                                                @switch (log.EntityName)
                                                {
                                                    case "ApplicationUser":
                                                        <text>User Account</text>
                                                        break;
                                                    case "UserTitle":
                                                        <text>User Title</text>
                                                        break;
                                                    case "UserCompany":
                                                        <text>User Company</text>
                                                        break;
                                                    case "OnboardingRequest":
                                                        <text>Onboarding</text>
                                                        break;
                                                    case "OffboardingRequest":
                                                        <text>Offboarding</text>
                                                        break;
                                                    case "SoftwareLicense":
                                                        <text>License</text>
                                                        break;
                                                    case "ITAsset":
                                                        <text>IT Asset</text>
                                                        break;
                                                    case "MaintenanceLog":
                                                        <text>Maintenance</text>
                                                        break;
                                                    case "EmailContact":
                                                        <text>Contact</text>
                                                        break;
                                                    case "Command":
                                                        <text>Command Pipeline</text>
                                                        break;
                                                    default:
                                                        @log.EntityName
                                                        break;
                                                }
                                            </span>
                                            <span class="audit-entity-id">ID: #@log.EntityId</span>
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <div class="audit-details-text">
                                        @(string.IsNullOrWhiteSpace(log.Details) ? log.ErrorMessage : log.Details)
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(log.ErrorMessage))
                                    {
                                        <div class="audit-error-text">@log.ErrorMessage</div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold">@log.PerformedBy</div>
                                    @if (!string.IsNullOrWhiteSpace(log.UserId) && !string.Equals(log.UserId, log.PerformedBy, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <div class="audit-user-sub">@log.UserId</div>
                                    }
                                    @if (!string.IsNullOrEmpty(log.IpAddress))
                                    {
                                        <div class="audit-user-sub">@log.IpAddress</div>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@log.Id" class="btn btn-action-circle btn-outline-secondary" title="View details" aria-label="View audit entry @log.Id details">
                                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (entries.TotalPages > 1)
            {
                <div class="pagination-wrapper">
                    <span class="pagination-info">
                        Page @entries.PageIndex of @entries.TotalPages
                    </span>
                    <nav aria-label="Pagination">
                        <ul class="pagination mb-0">
                            <li class="page-item @(!entries.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(entries.PageIndex - 1)"
                                   asp-route-entity="@entity" asp-route-auditAction="@action" asp-route-search="@search"
                                   asp-route-isSuccess="@isSuccess" asp-route-startDate="@startDate" asp-route-endDate="@endDate" aria-label="Previous Page">
                                    <i class="bi bi-chevron-left" aria-hidden="true"></i>
                                </a>
                            </li>
                            @for (int i = 1; i <= entries.TotalPages; i++)
                            {
                                <li class="page-item @(i == entries.PageIndex ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-entity="@entity"
                                       asp-route-auditAction="@action" asp-route-search="@search"
                                       asp-route-isSuccess="@isSuccess" asp-route-startDate="@startDate" asp-route-endDate="@endDate">@i</a>
                                </li>
                            }
                            <li class="page-item @(!entries.HasNextPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(entries.PageIndex + 1)"
                                   asp-route-entity="@entity" asp-route-auditAction="@action" asp-route-search="@search"
                                   asp-route-isSuccess="@isSuccess" asp-route-startDate="@startDate" asp-route-endDate="@endDate" aria-label="Next Page">
                                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </section>
    }
</div>

@model IT_Form.Models.MaintenanceLog

@{
    ViewData["Title"] = "Log Maintenance";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h4 class="mb-0">Log Maintenance for @ViewBag.AssetTag</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="ITAssetId" />

                    <div class="row g-3">
                        <div class="col-md-5 mb-3">
                            <label asp-for="ServiceDate" class="form-label fw-bold">Service Date *</label>
                            <input asp-for="ServiceDate" type="date" class="form-control" />
                            <span asp-validation-for="ServiceDate" class="text-danger" aria-live="polite" aria-atomic="true"></span>
                        </div>

                        <div class="col-md-7 mb-3">
                            <label asp-for="Cost" class="form-label fw-bold">Cost (RM)</label>
                            <div class="input-group">
                                <span class="input-group-text">RM</span>
                                <input asp-for="Cost" type="number" step="0.01" class="form-control"
                                    placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Cost" class="text-danger" aria-live="polite" aria-atomic="true"></span>
                        </div>

                        <div class="col-md-12 mb-3">
                            <label asp-for="Description" class="form-label fw-bold">Description of Issue/Service
                                *</label>
                            <input asp-for="Description" class="form-control"
                                placeholder="e.g. Replaced laptop battery" />
                            <span asp-validation-for="Description" class="text-danger" aria-live="polite" aria-atomic="true"></span>
                        </div>

                        <div class="col-md-12 mb-3">
                            <label asp-for="ServiceProvider" class="form-label fw-bold">Service Provider</label>
                            <input asp-for="ServiceProvider" class="form-control"
                                placeholder="e.g. Dell Support, Internal IT" />
                            <span asp-validation-for="ServiceProvider" class="text-danger" aria-live="polite" aria-atomic="true"></span>
                        </div>

                        <div class="col-md-12 mb-3">
                            <label asp-for="Notes" class="form-label fw-bold">Additional Notes</label>
                            <textarea asp-for="Notes" class="form-control" rows="3"
                                placeholder="Any other details..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger" aria-live="polite" aria-atomic="true"></span>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-between">
                        <a asp-controller="ITAsset" asp-action="Details" asp-route-id="@Model.ITAssetId"
                            class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-success px-4">Save Maintenance Log</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}


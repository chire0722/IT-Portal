@model IT_Form.ViewModels.OffboardingIndexPageViewModel
@using IT_Form.Models.Enums
@{
    ViewData["Title"] = "Offboarding Dashboard";
    var currentFilter = Model.CurrentFilter;
    var statusFilter = Model.StatusFilter;
    var allRequests = Model.Requests;
    var slaTargetDays = Model.SlaTargetDays;
    var isITUser = User.HasClaim("UserTitle", "IT");
    var isHRUser = User.HasClaim("UserTitle", "HR");
    var isHODUser = User.HasClaim("UserTitle", "HOD");
}

<div class="page-header">
    <div class="page-header-left">
        <h2><i class="bi bi-person-dash me-2" aria-hidden="true"></i>Offboarding Dashboard</h2>
        <span class="subtitle">Manage all employee offboarding requests</span>
    </div>
    <div class="d-flex gap-2">
        <button id="btnBulkExport" class="btn btn-sm btn-danger fw-bold shadow-sm px-3" style="display: none;">
            <i class="bi bi-file-earmark-zip me-2" aria-hidden="true"></i>Bulk PDF Sync (<span id="selectedCount">0</span>)
        </button>
        @if (!isITUser && !isHODUser)
        {
            <a asp-action="ExportCsv" asp-route-searchString="@currentFilter"
               asp-route-status="@statusFilter" class="btn btn-sm btn-secondary shadow-sm px-3 d-inline-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-filetype-csv me-1" aria-hidden="true"></i>Export CSV
            </a>
            <a asp-controller="Offboarding" asp-action="Create" class="btn btn-sm btn-primary shadow-sm px-3 d-inline-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-person-dash-fill me-1"></i> New Offboarding Request
            </a>
        }
    </div>
</div>


<div class="stats-row">
    <div class="stat-card stat-primary">
        <div class="stat-value">@allRequests.TotalCount</div>
        <div class="stat-label">Total Requests</div>
    </div>
    <div class="stat-card stat-hod">
        <div class="stat-value">@allRequests.Count(r => r.Status == RequestStatus.PendingHODApproval || r.Status == RequestStatus.PendingApproval)</div>
        <div class="stat-label">Awaiting HOD Approval</div>
    </div>
    <div class="stat-card stat-warning">
        <div class="stat-value">@allRequests.Count(r => r.Status == RequestStatus.PendingITApproval)</div>
        <div class="stat-label">Pending IT Approval</div>
    </div>
    @if (isHRUser || isHODUser)
    {
        <div class="stat-card stat-info">
            <div class="stat-value">@allRequests.Count(r => r.Status == RequestStatus.PendingEmployeeSign)</div>
            <div class="stat-label">Pending Employee Sign</div>
        </div>
    }
    <div class="stat-card stat-success">
        <div class="stat-value">@allRequests.Count(r => r.Status == RequestStatus.Completed)</div>
        <div class="stat-label">Completed</div>
    </div>
    <div class="stat-card stat-danger">
        <div class="stat-value">@allRequests.Count(r => r.Status == RequestStatus.Rejected)</div>
        <div class="stat-label">Rejected</div>
    </div>
</div>

<!-- Search & Filter -->
<div class="card mb-4 animate-in">
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small fw-bold">Search Name or ID</label>
                    <input type="text" name="searchString" class="form-control form-control-sm"
                        value="@currentFilter" placeholder="Search by name, ID, or department..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Status Filter</label>
                    <select name="status" class="form-select form-select-sm">
                        <option value="">All Statuses</option>
                        @foreach (var s in Enum.GetValues<RequestStatus>())
                        {
                            <option value="@s" selected="@(statusFilter == s)">
                                @(s == RequestStatus.PendingITApproval ? "Pending IT Approval" : s == RequestStatus.PendingHODApproval ? "Awaiting HOD Approval" : s == RequestStatus.PendingEmployeeSign ? "Pending Employee Sign" : s == RequestStatus.PendingApproval ? "Awaiting HOD Approval" : s.ToString())
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary btn-sm w-100">
                        <i class="bi bi-search me-1" aria-hidden="true"></i>Filter
                    </button>
                </div>
                <div class="col-md-2">
                    <a asp-action="Index" class="btn btn-secondary btn-sm w-100">
                        <i class="bi bi-x-circle me-1" aria-hidden="true"></i>Clear
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Requests Table -->
<div class="card animate-in" style="animation-delay: 0.1s;">
    <div class="card-body p-0">
        @if (!allRequests.Any())
        {
                <div class="text-center py-5" style="color: var(--text-muted);">
                    <i class="bi bi-clipboard-x" style="font-size: 3rem;" aria-hidden="true"></i>
                    <h5 class="mt-3">No offboarding requests found</h5>
                    <p>Try adjusting your search or filters, or click "New Request" to create one.</p>
                </div>
        }
        else
        {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th style="width: 40px;">
                                    <input class="form-check-input" type="checkbox" id="selectAll" aria-label="Select all requests">
                                </th>
                                <th>#</th>
                                <th data-sort="text">Employee</th>
                                <th data-sort="text">Department</th>
                                <th data-sort="text">Assigned HOD</th>
                                <th data-sort="text">Status</th>
                                <th data-sort="date">Due Date Time</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        @{
                            int idx = (allRequests.PageIndex - 1) * 10 + 1;
                        }
                        @foreach (var req in allRequests)
                        {
                            var badgeClass = req.Status switch
                            {
                                RequestStatus.Draft => "badge-draft",
                                RequestStatus.PendingApproval => "badge-hod",
                                RequestStatus.PendingHODApproval => "badge-hod",
                                RequestStatus.PendingITApproval => "badge-pending",
                                RequestStatus.PendingEmployeeSign => "badge-employeesign",
                                RequestStatus.Approved => "badge-completed",
                                RequestStatus.Completed => "badge-completed",
                                RequestStatus.Rejected => "badge-rejected",
                                _ => "badge-draft"
                            };
                                    <tr>
                                        <td>
                                            <input class="form-check-input row-checkbox" type="checkbox" value="@req.Id" aria-label="Select @req.FullName">
                                        </td>
                                        <td>@(idx++)</td>
                                        <td>
                                            <strong>@req.FullName</strong>
                                        </td>
                                        <td>@req.Department</td>
                                        <td>@(req.AssignedHodName ?? req.HodEmail ?? "Unassigned")</td>
                                        <td><span class="@badgeClass">@(req.Status == RequestStatus.PendingITApproval ? "Pending IT Approval" : req.Status == RequestStatus.PendingHODApproval || req.Status == RequestStatus.PendingApproval ? "Awaiting HOD Approval" : req.Status == RequestStatus.PendingEmployeeSign ? "Pending Employee Sign" : req.Status == RequestStatus.Approved ? "Completed" : req.Status.ToString())</span></td>
                                        <td>
                                            @if (req.Status != RequestStatus.Completed && req.Status != RequestStatus.Rejected && req.Status != RequestStatus.Approved)
                                            {
                                                var deadline = IT_Form.Helpers.SlaHelper.CalculateSlaDeadline(req.RequestDate, slaTargetDays);
                                                var isOverdue = DateTime.UtcNow > deadline;
                                                <div class="@(isOverdue ? "text-danger fw-bold" : "text-primary fw-bold")">
                                                    @deadline.AddHours(8).ToString("dd/MM/yyyy HH:mm")
                                                </div>
                                                if (isOverdue)
                                                {
                                                    <span class="badge bg-danger mt-1" title="Overdue"><i class="bi bi-stopwatch me-1" aria-hidden="true"></i>Overdue</span>
                                                }
                                            }
                                            else
                                            {
                                                <div class="text-muted small">Submitted: @req.RequestDate.ToString("dd/MM/yyyy")</div>
                                            }
                                            <div class="mt-1">
                                                <small class="fw-bold" style="color: #d9534f;">Last Day: @req.LastDayOfWork.ToString("dd/MM/yyyy")</small>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <a asp-action="Details" asp-route-id="@req.Id" class="btn btn-sm btn-secondary"
                                                    title="View Details" aria-label="View details for @req.FullName">
                                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                                </a>
                                                @if (req.Status != RequestStatus.Draft)
                                                {
                                                    <a asp-action="GeneratePdf" asp-route-id="@req.Id" class="btn btn-sm btn-outline-primary"
                                                        title="Download PDF" aria-label="Download PDF for @req.FullName">
                                                        <i class="fas fa-file-pdf" aria-hidden="true"></i>
                                                    </a>
                                                }
                                                @if (isITUser && req.Status != RequestStatus.Completed && req.Status != RequestStatus.PendingEmployeeSign && req.Status != RequestStatus.Rejected)
                                                {
                                                    <a asp-action="ITSetup" asp-route-id="@req.Id" class="btn btn-sm btn-outline-info"
                                                        title="IT Setup" aria-label="IT Setup request for @req.FullName">
                                                        <i class="bi bi-laptop" aria-hidden="true"></i>
                                                    </a>
                                                }
                                                @if (req.Status == RequestStatus.Draft || req.Status == RequestStatus.Rejected)
                                                {
                                                    <form asp-action="Delete" asp-route-id="@req.Id" method="post" class="d-inline"
                                                          onsubmit="return confirm('Are you sure you want to delete this offboarding request for @req.FullName?');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete" aria-label="Delete request for @req.FullName">
                                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                        }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (allRequests.TotalPages > 1)
                {
                    <div class="pagination-wrapper">
                        <span class="pagination-info">
                            Showing @((allRequests.PageIndex - 1) * 10 + 1)–@((allRequests.PageIndex - 1) * 10 + allRequests.Count) of @allRequests.TotalCount
                        </span>
                        <nav aria-label="Pagination">
                            <ul class="pagination">
                                <li class="page-item @(!allRequests.HasPreviousPage ? "disabled" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@(allRequests.PageIndex - 1)"
                                       asp-route-searchString="@currentFilter" asp-route-status="@statusFilter" aria-label="Previous Page">
                                        <i class="bi bi-chevron-left" aria-hidden="true"></i>
                                    </a>
                                </li>
                                @for (int i = 1; i <= allRequests.TotalPages; i++)
                                {
                                    <li class="page-item @(i == allRequests.PageIndex ? "active" : "")" @(i == allRequests.PageIndex ? "aria-current=\"page\"" : "")>
                                        <a class="page-link" asp-action="Index" asp-route-page="@i"
                                           asp-route-searchString="@currentFilter" asp-route-status="@statusFilter">@i</a>
                                    </li>
                                }
                                <li class="page-item @(!allRequests.HasNextPage ? "disabled" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@(allRequests.PageIndex + 1)"
                                       asp-route-searchString="@currentFilter" asp-route-status="@statusFilter" aria-label="Next Page">
                                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const selectAll = document.getElementById('selectAll');
            const checkboxes = document.querySelectorAll('.row-checkbox');
            const btnBulkExport = document.getElementById('btnBulkExport');
            const selectedCount = document.getElementById('selectedCount');

            function updateBulkExportButton() {
                const checked = document.querySelectorAll('.row-checkbox:checked').length;
                if (checked > 0) {
                    selectedCount.textContent = checked;
                    btnBulkExport.style.display = 'inline-block';
                } else {
                    btnBulkExport.style.display = 'none';
                    if (selectAll) selectAll.checked = false;
                }
            }

            if (selectAll) {
                selectAll.addEventListener('change', function () {
                    checkboxes.forEach(cb => cb.checked = this.checked);
                    updateBulkExportButton();
                });
            }

            checkboxes.forEach(cb => {
                cb.addEventListener('change', function () {
                    if (!this.checked && selectAll) selectAll.checked = false;
                    updateBulkExportButton();
                });
            });

            if (btnBulkExport) {
                btnBulkExport.addEventListener('click', function () {
                    const ids = Array.from(document.querySelectorAll('.row-checkbox:checked')).map(cb => parseInt(cb.value));
                    if (ids.length === 0) return;

                    const originalText = btnBulkExport.innerHTML;
                    btnBulkExport.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Exporting...';
                    btnBulkExport.disabled = true;

                    fetch('@Url.Action("ExportBulkPdf", "Offboarding")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify(ids)
                    })
                    .then(response => {
                        if (!response.ok) throw new Error('Export failed');
                        let filename = `Offboarding_PDFs_${new Date().toISOString().slice(0, 10).replace(/-/g, '')}.zip`;
                        const disposition = response.headers.get('content-disposition');
                        if (disposition && disposition.indexOf('attachment') !== -1) {
                            const filenameRegex = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/;
                            const matches = filenameRegex.exec(disposition);
                            if (matches != null && matches[1]) {
                                filename = matches[1].replace(/['"]/g, '');
                            }
                        }
                        return response.blob().then(blob => ({ blob, filename }));
                    })
                    .then(({blob, filename}) => {
                        const url = window.URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.style.display = 'none';
                        a.href = url;
                        a.download = filename;
                        document.body.appendChild(a);
                        a.click();
                        window.URL.revokeObjectURL(url);
                        
                        btnBulkExport.innerHTML = originalText;
                        btnBulkExport.disabled = false;
                        
                        if (selectAll) selectAll.checked = false;
                        checkboxes.forEach(cb => cb.checked = false);
                        updateBulkExportButton();
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('Could not generate bulk PDFs. Please try again.');
                        btnBulkExport.innerHTML = originalText;
                        btnBulkExport.disabled = false;
                    });
                });
            }
        });
    </script>
}




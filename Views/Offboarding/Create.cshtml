@* Project comment: Create.cshtml renders part of the IT Form web user interface. *@

@model IT_Form.ViewModels.OffboardingCreatePageViewModel

@{
    ViewData["Title"] = "Start Offboarding";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card animate-in">
            <div class="card-header">
                <i class="bi bi-person-dash me-2" style="color: var(--primary-light);" aria-hidden="true"></i>Initiate Offboarding
            </div>
            <div class="card-body">
                <form asp-action="Create" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="row g-3">
                        <div class="col-md-12 mb-3">
                            <label asp-for="OnboardingRequestId" class="form-label fw-bold">Select Active Employee
                                *</label>
                            <select asp-for="OnboardingRequestId" class="form-select" asp-items="Model.Employees"
                                id="employeeSelect" required>
                                <option value="">-- Choose Employee to Offboard --</option>
                            </select>
                            <span asp-validation-for="OnboardingRequestId" class="text-danger" aria-live="polite" aria-atomic="true"></span>
                        </div>

                        <!-- These fields are now auto-filled and read-only to ensure data integrity -->
                        <div class="col-md-5 mb-3">
                            <label asp-for="FullName" class="form-label fw-bold text-muted">Full Name</label>
                            <input asp-for="FullName" class="form-control bg-light" id="FullName" readonly />
                            <span asp-validation-for="FullName" class="text-danger" aria-live="polite" aria-atomic="true"></span>
                        </div>

                        <div class="col-md-7 mb-3">
                            <label asp-for="EmployeeID" class="form-label fw-bold text-muted">Employee ID / IC</label>
                            <input asp-for="EmployeeID" class="form-control bg-light" id="EmployeeID" readonly />
                            <span asp-validation-for="EmployeeID" class="text-danger" aria-live="polite" aria-atomic="true"></span>
                        </div>

                        <div class="col-md-5 mb-3">
                            <label asp-for="Department" class="form-label fw-bold text-muted">Department</label>
                            <input asp-for="Department" class="form-control bg-light" id="Department" readonly />
                            <span asp-validation-for="Department" class="text-danger" aria-live="polite" aria-atomic="true"></span>
                        </div>

                        <div class="col-md-7 mb-3">
                            <label asp-for="Branch" class="form-label fw-bold text-muted">Company</label>
                            <input asp-for="Branch" class="form-control bg-light" id="Branch" readonly />
                            <span asp-validation-for="Branch" class="text-danger" aria-live="polite" aria-atomic="true"></span>
                        </div>

                        <div class="col-md-5 mb-3">
                            <label asp-for="AssignedHodId" class="form-label fw-bold">Assign Head of Department *</label>
                            <select asp-for="AssignedHodId" class="form-select" id="AssignedHodIdSelect" asp-items="Model.AssignedHodList" required>
                                <option value="">-- Select HOD --</option>
                            </select>
                            <span asp-validation-for="AssignedHodId" class="text-danger" aria-live="polite" aria-atomic="true"></span>
                            <input type="hidden" asp-for="HODEmail" id="HODEmailHidden" />
                        </div>
                        <!-- End auto-filled fields -->

                        <div class="col-md-7 mb-3">
                            <label asp-for="LastDayOfWork" class="form-label fw-bold text-danger">Last Day of Work
                                *</label>
                            <input asp-for="LastDayOfWork" type="date" class="form-control border-danger" required />
                            <span asp-validation-for="LastDayOfWork" class="text-danger" aria-live="polite" aria-atomic="true"></span>
                        </div>

                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold text-danger"><i
                                    class="fas fa-file-upload me-2" aria-hidden="true"></i>Resignation Letter Upload *</label>
                            <input type="file" name="resignationLetter" class="form-control border-danger"
                                accept=".pdf,.png,.jpg,.jpeg" required data-drag-upload="true" />
                            <div class="form-text text-muted small"><i class="fas fa-info-circle me-1" aria-hidden="true"></i>Please upload
                                the official signed resignation letter (PDF, PNG, JPG).</div>
                        </div>
                    </div>

                    <div class="mt-4 pt-4 border-top d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-play-circle me-1" aria-hidden="true"></i> Start
                            Workflow</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Select2 CSS & JS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        var assignedHodSelectId = 'AssignedHodIdSelect';
        var employeeSelectId = 'employeeSelect';
        var branchInputId = 'Branch';
        var currentHODs = [];
        var hodFetchToken = 0;

        function updateSelectedHodEmail() {
            var selectedId = document.getElementById(assignedHodSelectId).value;
            var hod = currentHODs.find(function(h) { return h.id === selectedId; });
            document.getElementById('HODEmailHidden').value = hod ? (hod.email || '') : '';
        }

        function loadHODsByCompany(company, preferredEmail, preferredId) {
            var $select = $('#' + assignedHodSelectId);
            var selectEl = document.getElementById(assignedHodSelectId);
            var currentVal = selectEl.value;
            var normalizedCompany = (company || '').trim();

            if (!normalizedCompany) {
                currentHODs = [];
                $select.empty().append('<option value="">-- Select HOD --</option>');
                $select.prop('disabled', true);
                $select.trigger('change.select2');
                updateSelectedHodEmail();
                return;
            }

            var requestToken = ++hodFetchToken;
            fetch('/api/employees/hods-by-company?company=' + encodeURIComponent(normalizedCompany))
                .then(function(response) {
                    if (!response.ok) throw new Error('Failed to load HODs');
                    return response.json();
                })
                .then(function(hods) {
                    if (requestToken !== hodFetchToken) return;

                    currentHODs = Array.isArray(hods) ? hods : [];
                    $select.empty().append('<option value="">-- Select HOD --</option>');

                    var selectedId = '';
                    if (currentVal && currentHODs.some(function(h) { return h.id === currentVal; })) {
                        selectedId = currentVal;
                    } else if (preferredId && currentHODs.some(function(h) { return h.id === preferredId; })) {
                        selectedId = preferredId;
                    } else if (preferredEmail) {
                        var preferred = currentHODs.find(function(h) {
                            return h.email && h.email.toLowerCase() === preferredEmail.toLowerCase();
                        });
                        selectedId = preferred ? preferred.id : '';
                    }

                    currentHODs.forEach(function(h) {
                        var isSelected = h.id === selectedId;
                        var option = new Option(h.fullName, h.id, isSelected, isSelected);
                        $select.append(option);
                    });

                    $select.prop('disabled', currentHODs.length === 0);
                    $select.trigger('change.select2');
                    updateSelectedHodEmail();
                })
                .catch(function() {
                    if (requestToken !== hodFetchToken) return;
                    currentHODs = [];
                    $select.empty().append('<option value="">-- Select HOD --</option>');
                    $select.prop('disabled', true);
                    $select.trigger('change.select2');
                    updateSelectedHodEmail();
                });
        }

        $(document).ready(function() {
            $('#' + employeeSelectId).select2({
                theme: 'bootstrap-5',
                width: '100%',
                placeholder: '-- Choose Employee to Offboard --'
            });

            $('#' + assignedHodSelectId).select2({
                theme: 'bootstrap-5',
                width: '100%',
                placeholder: '-- Select HOD --'
            });

            $('#' + assignedHodSelectId).on('change', function() {
                updateSelectedHodEmail();
            });

            $('#' + employeeSelectId).on('change', function () {
                var onboardingId = this.value;
                if (onboardingId) {
                    fetch('/Offboarding/GetEmployeeDetails/' + onboardingId)
                        .then(function(response) { return response.json(); })
                        .then(function(data) {
                            if (data) {
                                document.getElementById('FullName').value = data.fullName || '';
                                document.getElementById('EmployeeID').value = data.employeeID || '';
                                document.getElementById('Department').value = data.department || '';
                                document.getElementById(branchInputId).value = data.branch || '';
                                loadHODsByCompany(data.branch, data.hodEmail, '');
                            }
                        })
                        .catch(function(error) { console.error('Error fetching employee details:', error); });
                } else {
                    document.getElementById('FullName').value = '';
                    document.getElementById('EmployeeID').value = '';
                    document.getElementById('Department').value = '';
                    document.getElementById(branchInputId).value = '';
                    loadHODsByCompany('', '', '');
                }
            });

            var existingEmployeeId = document.getElementById(employeeSelectId).value;
            if (existingEmployeeId) {
                $('#' + employeeSelectId).trigger('change');
            } else {
                var existingBranch = document.getElementById(branchInputId).value;
                var existingHodId = document.getElementById(assignedHodSelectId).value;
                var existingHodEmail = document.getElementById('HODEmailHidden').value;
                loadHODsByCompany(existingBranch, existingHodEmail, existingHodId);
            }
        });
    </script>
    <style>
        .select2-container--bootstrap-5 .select2-selection {
            border: 1px solid #ced4da;
            min-height: 38px;
            padding: 0.375rem 0.75rem;
        }
    </style>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}



@model IT_Form.ViewModels.OffboardingDetailsPageViewModel
@using IT_Form.Models.Enums

@{
    ViewData["Title"] = "Offboarding Details";
    bool isITUser = User.HasClaim("UserTitle", "IT");
    bool isHRUser = User.HasClaim("UserTitle", "HR");
    bool isManagerUser = User.HasClaim("UserTitle", "Manager") || User.HasClaim("UserTitle", "HOD");
    var managerEmails = Model.MyManagerEmails;
    var currentUserId = Model.CurrentUserId;
    
    // Authorization: HOD matches if AssignedHodId matches current user ID, 
    // OR if AssignedHodId is null and the current user's email matches the form's HODEmail (legacy)
    bool isAssignedManager = isManagerUser && (
        (Model.AssignedHodId != null && Model.AssignedHodId == currentUserId) ||
        (Model.AssignedHodId == null && managerEmails.Contains(Model.HODEmail ?? ""))
    );
    bool hasHRSig = !string.IsNullOrEmpty(Model.HRSignature);
    bool hasManagerSig = !string.IsNullOrEmpty(Model.HODSignature);
    bool hasITSig = !string.IsNullOrEmpty(Model.ITAdminSignature);

    var detailBadgeClass = Model.Status switch
    {
        RequestStatus.Completed => "badge-completed",
        RequestStatus.PendingEmployeeSign => "badge-employeesign",
        RequestStatus.Draft => "badge-draft",
        RequestStatus.PendingITApproval => "badge-pending",
        RequestStatus.PendingHODApproval => "badge-hod",
        RequestStatus.PendingApproval => "badge-hod",
        RequestStatus.Rejected => "badge-rejected",
        _ => "badge-pending"
    };
}

<div class="details-hero animate-in mt-3 mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            @if (!string.IsNullOrEmpty(Model.CompanyLogoPath))
            {
                <div class="flex-shrink-0">
                    <img src="/@Model.CompanyLogoPath" alt="Company Logo" style="height: 32px; object-fit: contain;" />
                </div>
            }
            <h2 class="fw-bolder mb-0 fs-4">
                <span class="text-gradient">@Model.FullName</span>
                <span class="badge @detailBadgeClass ms-2 fs-6" style="vertical-align: middle;">
                    @(Model.Status == RequestStatus.PendingITApproval ? "Pending IT Approval" : 
                      (Model.Status == RequestStatus.PendingHODApproval || Model.Status == RequestStatus.PendingApproval) ? "Awaiting HOD Approval" : 
                      Model.Status.ToString())
                </span>
            </h2>
        </div>

        <div class="details-action-bar ms-auto d-flex gap-2">
            <a asp-action="GeneratePdf" asp-route-id="@Model.Id" class="btn details-action details-action--pdf">
                <span class="details-action__icon">
                    <i class="fas fa-file-pdf"></i>
                </span>
                <span>Download PDF</span>
            </a>

            @if (Model.Status != RequestStatus.Completed && Model.Status != RequestStatus.PendingEmployeeSign && isITUser)
            {
                <a asp-action="ITSetup" asp-route-id="@Model.Id" class="btn details-action details-action--primary">
                    <span class="details-action__icon">
                        <i class="fas fa-laptop-code"></i>
                    </span>
                    <span>IT Setup</span>
                </a>
            }

            @if (isHRUser && hasHRSig && !hasManagerSig && !hasITSig)
            {
                <button type="button" class="btn details-action details-action--danger" data-bs-toggle="modal" data-bs-target="#deleteFormModal">
                    <span class="details-action__icon">
                        <i class="bi bi-trash"></i>
                    </span>
                    <span>Delete Form</span>
                </button>
            }

            @if (Model.Status == RequestStatus.Rejected)
            {
                <a asp-controller="Notification" asp-action="ComposeRejectionEmail" asp-route-id="@Model.Id" asp-route-type="Offboarding" class="btn details-action details-action--danger">
                    <span class="details-action__icon">
                        <i class="fas fa-envelope-open-text"></i>
                    </span>
                    <span>Send Rejection Email</span>
                </a>
            }
            else
            {
                <a asp-controller="Notification" asp-action="ComposeOffboardingEmail" asp-route-id="@Model.Id" class="btn details-action details-action--success">
                    <span class="details-action__icon">
                        <i class="fas fa-envelope-open-text"></i>
                    </span>
                    <span>Open in Outlook</span>
                </a>
            }

            <a asp-action="Index" class="btn details-action details-action--neutral">
                <span class="details-action__icon">
                    <i class="fas fa-arrow-left"></i>
                </span>
                <span>Back</span>
            </a>
        </div>
    </div>

    <div class="mt-2 d-flex align-items-center gap-4">
        <p class="text-muted mb-0 small"><strong>Req #@Model.Id</strong></p>
        @if (Model.Status != RequestStatus.Completed && Model.Status != RequestStatus.Rejected && Model.Status != RequestStatus.Approved)
        {
            var deadline = Model.SlaDeadline;
            if (deadline != default)
            {
                var isOverdue = DateTime.UtcNow > deadline;
                <p class="mb-0 small @(isOverdue ? "text-danger fw-bold" : "text-primary")">
                    <i class="bi bi-clock-history me-1"></i>Due: @deadline.AddHours(8).ToString("dd/MM/yyyy HH:mm")
                    @if (isOverdue)
                    {
                        <span class="badge bg-danger ms-1" style="font-size: 0.6rem;">Overdue</span>
                    }
                </p>
            }
        }
        <p class="mb-0 small fw-bold" style="color: #d9534f;">
            <i class="bi bi-calendar-event me-1"></i>Last Day: @Model.LastDayOfWork.ToString("dd/MM/yyyy")
        </p>
    </div>
</div>

@if (Model.Status == IT_Form.Models.Enums.RequestStatus.Rejected)
{
                                    <div class="rejection-banner animate-in">
                                        <div class="d-flex align-items-start gap-3">
                                            <i class="bi bi-x-circle-fill text-danger fs-3" aria-hidden="true"></i>
                                            <div>
                                                <h5 class="text-danger mb-1 fw-bold">Request Rejected</h5>
                                                <p class="mb-0" style="color: var(--text-primary);">
                                                    <strong>Reason:</strong> @Model.RejectionReason
                                                </p>
                @if (!string.IsNullOrEmpty(Model.RejectedByUserId))
                {
                                                                                    <small style="color: var(--text-muted);">Rejected by @Model.RejectedByUserId</small>
                }
                                            </div>
                                        </div>
                                    </div>
}

<div class="row g-4">
    <!-- Employee Info -->
    <div class="col-lg-4">
        <div class="card animate-in h-100">
            <div class="card-header">
                <i class="bi bi-person-badge me-2" style="color: var(--primary-light);" aria-hidden="true"></i>Employee Details
            </div>
            <div class="card-body">
                <table class="table table-sm mb-0" style="border: none;">
                    <tr>
                        <td style="color: var(--text-muted); width: 40%;">ID / IC</td>
                        <td><strong>@(Model.EmployeeID ?? "-")</strong></td>
                    </tr>
                    <tr>
                        <td style="color: var(--text-muted);">Department</td>
                        <td>
                            <strong>@Model.Department</strong>
                            @if (Model.Department == "Others" && !string.IsNullOrEmpty(Model.OtherDepartmentDetails))
                            {
                                <span class="text-info small">(@Model.OtherDepartmentDetails)</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td style="color: var(--text-muted);">Company</td>
                        <td>
                            <strong>@(Model.Branch ?? "-")</strong>
                            @if (Model.Branch == "Others" && !string.IsNullOrEmpty(Model.OtherBranchDetails))
                            {
                                <span class="text-info small">(@Model.OtherBranchDetails)</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td style="color: var(--text-muted);">Email</td>
                        <td>@(Model.EmailAddress ?? Model.OnboardingRequest?.EmailAddress ?? "-")</td>
                    </tr>
                    <tr>
                        <td style="color: var(--text-muted);">Manager</td>
                        <td>@Model.ManagerDisplayName</td>
                    </tr>
                    <tr>
                        <td style="color: var(--text-muted);">Last Day</td>
                        <td class="text-danger fw-bold">@Model.LastDayOfWork.ToString("dd/MM/yyyy")</td>
                    </tr>
                    @if (Model.OnboardingRequestId.HasValue)
                    {
                                                <tr>
                                                    <td style="color: var(--text-muted);">Onboarding</td>
                                                    <td>
                                                        <a asp-controller="Onboarding" asp-action="Details" asp-route-id="@Model.OnboardingRequestId" class="btn btn-sm btn-outline-info p-0 px-2">Req #@Model.OnboardingRequestId</a>
                                                    </td>
                                                </tr>
                    }
                </table>

                @if (!string.IsNullOrEmpty(Model.ResignationLetterPath) && !isITUser)
                {
                                                <div class="mt-4 border-top pt-3">
                                                    <h6 class="text-muted small fw-bold mb-2"><i class="fas fa-file-pdf me-2 text-danger" aria-hidden="true"></i>Resignation Letter</h6>
                                                    <a href="@Model.ResignationLetterPath" target="_blank" class="btn btn-outline-danger btn-sm w-100">
                                                        <i class="fas fa-download me-2" aria-hidden="true"></i>View / Download Letter
                                                    </a>
                                                </div>
                }
            </div>
        </div>
    </div>

    <!-- IT Access & Accounts Checklist (IT Admin Only) -->
    @if (isITUser)
    {
                        <div class="col-lg-4">
                            <div class="card animate-in h-100" style="animation-delay: 0.1s;">
                                <div class="card-header">
                                    <i class="bi bi-person-x me-2" style="color: var(--primary-light);" aria-hidden="true"></i>Accounts & Access
                                </div>
                                <div class="card-body">
                                    <!-- Contextual Info Display -->
                    @if (Model.OnboardingRequest != null)
                    {
                                                                    <div class="alert alert-secondary py-2 small mb-3 border-0 shadow-sm" style="background: var(--bg-body);">
                                                                        <strong><i class="fas fa-info-circle me-1 text-primary" aria-hidden="true"></i> Assigned Software & Access:</strong>
                                                                        <ul class="mb-0 mt-1 ps-3 text-muted">
                                @if (Model.OnboardingRequest.MailboxAccount)
                                {
                                                                                                    <li>M365 License</li>
                                }
                                @if (Model.OnboardingRequest.HasAdobe)
                                {
                                                                                                    <li>Adobe</li>
                                }
                                @if (Model.OnboardingRequest.HasMSProject)
                                {
                                                                                                    <li>MS Project</li>
                                }
                                @if (Model.OnboardingRequest.HasAutoDesk)
                                {
                                                                                                    <li>AutoDesk</li>
                                }
                                @if (Model.OnboardingRequest.HasGStarCAD)
                                {
                                                                                                    <li>G-Star CAD</li>
                                }
                                @if (Model.OnboardingRequest.HasFortiClientVPN)
                                {
                                                                                                    <li>FortiClient VPN</li>
                                }
                                @if (Model.OnboardingRequest.HasSQLAccounting)
                                {
                                                                                                    <li>SQL Accounting</li>
                                }
                                @if (Model.OnboardingRequest.HasMSVisio)
                                {
                                                                                                    <li>MS Visio</li>
                                }
                                @if (Model.OnboardingRequest.HasAutoCAD)
                                {
                                                                                                    <li>AutoCAD</li>
                                }
                                @if (Model.OnboardingRequest.HasSketchUp)
                                {
                                                                                                    <li>SketchUp</li>
                                }
                                @if (Model.OnboardingRequest.HasMSOffice) { <li>MS Office</li> }
                                @if (Model.OnboardingRequest.HasGoogleChrome) { <li>Google Chrome</li> }
                                @if (Model.OnboardingRequest.HasMSTeams) { <li>MS Teams</li> }
                                @if (Model.OnboardingRequest.HasAntivirus) { <li>Antivirus Endpoint</li> }
                                @if (Model.OnboardingRequest.HasDWGTrueView) { <li>DWG TrueView</li> }
                                @if (Model.OnboardingRequest.HasIFlexiHRMS) { <li>i-Flexi HRMS</li> }
                                @if (Model.OnboardingRequest.HasEShare) { <li>EShare</li> }
                                @if (Model.OnboardingRequest.HasOS) { <li>Operating System</li> }
                                @if (Model.OnboardingRequest.HasOtherSoftware && !string.IsNullOrEmpty(Model.OnboardingRequest.OtherSoftwareDetails))
                                {
                                                                                                            <li>Other: @Model.OnboardingRequest.OtherSoftwareDetails</li>
                                }
                                @if (Model.OnboardingRequest.PrecastGroup || Model.OnboardingRequest.OtherGroup || Model.OnboardingRequest.MailboxLogistic || Model.OnboardingRequest.MailboxInfo || Model.OnboardingRequest.MailboxAdmin || Model.OnboardingRequest.MailboxIntern || Model.OnboardingRequest.MailboxIT || Model.OnboardingRequest.MailboxSupervisor || Model.OnboardingRequest.MailboxStore)
                                {
                                                                                                            <li>Email Groups: 
                                                                                                                @if (Model.OnboardingRequest.PrecastGroup) { <span class="badge bg-light text-dark border me-1">Precast</span> }
                                                                                                                @if (Model.OnboardingRequest.MailboxLogistic) { <span class="badge bg-light text-dark border me-1">Logistic</span> }
                                                                                                                @if (Model.OnboardingRequest.MailboxInfo) { <span class="badge bg-light text-dark border me-1">Info</span> }
                                                                                                                @if (Model.OnboardingRequest.MailboxAdmin) { <span class="badge bg-light text-dark border me-1">Admin</span> }
                                                                                                                @if (Model.OnboardingRequest.MailboxIntern) { <span class="badge bg-light text-dark border me-1">Intern</span> }
                                                                                                                @if (Model.OnboardingRequest.MailboxIT) { <span class="badge bg-light text-dark border me-1">IT</span> }
                                                                                                                @if (Model.OnboardingRequest.MailboxSupervisor) { <span class="badge bg-light text-dark border me-1">Supervisor</span> }
                                                                                                                @if (Model.OnboardingRequest.MailboxStore) { <span class="badge bg-light text-dark border me-1">Store</span> }
                                                                                                                @if (Model.OnboardingRequest.OtherGroup) { <span class="text-primary italic">@Model.OnboardingRequest.OtherGroupDetails</span> }
                                                                                                            </li>
                                }
                                @if (Model.OnboardingRequest.FolderPermissions.Any() || Model.OnboardingRequest.HasOtherFolder)
                                {
                                    var folderList = Model.OnboardingRequest.FolderPermissions.Select(f => f.FolderName).ToList();
                                    if (Model.OnboardingRequest.HasOtherFolder && !string.IsNullOrEmpty(Model.OnboardingRequest.OtherFolderDetails))
                                        folderList.Add($"Other: {Model.OnboardingRequest.OtherFolderDetails}");
                                                                                                            <li>Folders: @string.Join(", ", folderList)</li>
                                }
                                                                        </ul>
                                                                    </div>
                    }

                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            Active Directory Disabled
                            @if (Model.AccountDisabledAD)
                            {
                                                                                <i class="bi bi-check-square-fill text-success fs-4" aria-hidden="true"></i>
                            }
                            else
                            {
                                                                                <i class="bi bi-square fs-4 text-muted" aria-hidden="true"></i>
                            }
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            M365 License Revoked
                            @if (Model.M365LicenseRevoked)
                            {
                                                                                <i class="bi bi-check-square-fill text-success fs-4" aria-hidden="true"></i>
                            }
                            else
                            {
                                                                                <i class="bi bi-square fs-4 text-muted" aria-hidden="true"></i>
                            }
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            Software Licenses Revoked
                            @if (Model.SoftwareLicensesRevoked)
                            {
                                                                                <i class="bi bi-check-square-fill text-success fs-4" aria-hidden="true"></i>
                            }
                            else
                            {
                                                                                <i class="bi bi-square fs-4 text-muted" aria-hidden="true"></i>
                            }
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            Email Auto-Forwarded
                            @if (Model.EmailForwarded)
                            {
                                                                                <i class="bi bi-check-square-fill text-success fs-4" aria-hidden="true"></i>
                            }
                            else
                            {
                                                                                <i class="bi bi-square fs-4 text-muted" aria-hidden="true"></i>
                            }
                                        </li>
                                    </ul>
                    @if (Model.EmailForwarded && !string.IsNullOrEmpty(Model.ForwardToEmail))
                    {
                                                                            <div class="alert alert-info py-2 mt-2 mb-0">
                                                                                <small><strong>Forward to:</strong> @Model.ForwardToEmail</small>
                                                                            </div>
                    }
                                </div>
                            </div>
                        </div>

                        <!-- Hardware Return Checklist (IT Admin Only) -->
                        <div class="col-lg-4">
                            <div class="card animate-in h-100" style="animation-delay: 0.2s;">
                                <div class="card-header">
                                    <i class="bi bi-laptop me-2" style="color: var(--primary-light);" aria-hidden="true"></i>Hardware Return
                                </div>
                                <div class="card-body">
                                    <!-- Contextual Info Display -->
                    @if (Model.OnboardingRequest != null && Model.OnboardingRequest.IssuedAssets.Any())
                    {
                                                                    <div class="alert alert-secondary py-2 small mb-3 border-0 shadow-sm" style="background: var(--bg-body);">
                                                                        <strong><i class="fas fa-desktop me-1 text-info" aria-hidden="true"></i> Specifically Assigned Hardware:</strong>
                                                                        <ul class="mb-0 mt-1 ps-3 text-muted">
                                @foreach (var asset in Model.OnboardingRequest.IssuedAssets)
                                {
                                                                                                            var isReturned = asset.ITAsset != null && asset.ITAsset.Status != IT_Form.Models.Enums.AssetStatus.Issued;
                                                                                                            <li>
                                                                                                                @asset.AssetType.ToString() - @(asset.AssetTag ?? "No Tag") <span class="text-secondary" style="font-size: 0.8rem;">(@(asset.Description ?? "N/A"))</span>
                                                                                                                @if(isReturned) { <span class="badge bg-success ms-1">Returned</span> }
                                                                                                            </li>
                                }
                                                                        </ul>
                                                                    </div>
                    }
                    else if (Model.OnboardingRequest != null)
                    {
                                                                    <div class="alert alert-secondary py-2 small mb-3 border-0 shadow-sm text-muted fst-italic" style="background: var(--bg-body);">
                                                                        No specific hardware linked during Onboarding.
                                                                    </div>
                    }

                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            Laptop / PC Returned
                            @if (Model.LaptopReturned)
                            {
                                                                                <i class="bi bi-check-square-fill text-success fs-4" aria-hidden="true"></i>
                            }
                            else
                            {
                                                                                <i class="bi bi-square fs-4 text-muted" aria-hidden="true"></i>
                            }
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            Accessories Returned
                            @if (Model.AccessoriesReturned)
                            {
                                                                                <i class="bi bi-check-square-fill text-success fs-4" aria-hidden="true"></i>
                            }
                            else
                            {
                                                                                <i class="bi bi-square fs-4 text-muted" aria-hidden="true"></i>
                            }
                                        </li>
                                    </ul>
                    @if (!string.IsNullOrEmpty(Model.HardwareNotes))
                    {
                                                                            <div class="mt-3">
                                                                                <strong>Notes:</strong>
                                                                                <p class="text-muted small mb-0">@Model.HardwareNotes</p>
                                                                            </div>
                    }
                    @if (Model.IsHardwareDamaged)
                    {
                        @if (Model.MissingItemFines.HasValue && Model.MissingItemFines.Value > 0)
                        {
                                                                                <div class="alert alert-warning py-2 mt-3 mb-0 shadow-sm border-0">
                                                                                    <strong>Fine Applied: </strong> RM @Model.MissingItemFines.Value.ToString("0.00")
                                @if (!string.IsNullOrEmpty(Model.FinesRemarks))
                                {
                                                                                            <br />
                                                                                            <small class="text-muted">@Model.FinesRemarks</small>
                                }
                                                                                </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.HardwareDamageImagePath))
                        {
                                                                                <div class="mt-3">
                                                                                    <strong>Damage Image:</strong>
                                                                                    <div class="mt-1">
                                                                                        <a href="@Model.HardwareDamageImagePath" target="_blank">
                                                                                            <img src="@Model.HardwareDamageImagePath" class="img-thumbnail" style="max-height: 150px;" alt="Hardware Damage Image" />
                                                                                        </a>
                                                                                    </div>
                                                                                </div>
                        }
                    }
                                </div>
                            </div>
                        </div>
    }
</div>

<!-- Assets to Return -->
@if (Model.OnboardingRequest != null && Model.OnboardingRequest.IssuedAssets != null && Model.OnboardingRequest.IssuedAssets.Any())
{
    <div class="card animate-in mt-4">
        <div class="card-header d-flex align-items-center justify-content-between">
            <span><i class="fas fa-laptop me-2" style="color: var(--primary-light);" aria-hidden="true"></i>IT Assets to Return</span>
            <span class="badge bg-warning text-dark">@Model.OnboardingRequest.IssuedAssets.Count Item(s)</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th style="width: 5%;">#</th>
                            <th style="width: 15%;">Asset Type</th>
                            <th style="width: 20%;">Asset Tag</th>
                            <th style="width: 20%;">Brand / Model</th>
                            <th style="width: 20%;">Serial Number</th>
                            <th style="width: 20%; text-align: center;">Return Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.OnboardingRequest.IssuedAssets.Count; i++)
                        {
                            var ia = Model.OnboardingRequest.IssuedAssets[i];
                            bool isReturnedAsset = ia.ITAsset != null && ia.ITAsset.Status == IT_Form.Models.Enums.AssetStatus.Available;
                            <tr>
                                <td>@(i + 1)</td>
                                <td><span class="badge bg-secondary">@ia.AssetType</span></td>
                                <td><strong>@(ia.AssetTag ?? ia.ITAsset?.AssetTag ?? "—")</strong></td>
                                <td>@(ia.BrandModel ?? ia.ITAsset?.Model ?? "—")</td>
                                <td><code>@(ia.SerialNumber ?? ia.ITAsset?.SerialNumber ?? "—")</code></td>
                                <td class="text-center">
                                    @if (isReturnedAsset)
                                    {
                                        <span class="badge bg-success"><i class="fas fa-check me-1" aria-hidden="true"></i>Returned</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="fas fa-clock me-1" aria-hidden="true"></i>Pending Return</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Software Licenses to Revoke -->
@if (Model.OnboardingRequest != null && Model.OnboardingRequest.IssuedSoftware != null && Model.OnboardingRequest.IssuedSoftware.Any())
{
    <div class="card animate-in mt-4">
        <div class="card-header d-flex align-items-center justify-content-between">
            <span><i class="fas fa-key me-2" style="color: var(--primary-light);" aria-hidden="true"></i>Software Licenses to Revoke</span>
            <span class="badge bg-danger">@Model.OnboardingRequest.IssuedSoftware.Count License(s)</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th style="width: 5%;">#</th>
                            <th>Software Name</th>
                            <th style="width: 20%; text-align: center;">Revoke Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.OnboardingRequest.IssuedSoftware.Count; i++)
                        {
                            var sw = Model.OnboardingRequest.IssuedSoftware[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>
                                    <i class="fas fa-cube me-2 text-muted" aria-hidden="true"></i>
                                    <strong>@sw.SoftwareName</strong>
                                </td>
                                <td class="text-center">
                                    @if (Model.SoftwareLicensesRevoked)
                                    {
                                        <span class="badge bg-success"><i class="fas fa-check me-1" aria-hidden="true"></i>Revoked</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1" aria-hidden="true"></i>Pending Revoke</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}


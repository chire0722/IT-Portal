@model IT_Form.Application.Features.SharedMailbox.SharedMailboxMembersPageViewModel
@{
    ViewData["Title"] = $"Members - {Model.MailboxName}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">Shared Mailboxes</a></li>
                <li class="breadcrumb-item active">Members</li>
            </ol>
        </nav>
        <h2 class="h4 mb-0 fw-bold">
            <i class="bi bi-people me-2 text-primary"></i>Members: @Model.MailboxName
        </h2>
        <p class="text-muted mb-0 small">@Model.MailboxAddress</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success py-2">@TempData["SuccessMessage"]</div>
}
@if (TempData["InfoMessage"] != null)
{
    <div class="alert alert-info py-2">@TempData["InfoMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger py-2">@TempData["ErrorMessage"]</div>
}

<div class="card shadow-sm border-0 mb-3">
    <div class="card-body">
        <h6 class="fw-bold mb-2">Add Current Employee to This Mailbox</h6>
        <form asp-action="AddCurrentEmployee" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.MailboxId" />
            <div class="col-md-8">
                <label class="form-label mb-1">Employee</label>
                <select name="onboardingRequestId" class="form-select" required>
                    <option value="">Select employee...</option>
                    @foreach (var employee in Model.CurrentEmployees)
                    {
                        if (Model.CurrentEmployeeId == employee.Id)
                        {
                            <option value="@employee.Id" selected="selected">@employee.Label</option>
                        }
                        else
                        {
                            <option value="@employee.Id">@employee.Label</option>
                        }
                    }
                </select>
                @if (!string.IsNullOrWhiteSpace(Model.CurrentEmployeeDisplayName))
                {
                    <div class="small text-muted mt-1">
                        Current context: @Model.CurrentEmployeeDisplayName
                    </div>
                }
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-person-plus me-1"></i>Add Access
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Employee Name</th>
                        <th>Department</th>
                        <th>Request Type</th>
                        <th>Request Date</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Members)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold">@item.EmployeeName</td>
                            <td>@item.Department</td>
                            <td>
                                <span class="badge bg-info bg-opacity-10 text-info">@item.RequestType</span>
                            </td>
                            <td class="text-muted small">@(item.RequestDate?.ToString("dd/MM/yyyy HH:mm"))</td>
                            <td>
                                @{
                                    var badgeClass = item.Status switch
                                    {
                                        IT_Form.Models.Enums.RequestStatus.Completed => "bg-success",
                                        IT_Form.Models.Enums.RequestStatus.Approved => "bg-primary",
                                        IT_Form.Models.Enums.RequestStatus.Rejected => "bg-danger",
                                        _ => "bg-warning text-dark"
                                    };
                                }
                                <span class="badge @badgeClass">@item.Status</span>
                            </td>
                            <td class="text-end pe-3">
                                <a href="/@item.ControllerName/Details/@item.RequestId" class="btn btn-sm btn-light border" title="View Request">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Members.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="bi bi-people display-6 d-block mb-2 opacity-25"></i>
                                No employees found for this mailbox yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

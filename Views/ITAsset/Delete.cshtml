@* Project comment: Delete.cshtml renders part of the IT Form web user interface. *@

@model IT_Form.Models.ITAsset

@{
    ViewData["Title"] = "Delete IT Asset";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>Delete Conformation</h4>
            </div>
            <div class="card-body">
                <h5 class="card-title text-center mb-4">Are you sure you want to delete this asset?</h5>

                <div class="bg-light p-3 rounded mb-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Asset Tag:</dt>
                        <dd class="col-sm-8 fw-bold">@Model.AssetTag</dd>

                        <dt class="col-sm-4">Type:</dt>
                        <dd class="col-sm-8">@Model.AssetType</dd>

                        <dt class="col-sm-4">Model:</dt>
                        <dd class="col-sm-8">@(Model.Model ?? "-")</dd>

                        <dt class="col-sm-4">Serial Number:</dt>
                        <dd class="col-sm-8">@(Model.SerialNumber ?? "-")</dd>
                    </dl>
                </div>

                <div class="alert alert-warning">
                    <i class="bi bi-info-circle-fill me-2" aria-hidden="true"></i> <strong>Warning!</strong> This will also delete all
                    associated maintenance logs. This action cannot be undone.
                </div>

                <div class="mb-4 text-center">
                    <label for="deleteConfirmation" class="form-label text-danger">Type <strong>DELETE</strong> below to
                        confirm:</label>
                    <input type="text" class="form-control text-center text-danger fw-bold mx-auto"
                        id="deleteConfirmation" autocomplete="off" style="max-width: 200px;" />
                </div>

                <form asp-action="Delete" class="d-flex justify-content-between">
                    <input type="hidden" asp-for="Id" />
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-danger" id="btnConfirmDelete" disabled>Yes, Delete
                        Asset</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const deleteInput = document.getElementById('deleteConfirmation');
            const deleteBtn = document.getElementById('btnConfirmDelete');

            deleteInput.addEventListener('input', function () {
                if (this.value === 'DELETE') {
                    deleteBtn.disabled = false;
                } else {
                    deleteBtn.disabled = true;
                }
            });
            deleteInput.focus();
        });
    </script>
}



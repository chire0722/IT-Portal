@* Project comment: _PendingQueues.cshtml renders part of the IT Form web user interface. *@

@model IT_Form.Models.DashboardViewModel

@{
    var isIT = User.HasClaim("UserTitle", "IT");
    var isHR = User.HasClaim("UserTitle", "HR");
    var showOnboarding = (isIT || isHR) && Model.PendingOnboarding.Any();
    var showOffboarding = Model.PendingOffboarding.Any();
    var showEmptyState = ViewData["ShowEmptyState"] as bool? ?? true;
}

<!-- Pending Queues (Visible to everyone) -->
<h5 class="fw-bold mb-3"><i class="fas fa-tasks text-muted me-2" aria-hidden="true"></i>Needs Your Attention</h5>

@if (!showOnboarding && !showOffboarding && showEmptyState)
{
    <div class="empty-state-glass text-center" style="padding: 4rem 2rem;">
        <div class="empty-icon text-success mb-3">
            <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                <i class="bi bi-check2-all" style="font-size: 3rem;" aria-hidden="true"></i>
            </div>
        </div>
        <h4 class="fw-bold">You're all caught up!</h4>
        <p class="text-muted mb-0">There are no pending requests requiring your signature right now. Enjoy your day!</p>
    </div>
}
else
{
    <div class="row g-4 mb-5">
        <!-- Onboarding Queue (IT & HR Only) -->
        @if (showOnboarding)
        {
            <div class="@(showOffboarding ? "col-md-6" : "col-12")">
                <div class="card queue-card border-0 shadow-sm h-100" style="border-top: 4px solid var(--success) !important;">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3 border-light">
                        <h6 class="mb-0 fw-bold"><i class="bi bi-person-plus text-success me-2" aria-hidden="true"></i>Pending Onboarding</h6>
                        <div>
                            @if (Model.OverdueOnboardingCount > 0)
                            {
                                <span class="badge bg-danger rounded-pill px-3 py-2 shadow-sm me-2" title="Overdue"><i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>@Model.OverdueOnboardingCount Overdue</span>
                            }
                            <span class="badge bg-success rounded-pill px-3 py-2 shadow-sm">@Model.PendingOnboarding.Count()</span>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush" style="max-height: 400px; overflow-y: auto;">
                            @foreach (var req in Model.PendingOnboarding)
                            {
                                <a asp-controller="Onboarding" asp-action="Details" asp-route-id="@req.Id"
                                   class="list-group-item list-group-item-action queue-item p-4 border-bottom border-light">
                                    <div class="d-flex w-100 justify-content-between align-items-center mb-2">
                                        <h6 class="mb-0 fw-bold text-dark">@req.FullName</h6>
                                        <small class="badge bg-light text-muted border"><i class="bi bi-clock me-1" aria-hidden="true"></i>@req.RequestDate.ToString("dd MMM yyyy")</small>
                                    </div>
                                    <div class="mb-2 small" style="color: #64748b;">
                                        <strong>Dept:</strong> @req.Department &bull;
                                        <strong>Role:</strong> @(req.Designation ?? "N/A")
                                    </div>
                                    <div class="mt-3">
                                        @{
                                            var onStatus = req.Status;
                                            var onBadgeClass = onStatus switch
                                            {
                                                IT_Form.Models.Enums.RequestStatus.PendingHRApproval => "badge-hod", // Orange-ish
                                                IT_Form.Models.Enums.RequestStatus.PendingITApproval => "badge-pending", // Blue-ish
                                                IT_Form.Models.Enums.RequestStatus.PendingEmployeeSign => "badge-info", // Teal-ish
                                                IT_Form.Models.Enums.RequestStatus.Draft => "badge-draft",
                                                _ => "badge-draft"
                                            };
                                            var onBadgeText = onStatus switch
                                            {
                                                IT_Form.Models.Enums.RequestStatus.PendingHRApproval => "Awaiting HR Setup",
                                                IT_Form.Models.Enums.RequestStatus.PendingITApproval => "Pending IT Setup",
                                                IT_Form.Models.Enums.RequestStatus.PendingEmployeeSign => "Awaiting Signature",
                                                IT_Form.Models.Enums.RequestStatus.Draft => "Draft",
                                                _ => onStatus.ToString()
                                            };
                                        }
                                        <span class="@onBadgeClass">@onBadgeText</span>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Offboarding Queue -->
        @if (showOffboarding)
        {
            <div class="@(showOnboarding ? "col-md-6" : "col-12")">
                <div class="card queue-card border-0 shadow-sm h-100" style="border-top: 4px solid var(--danger) !important;">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3 border-light">
                        <h6 class="mb-0 fw-bold"><i class="bi bi-person-dash text-danger me-2" aria-hidden="true"></i>Pending Offboarding</h6>
                        <div>
                            @if (Model.OverdueOffboardingCount > 0)
                            {
                                <span class="badge bg-danger rounded-pill px-3 py-2 shadow-sm me-2" title="Overdue"><i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>@Model.OverdueOffboardingCount Overdue</span>
                            }
                            <span class="badge bg-danger rounded-pill px-3 py-2 shadow-sm">@Model.PendingOffboarding.Count()</span>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush" style="max-height: 400px; overflow-y: auto;">
                            @foreach (var req in Model.PendingOffboarding)
                            {
                                <a asp-controller="Offboarding" asp-action="Details" asp-route-id="@req.Id"
                                   class="list-group-item list-group-item-action queue-item p-4 border-bottom border-light">
                                    <div class="d-flex w-100 justify-content-between align-items-center mb-2">
                                        <h6 class="mb-0 fw-bold text-dark">@req.FullName</h6>
                                        <small class="badge border border-danger text-danger bg-danger bg-opacity-10 fw-bold"><i class="bi bi-calendar-x me-1" aria-hidden="true"></i>Last Day: @req.LastDayOfWork.ToString("dd MMM yyyy")</small>
                                    </div>
                                    <div class="mb-2 small" style="color: #64748b;">
                                        <strong>Dept:</strong> @req.Department
                                    </div>
                                    <div class="mt-3">
                                        @{
                                            var offStatus = req.Status;
                                            var offBadgeClass = offStatus switch
                                            {
                                                IT_Form.Models.Enums.RequestStatus.PendingApproval => "badge-hod",
                                                IT_Form.Models.Enums.RequestStatus.PendingHODApproval => "badge-hod",
                                                IT_Form.Models.Enums.RequestStatus.PendingITApproval => "badge-pending",
                                                IT_Form.Models.Enums.RequestStatus.PendingEmployeeSign => "badge-info",
                                                _ => "badge-draft"
                                            };
                                            var offBadgeText = offStatus switch
                                            {
                                                IT_Form.Models.Enums.RequestStatus.PendingApproval => "Awaiting HOD Approval",
                                                IT_Form.Models.Enums.RequestStatus.PendingHODApproval => "Awaiting HOD Approval",
                                                IT_Form.Models.Enums.RequestStatus.PendingITApproval => "Pending IT Setup",
                                                IT_Form.Models.Enums.RequestStatus.PendingEmployeeSign => "Awaiting Signature",
                                                _ => offStatus.ToString()
                                            };
                                        }
                                        <span class="@offBadgeClass">@offBadgeText</span>
                                    </div>
                                 </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Awaiting Employee Signatures Row -->
    @if (isHR || isIT)
    {
        var hasSigs = Model.PendingEmployeeSignOnboarding.Any() || Model.PendingEmployeeSignOffboarding.Any();
        @if (hasSigs)
        {
            <div class="row g-4 mb-5">
                <div class="col-12">
                    <div class="card border-0 shadow-sm" style="border-top: 4px solid var(--info) !important; border-radius: 12px;">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3 border-light">
                            <h6 class="mb-0 fw-bold"><i class="bi bi-pen text-info me-2" aria-hidden="true"></i>Awaiting Employee Signature</h6>
                            <span class="badge bg-info text-dark rounded-pill px-3 py-2 shadow-sm">@Model.PendingEmployeeSignCount</span>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Employee</th>
                                            <th>Department</th>
                                            <th>Type</th>
                                            <th>IT/HR Signed On</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var req in Model.PendingEmployeeSignOnboarding)
                                        {
                                            <tr>
                                                <td class="py-3"><strong>@req.FullName</strong></td>
                                                <td class="py-3 text-muted">@req.Department</td>
                                                <td class="py-3"><span class="badge-completed">Onboarding</span></td>
                                                <td class="py-3">@(req.CompletedAt?.ToString("dd/MM/yyyy") ?? "—")</td>
                                                <td class="py-3">
                                                    <a asp-controller="Onboarding" asp-action="Details" asp-route-id="@req.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                        <i class="bi bi-eye me-1" aria-hidden="true"></i>View
                                                    </a>
                                                    @if (isHR)
                                                    {
                                                        <a asp-controller="Notification" asp-action="ComposeEmail" asp-route-id="@req.Id" class="btn btn-sm btn-success rounded-pill px-3 ms-1">
                                                            <i class="bi bi-envelope-paper me-1" aria-hidden="true"></i>Send Link
                                                        </a>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                        @foreach (var req in Model.PendingEmployeeSignOffboarding)
                                        {
                                            <tr>
                                                <td class="py-3"><strong>@req.FullName</strong></td>
                                                <td class="py-3 text-muted">@req.Department</td>
                                                <td class="py-3"><span class="badge-rejected">Offboarding</span></td>
                                                <td class="py-3">@(req.CompletedAt?.ToString("dd/MM/yyyy") ?? "—")</td>
                                                <td class="py-3">
                                                    <a asp-controller="Offboarding" asp-action="Details" asp-route-id="@req.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                        <i class="bi bi-eye me-1" aria-hidden="true"></i>View
                                                    </a>
                                                    @if (isHR)
                                                    {
                                                        <a asp-controller="Notification" asp-action="ComposeOffboardingEmail" asp-route-id="@req.Id" class="btn btn-sm btn-success rounded-pill px-3 ms-1">
                                                            <i class="bi bi-envelope-paper me-1" aria-hidden="true"></i>Send Link
                                                        </a>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
}



@model IT_Form.Application.Features.StandardSoftware.StandardSoftwareIndexPageViewModel
@{
    ViewData["Title"] = "Software List Management";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h2 class="h4 mb-0 fw-bold"><i class="bi bi-box-seam me-2 text-primary" aria-hidden="true"></i>Software Inventory</h2>
        <p class="text-muted small mb-0">Manage your software catalog, versions, and license keys.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <button class="btn btn-sm btn-success shadow-sm rounded-pill px-3 fw-bold text-white d-inline-flex align-items-center justify-content-center gap-2" data-bs-toggle="modal" data-bs-target="#importModal">
            <i class="bi bi-upload me-1" aria-hidden="true"></i> Bulk Import
        </button>
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm px-3 d-inline-flex align-items-center justify-content-center gap-2" style="background: linear-gradient(135deg, #0d6efd, #0b5ed7);">
            <i class="bi bi-plus-circle me-1" aria-hidden="true"></i> Add Software
        </a>
    </div>
</div>

<!-- Premium Analytics Dashboard -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-5 col-lg-3">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; background: linear-gradient(135deg, #ffffff, #f8f9fa);">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-2 me-3">
                        <i class="bi bi-box-seam text-primary fs-4" aria-hidden="true"></i>
                    </div>
                    <span class="text-muted small fw-semibold">TOTAL SOFTWARE</span>
                </div>
                <h3 class="mb-0 fw-bold text-dark">@Model.TotalSoftwareCount</h3>
                <div class="text-muted small mt-1">Across @Model.TotalVersionCount versions</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-7 col-lg-3">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; background: linear-gradient(135deg, #ffffff, #f8f9fa);">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2">
                    <div class="rounded-circle bg-success bg-opacity-10 p-2 me-3">
                        <i class="bi bi-key text-success fs-4" aria-hidden="true"></i>
                    </div>
                    <span class="text-muted small fw-semibold">LICENSE CAP</span>
                </div>
                <h3 class="mb-0 fw-bold text-dark">@Model.TotalSeatCapacity</h3>
                <div class="text-muted small mt-1">@Model.TotalAssignedSeats seats assigned</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-5 col-lg-3">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; background: linear-gradient(135deg, #ffffff, #f8f9fa);">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2">
                    <div class="rounded-circle bg-info bg-opacity-10 p-2 me-3">
                        <i class="bi bi-pie-chart text-info fs-4" aria-hidden="true"></i>
                    </div>
                    <span class="text-muted small fw-semibold">UTILIZATION</span>
                </div>
                <h3 class="mb-0 fw-bold text-dark">@Model.UtilizationPercentage.ToString("F1")%</h3>
                <div class="progress mt-2" style="height: 6px;">
                    <div class="progress-bar bg-info" role="progressbar" style="width: @Model.UtilizationPercentage%"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-7 col-lg-3">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; background: linear-gradient(135deg, #ffffff, #f8f9fa);">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2">
                    <div class="rounded-circle bg-warning bg-opacity-10 p-2 me-3">
                        <i class="bi bi-clock-history text-warning fs-4" aria-hidden="true"></i>
                    </div>
                    <span class="text-muted small fw-semibold">EXPIRING SOON</span>
                </div>
                <h3 class="mb-0 fw-bold text-dark">@Model.ExpiringSoonCount</h3>
                <div class="text-muted small mt-1">Within next 30 days</div>
            </div>
        </div>
    </div>
</div>

<!-- Search and Filter Bar -->
<div class="card shadow-sm border-0 rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-12 col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search" aria-hidden="true"></i></span>
                    <input type="text" name="searchString" class="form-control border-start-0 ps-0" placeholder="Search software or version..." value="@Model.CurrentSearch" />
                </div>
            </div>
            <div class="col-6 col-md-2">
                <select name="isSubscription" class="form-select form-select-sm">
                    <option value="">-- All License Types --</option>
                    @if (Model.IsSubscription == true)
                    {
                        <option value="true" selected>Subscription (Seat-based)</option>
                    }
                    else
                    {
                        <option value="true">Subscription (Seat-based)</option>
                    }
                    @if (Model.IsSubscription == false)
                    {
                        <option value="false" selected>Perpetual (Key-based)</option>
                    }
                    else
                    {
                        <option value="false">Perpetual (Key-based)</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <select name="companyId" class="form-select form-select-sm">
                    <option value="">-- All Companies --</option>
                    @foreach (var company in Model.CompanyOptions)
                    {
                        if (Model.SelectedCompanyId == company.Id)
                        {
                            <option value="@company.Id" selected>@company.DisplayName</option>
                        }
                        else
                        {
                            <option value="@company.Id">@company.DisplayName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <button type="submit" class="btn btn-sm btn-primary w-100">Filter</button>
            </div>
            <div class="col-12 col-md-2">
                <a asp-action="Index" class="btn btn-sm btn-light w-100 border">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
    <div class="card-body p-0">
        @foreach (var item in Model.SoftwareList)
        {
            <div class="border-bottom p-4 hover-bg-light transition-all">
                <!-- Software Header -->
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <div class="bg-primary bg-opacity-10 p-2 rounded-3 text-primary d-flex align-items-center justify-content-center">
                            <i class="bi bi-box-seam fs-5" aria-hidden="true"></i>
                        </div>
                        <h5 class="mb-0 fw-bold text-dark">@item.SoftwareName</h5>
                        @if (item.IsMandatory)
                        {
                            <span class="badge bg-danger rounded-pill px-2 py-1 ms-2" style="font-size: 0.7rem;">Mandatory</span>
                        }
                        @if (item.IsFree)
                        {
                            <span class="badge bg-info rounded-pill px-2 py-1 ms-1" style="font-size: 0.7rem;">Free</span>
                        }
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1 ms-1" style="font-size: 0.7rem;">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-2 py-1 ms-1" style="font-size: 0.7rem;">Inactive</span>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        @* [Keys button removed by request] *@
                        
                        @if (item.Licenses.Any())
                        {
                            <button class="btn btn-sm btn-light border shadow-sm rounded-circle p-2" type="button" data-bs-toggle="collapse" data-bs-target="#versions_@item.Id" aria-expanded="false" aria-controls="versions_@item.Id" aria-label="Toggle versions for @item.SoftwareName">
                                <i class="bi bi-chevron-down text-dark" aria-hidden="true"></i>
                            </button>

                            <span class="text-muted small align-self-center me-2 ms-1">
                                <i class="bi bi-layers me-1" aria-hidden="true"></i> @item.Licenses.Count version(s)
                            </span>
                        }

                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-action-circle btn-outline-primary" aria-label="Edit software @item.SoftwareName" title="Edit">
                            <i class="bi bi-pencil" aria-hidden="true"></i>
                        </a>
                        <button type="button" class="btn btn-action-circle btn-outline-danger" aria-label="Delete software @item.SoftwareName" title="Delete" onclick="openDeleteSoftware(@item.Id, '@(item.SoftwareName?.Replace("'", "\\'") ?? "Unknown")')">
                            <i class="bi bi-trash" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                <!-- Software Versions -->
                <div class="ps-5 pe-2 collapse" id="versions_@item.Id">
                    @if (item.Licenses.Any())
                    {
                        <div class="list-group list-group-flush border rounded-3 overflow-hidden">
                            @foreach (var ver in item.Licenses)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center py-2 px-3 bg-light bg-opacity-50">
                                    <div class="d-flex flex-column gap-1">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-semibold text-dark">
                                                <i class="bi bi-hash text-muted me-1" aria-hidden="true"></i>@ver.SoftwareName
                                            </span>
                                            @if (ver.IsFree)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25" style="border-radius:4px;font-size:0.65rem;">
                                                    <i class="bi bi-gift me-1" aria-hidden="true"></i>Free
                                                </span>
                                            }
                                            else if (ver.IsSubscription)
                                            {
                                                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25" style="border-radius:4px;font-size:0.65rem;">
                                                    <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>Subscription
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-dark border" style="border-radius:4px;font-size:0.65rem;">Perpetual</span>
                                            }
                                        </div>
                                        <div class="d-flex align-items-center gap-3" style="font-size:0.8rem;">
                                            @if (ver.ExpiryDate.HasValue)
                                            {
                                                <span class="text-muted"><i class="bi bi-calendar3 me-1" aria-hidden="true"></i>Expires @ver.ExpiryDate.Value.ToString("dd MMM yyyy")</span>
                                            }
                                            @if (ver.Companies.Any())
                                            {
                                                <span class="text-muted"><i class="bi bi-buildings me-1" aria-hidden="true"></i>@string.Join(", ", ver.Companies)</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted"><i class="bi bi-globe2 me-1" aria-hidden="true"></i>Global</span>
                                            }
                                            @if (!string.IsNullOrEmpty(ver.VendorName))
                                            {
                                                <span class="text-muted"><i class="bi bi-shop me-1" aria-hidden="true"></i>@ver.VendorName</span>
                                            }
                                            @if (!string.IsNullOrEmpty(ver.SupportContact))
                                            {
                                                <span class="text-muted"><i class="bi bi-telephone ms-2 me-1" aria-hidden="true"></i>@ver.SupportContact</span>
                                            }
                                            @if (ver.IsFree)
                                            {
                                                <span class="text-muted fw-bold ms-2" style="color:#198754 !important;"><i class="bi bi-infinity me-1" aria-hidden="true"></i>Unlimited Seats</span>
                                            }
                                            else if (ver.ContractLimit > 0)
                                            {
                                                <span class="text-muted"><i class="bi bi-people ms-2 me-1" aria-hidden="true"></i>@ver.ContractLimit Seats</span>
                                            }
                                            @if (!string.IsNullOrEmpty(ver.Description))
                                            {
                                                <span class="text-muted fst-italic ms-3">— @ver.Description</span>
                                            }
                                        </div>
                                    </div>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!ver.IsFree)
                                            {
                                                <button class="btn btn-sm btn-outline-primary py-0 px-2" type="button"
                                                        onclick="toggleKeys(@ver.Id)" style="font-size:0.75rem;" aria-label="View license keys for @ver.SoftwareName">
                                                    <i class="bi bi-key-fill me-1" aria-hidden="true"></i>License Keys
                                                    <span class="badge bg-secondary ms-1" id="keyCount_@ver.Id">@ver.KeyCount</span>
                                                </button>
                                            }
                                            <button class="btn btn-sm btn-outline-primary py-0 px-2 edit-version-btn" type="button"
                                                    data-id="@ver.Id"
                                                    data-name="@ver.SoftwareName"
                                                    data-description="@ver.Description"
                                                    data-issub="@ver.IsSubscription.ToString().ToLower()"
                                                    data-isfree="@ver.IsFree.ToString().ToLower()"
                                                    data-expiry="@(ver.ExpiryDate?.ToString("yyyy-MM-dd") ?? "")"
                                                    data-limit="@ver.ContractLimit"
                                                    data-vendor="@ver.VendorName"
                                                    data-support="@ver.SupportContact"
                                                    data-company-ids="@string.Join(",", ver.CompanyIds)"
                                                    onclick="openEditVersionModal(this)"
                                                    style="font-size:0.75rem;" title="Edit Version Details">
                                                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" type="button" aria-label="Remove version @ver.SoftwareName"
                                                onclick="openDeleteVersion(@ver.Id, '@(ver.SoftwareName?.Replace("'", "\\'") ?? "Unknown")' )">
                                            <i class="bi bi-x" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </div>

                                <!-- AJAX-driven keys panel -->
                                <div class="collapse" id="keysPanel_@ver.Id">
                                    <div class="card-body py-2 px-3">
                                        <!-- Inline Add Key form (Moved to Top) -->
                                        @if (!ver.IsFree)
                                        {
                                            <div class="d-flex gap-2 align-items-center border-bottom pb-2 mb-2">
                                                @if (!ver.IsSubscription)
                                                {
                                                    <div class="input-group input-group-sm" style="max-width: 400px;">
                                                        <input type="text" class="form-control" id="newKey_@ver.Id"
                                                               placeholder="Enter license key..."
                                                               onkeypress="if(event.key === 'Enter'){ event.preventDefault(); addKey(@ver.Id); }">
                                                        <button class="btn btn-sm btn-success" type="button" onclick="addKey(@ver.Id)">
                                                            <i class="bi bi-plus me-1" aria-hidden="true"></i>Add Key
                                                        </button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-success" type="button" onclick="quickAllocate(@ver.Id)">
                                                        <i class="bi bi-person-plus me-1" aria-hidden="true"></i>Add Seat
                                                    </button>
                                                }
                                                <span id="addKeyMsg_@ver.Id" class="small"></span>
                                            </div>
                                        }

                                        <!-- Keys table will be populated by JS -->
                                        <div id="keysContainer_@ver.Id">
                                            <div class="text-center py-2">
                                                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                                <span class="text-muted small ms-1">Loading keys...</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-2">No versions added yet.</p>
                    }

                    <!-- Add Version Toggle -->
                    <div class="mt-3 mb-2 px-3 text-end" id="addVersionToggle_@item.Id">
                        <button class="btn btn-sm btn-outline-primary shadow-sm" type="button" data-bs-toggle="collapse" data-bs-target="#addVersionForm_@item.Id" aria-expanded="false" aria-controls="addVersionForm_@item.Id">
                            <i class="bi bi-plus-circle me-1" aria-hidden="true"></i> Add New Version
                        </button>
                    </div>

                    <!-- Add Version form -->
                    <div class="collapse px-3 mb-3" id="addVersionForm_@item.Id">
                        <div class="card card-body bg-white border border-primary border-opacity-10 shadow-sm rounded-4 p-4">
                            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-light">
                                <h6 class="fw-bold mb-0 text-dark">
                                    <i class="bi bi-plus-circle-fill me-2 text-primary" aria-hidden="true"></i>Register New Version
                                </h6>
                                <button type="button" class="btn-close" data-bs-toggle="collapse" data-bs-target="#addVersionForm_@item.Id" aria-label="Close"></button>
                            </div>
                            <form asp-action="AddLicense" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="standardSoftwareId" value="@item.Id" />
                                
                                <div class="row g-4">
                                    <!-- Row 1: Name and Expiry -->
                                    <div class="col-12 col-md-6">
                                        <label class="form-label small fw-bold text-uppercase text-muted" style="letter-spacing: 0.05em; font-size: 0.72rem;">Version Name / Edition</label>
                                        <input type="text" name="softwareName" class="form-control rounded-3 border-light-subtle shadow-sm px-3"
                                               placeholder="e.g. Adobe Pro 2024" value="@item.SoftwareName" required />
                                    </div>
                                    <div class="col-12 col-md-6" id="expiryCol_@item.Id">
                                        <label class="form-label small fw-bold text-uppercase text-muted" style="letter-spacing: 0.05em; font-size: 0.72rem;">License Expiry Date</label>
                                        <input type="date" name="expiryDate" class="form-control rounded-3 border-light-subtle shadow-sm px-3" />
                                    </div>

                                    <!-- Row 2: Switches -->
                                    <div class="col-12">
                                        <div class="d-flex gap-5 p-3 bg-light bg-opacity-50 rounded-4 border border-light-subtle">
                                            <div class="form-check form-switch mb-0" id="subWrapper_@item.Id">
                                                <input class="form-check-input" type="checkbox" name="isSubscription" value="true" checked="checked"
                                                       id="sub_@item.Id" onchange="toggleKeyInput(@item.Id, this)" />
                                                <label class="form-check-label fw-semibold" for="sub_@item.Id">Subscription</label>
                                            </div>
                                            <div class="form-check form-switch mb-0">
                                                <input class="form-check-input" type="checkbox" name="isFree" value="true"
                                                       id="free_@item.Id" onchange="toggleFreeInput(@item.Id, this)" />
                                                <label class="form-check-label fw-semibold text-success" for="free_@item.Id">Free Software</label>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Row 3: Dynamic Fields (Vendor, Support, Limit) -->
                                    <div class="col-12" id="subFields_@item.Id">
                                        <div class="row g-3 p-3 bg-white border border-light rounded-4 shadow-sm mx-0">
                                            <div class="col-12 col-md-4">
                                                <label class="form-label small fw-bold text-uppercase text-muted" style="letter-spacing: 0.05em; font-size: 0.72rem;">Vendor Name</label>
                                                <input type="text" name="vendorName" class="form-control rounded-2 px-3" placeholder="Authorized supplier..." />
                                            </div>
                                            <div class="col-12 col-md-5">
                                                <label class="form-label small fw-bold text-uppercase text-muted" style="letter-spacing: 0.05em; font-size: 0.72rem;">Support Hub / Contact</label>
                                                <input type="text" name="supportContact" class="form-control rounded-2 px-3" placeholder="Phone or portal URL..." />
                                            </div>
                                            <div class="col-12 col-md-3">
                                                <label class="form-label small fw-bold text-uppercase text-muted" style="letter-spacing: 0.05em; font-size: 0.72rem;">Initial Seats (auto-created)</label>
                                                <input type="number" name="contractLimit" class="form-control rounded-2 px-3" value="1" min="1" />
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Additional Fields & Submit -->
                                    <div class="col-12 col-md-8">
                                        <label class="form-label small fw-bold text-uppercase text-muted" style="letter-spacing: 0.05em; font-size: 0.72rem;">Internal Notes (Optional)</label>
                                        <input type="text" name="description" class="form-control rounded-3 border-light-subtle shadow-sm px-3" placeholder="Reference purchase order or department..." />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small fw-bold text-uppercase text-muted" style="letter-spacing: 0.05em; font-size: 0.72rem;">Assigned Companies</label>
                                        <select name="selectedCompanyId"
                                                id="companySelect_@item.Id"
                                                class="form-select rounded-3 border-light-subtle shadow-sm px-3">
                                            <option value="">Global (All Companies)</option>
                                            @if (Model.CompanyOptions != null && Model.CompanyOptions.Any())
                                            {
                                                foreach (var company in Model.CompanyOptions)
                                                {
                                                    <option value="@company.Id">@company.DisplayName</option>
                                                }
                                            }
                                            else
                                            {
                                                <option disabled>No active companies available</option>
                                            }
                                        </select>
                                        <div class="form-text text-muted mt-2">
                                            Select one company from the list, or keep it as Global if you have cross-company access.
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-4 d-flex align-items-end">
                                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow rounded-3" style="background: linear-gradient(135deg, #0d6efd, #0b5ed7);">
                                            <i class="bi bi-save2-fill me-2" aria-hidden="true"></i>Deploy Version
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div> <!-- End card -->
                    </div> <!-- End addVersionForm -->
                </div> <!-- End ps-5 collapse #versions_item.Id -->
            </div> <!-- End item row container -->
        }
        @if (!Model.SoftwareList.Any())
        {
            <div class="text-center text-muted py-5">
                No software catalog entries yet. Click <strong>Add Software</strong> or use <strong>Bulk Import</strong>.
            </div>
        }
    </div>
</div>

<!-- Edit Key Modal -->
<div class="modal fade" id="editKeyModal" tabindex="-1" aria-labelledby="editKeyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg" style="border-radius:12px;">
            <div class="modal-header py-2 bg-warning bg-opacity-25 border-0" style="border-radius:12px 12px 0 0;">
                <h6 class="modal-title fw-bold" id="editKeyModalLabel"><i class="bi bi-pencil me-2" aria-hidden="true"></i>Edit License Key</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editKeyId" />
                <input type="hidden" id="editKeyVersionId" />
                <label class="form-label small fw-semibold">License Key</label>
                <input type="text" id="editKeyValue" class="form-control" />
                <div id="editKeyError" class="text-danger small mt-1 d-none"></div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-primary" onclick="saveEditKey()">
                    <i class="bi bi-check-lg me-1" aria-hidden="true"></i>Save
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Assign Key Modal -->
<div class="modal fade" id="assignKeyModal" tabindex="-1" aria-labelledby="assignKeyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:12px;">
            <div class="modal-header py-2 bg-success bg-opacity-25 border-0" id="assignKeyModalHeader" style="border-radius:12px 12px 0 0;">
                <h6 class="modal-title fw-bold" id="assignKeyModalLabel"><i class="bi bi-person-check me-2" aria-hidden="true"></i>Assign License Key</h6>

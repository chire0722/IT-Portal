@* Project comment: Create.cshtml renders part of the IT Form web user interface. *@

@model IT_Form.Application.Features.EmailContact.EmailContactEditorPageViewModel

@{
    ViewData["Title"] = "Add Email Contact";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                    <div class="d-flex align-items-center gap-3">
                        <a asp-action="Index" class="btn btn-light rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;" aria-label="Cancel and return">
                            <i class="bi bi-arrow-left" aria-hidden="true"></i>
                        </a>
                        <h3 class="mb-0 text-primary fw-bold">Add Email Contact</h3>
                    </div>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="row g-4">
                            <div class="col-md-5">
                                <label asp-for="Name" class="form-label fw-semibold text-secondary">Full Name <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control form-control-lg bg-light" placeholder="e.g. John Doe" />
                                <span asp-validation-for="Name" class="text-danger small mt-1"></span>
                            </div>
                            <div class="col-md-7">
                                <label asp-for="EmailAddress" class="form-label fw-semibold text-secondary">Email Address <span class="text-danger">*</span></label>
                                <input asp-for="EmailAddress" type="email" class="form-control form-control-lg bg-light" placeholder="e.g. jdoe@example.com" />
                                <span asp-validation-for="EmailAddress" class="text-danger small mt-1"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Department" class="form-label fw-semibold text-secondary">Department / Notes</label>
                                <input asp-for="Department" class="form-control form-control-lg bg-light" placeholder="e.g. External IT Vendor, Marketing" />
                                <span asp-validation-for="Department" class="text-danger small mt-1"></span>
                            </div>
                        </div>

                        <div class="mt-5 d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-pill">Cancel</a>
                            <button type="submit" class="btn btn-primary px-5 py-2 rounded-pill fw-bold shadow-sm">
                                <i class="bi bi-check-circle me-1" aria-hidden="true"></i> Save Contact
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

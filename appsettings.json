{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=|DataDirectory|IT_FormDB.db"
  },
  "DatabaseBackup": {
    "BackupPath": "App_Data/backups",
    "AdditionalBackupPath": ""
  },
  "DatabaseBackup2": {
    "AdditionalBackupPath": ""
  },
  "SmtpSettings": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromName": "IT Portal",
    "EnableSsl": true
  },
  "AppDomain": "",
  "LoginPageBranding": {
    "CompanyName": "YTC",
    "SystemName": "IT Portal",
    "Subtitle": "IT Asset & Access Management System",
    "BackgroundImagePath": "",
    "SystemVersion": ""
  },
  "InventorySync": {
    "ApiKey": ""
  },
  "SignatureHmac": {
    "Key": ""
  },
  "SecuritySettings": {
    "MaxOtpAttempts": 5,
    "PasswordLockoutMinutes": [
      5,
      15,
      30,
      120
    ],
    "OtpExpiryMinutes": 3,
    "DeviceVerificationExpiryMinutes": 30,
    "AllowLegacyInventoryApiKey": false,
    "CookieSecurePolicy": "SameAsRequest",

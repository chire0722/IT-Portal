@* Project comment: Profile.cshtml renders part of the IT Form web user interface. *@

@model IT_Form.Application.Features.Account.Queries.GetProfilePage.AccountProfilePageViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
            <div class="card animate-in shadow-sm" style="border-radius: 16px;">
                <div class="card-header bg-transparent border-bottom-0 pb-0 pt-4 px-4">
                    <h3 class="fw-bold mb-0 text-primary">My Profile</h3>
                    <p class="text-muted small mt-1">Manage your account details and digital signature.</p>
                </div>

                <div class="card-body p-4">
                    <!-- User Info Section -->
                    <div class="d-flex align-items-center mb-4 p-3 bg-light rounded-3"
                        style="background-color: var(--bs-gray-100);">
                        <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3"
                            style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: bold;">
                            @(Model.FullName?.Substring(0, 1).ToUpper() ?? Model.Email?.Substring(0, 1).ToUpper())
                        </div>
                        <div>
                            <h5 class="mb-1 fw-bold">@Model.FullName</h5>
                            <div class="text-muted small mb-2"><i class="bi bi-envelope me-1" aria-hidden="true"></i>@Model.Email</div>
                            <div class="d-flex gap-1 flex-wrap">
                                @if (Model.Titles != null && Model.Titles.Any())
                                {
                                    foreach (var title in Model.Titles)
                                    {
                                        var badgeColor = title switch
                                        {
                                            "IT" => "bg-primary",
                                            "HR" => "bg-success",
                                            "Manager" => "bg-warning text-dark",
                                            _ => "bg-secondary"
                                        };
                                        <span class="badge @badgeColor rounded-pill rounded-px-2 py-1">@title</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill rounded-px-2 py-1">Standard User</span>
                                }
                            </div>
                        </div>
                    </div>

                    <hr class="my-4 text-muted opacity-25" />

                    <!-- Signature Image Section -->
                    <div class="mb-0">
                        <h5 class="fw-bold mb-3"><i class="bi bi-briefcase me-2 text-primary" aria-hidden="true"></i>Email Signature Image</h5>
                        <p class="text-muted small mb-3">
                            Your <strong>uploaded signature image</strong> will be included at the bottom of every email you send from this system.
                        </p>
                        <form asp-action="UpdateProfile" method="post" enctype="multipart/form-data">
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Full Name</label>
                                <input type="text" class="form-control" value="@Model.FullName" disabled />
                                <div class="form-text">Managed by IT Admin. Contact IT to update.</div>
                            </div>
                            <!-- Job Title hidden as it is not used in signature anymore but still stored in DB if needed later -->
                            <input type="hidden" name="jobTitle" value="@Model.JobTitle" />

                            <!-- Email Signature Image Upload -->
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Email Signature Image</label>
                                <p class="text-muted small mb-2">Upload your email signature block image (QR code, company logo, contact details, etc.). This image will appear at the bottom of every email you send.</p>
                                
                                @if (!string.IsNullOrEmpty(Model.EmailSignatureImage))
                                {
                                    <div class="mb-2 p-2 bg-light rounded border" id="sigImagePreview">
                                        <img src="@Model.EmailSignatureImage" alt="Email Signature" style="max-width: 100%; max-height: 200px;" />
                                    </div>
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" id="removeSignatureImage" name="removeSignatureImage" value="true" />
                                        <label class="form-check-label small text-danger" for="removeSignatureImage">Remove current image</label>
                                    </div>
                                }
                                
                                <input type="file" class="form-control" id="signatureImageFile" name="signatureImageFile" accept="image/png,image/jpeg,image/gif" data-drag-upload="true" data-max-file-size="512000" />
                                <div class="form-text">Accepted formats: PNG, JPG, GIF. Max size: 500 KB.</div>
                                
                                <!-- Live preview for new upload -->
                                <div id="newSigPreview" class="mt-2 p-2 bg-light rounded border d-none">
                                    <img id="newSigImg" src="" alt="Preview" style="max-width: 100%; max-height: 200px;" />
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary rounded-pill px-4">
                                <i class="bi bi-check2-circle me-1" aria-hidden="true"></i>Save Details
                            </button>
                        </form>
                    </div>

                    <hr class="my-4 text-muted opacity-25" />

                    <div class="mb-0">
                        <h5 class="fw-bold mb-3"><i class="bi bi-key me-2 text-primary" aria-hidden="true"></i>Change Password</h5>
                        <p class="text-muted small mb-3">
                            Enter your current password and new password. A verification code will be emailed to confirm the change.
                        </p>
                        <form asp-action="BeginProfilePasswordChange" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted" for="profileCurrentPassword">Current Password</label>
                                <div class="input-group">
                                    <input type="password" class="form-control" id="profileCurrentPassword" name="CurrentPassword" autocomplete="current-password" />
                                    <button class="btn btn-outline-secondary" type="button" data-csp-click="toggleProfilePassword" data-csp-arg0="profileCurrentPassword" title="Show or hide password">
                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted" for="profileNewPassword">New Password</label>
                                <div class="input-group">
                                    <input type="password" class="form-control" id="profileNewPassword" name="NewPassword" autocomplete="new-password" />
                                    <button class="btn btn-outline-secondary" type="button" data-csp-click="toggleProfilePassword" data-csp-arg0="profileNewPassword" title="Show or hide password">
                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <div class="form-text">Minimum 10 characters with uppercase, lowercase, number, and symbol.</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted" for="profileConfirmPassword">Confirm New Password</label>
                                <div class="input-group">
                                    <input type="password" class="form-control" id="profileConfirmPassword" name="ConfirmPassword" autocomplete="new-password" />
                                    <button class="btn btn-outline-secondary" type="button" data-csp-click="toggleProfilePassword" data-csp-arg0="profileConfirmPassword" title="Show or hide password">
                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-outline-primary rounded-pill px-4">
                                <i class="bi bi-shield-check me-1" aria-hidden="true"></i>Send Verification Code
                            </button>
                        </form>
                    </div>

                    <hr class="my-4 text-muted opacity-25" />

                    <!-- Signature Section -->
                    <div>
                        <h5 class="fw-bold mb-3"><i class="bi bi-pen me-2 text-primary" aria-hidden="true"></i>My Digital Signature</h5>
                        <p class="text-muted small mb-3">
                            Save your signature here to enable <strong>1-Click Auto-Sign</strong> on Onboarding and
                            Offboarding forms.
                        </p>

                        <form asp-action="UpdateSignature" method="post" id="profileSignatureForm">
                            <input type="hidden" id="signatureDataInput" name="signatureData"
                                value="@Model.Signature" />

                            <div class="position-relative">
                                <!-- Signature Canvas -->
                                <canvas id="profileCanvas" class="w-100" height="150"
                                    style="border: 1px solid var(--border); border-radius: 12px; background-color: var(--sig-bg); cursor: crosshair;"></canvas>

                                <!-- Hidden file input for upload -->
                                <input type="file" id="signatureImageUpload" accept="image/*" class="d-none" />
                            </div>

                            <div class="mt-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3"
                                        data-csp-click="clearProfileCanvas">
                                        <i class="bi bi-eraser me-1" aria-hidden="true"></i>Clear
                                    </button>
                                    <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3"
                                        data-csp-click="click-target" data-csp-target="signatureImageUpload">
                                        <i class="bi bi-image me-1" aria-hidden="true"></i>Upload Image
                                    </button>
                                </div>

                                <button type="submit" class="btn btn-primary rounded-pill px-4"
                                    data-csp-click="saveSignature">
                                    <i class="bi bi-check2-circle me-1" aria-hidden="true"></i>Save Signature
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const canvas = document.getElementById('profileCanvas');
        const ctx = canvas.getContext('2d');
        let drawing = false;

        // Existing saved signature tracking
        const savedSignature = document.getElementById('signatureDataInput').value;

        // Initialize Canvas
        function initProfileCanvas() {
            canvas.width = canvas.offsetWidth;
            canvas.height = 150;

            const style = getComputedStyle(document.documentElement);
            ctx.strokeStyle = style.getPropertyValue('--sig-stroke').trim() || '#e8eaf6';
            ctx.lineWidth = 2;
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';

            // Base Background - transparent (CSS handles visual bg)
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // If user already has a signature, draw it on the canvas immediately
            if (savedSignature && savedSignature.startsWith('data:image')) {
                const img = new Image();
                img.onload = function () {
                    // Calculate scaling to fit image nicely in canvas
                    const hRatio = canvas.width / img.width;
                    const vRatio = canvas.height / img.height;
                    const ratio = Math.min(hRatio, vRatio);

                    const centerShift_x = (canvas.width - img.width * ratio) / 2;
                    const centerShift_y = (canvas.height - img.height * ratio) / 2;

                    ctx.drawImage(img, 0, 0, img.width, img.height,
                        centerShift_x, centerShift_y, img.width * ratio, img.height * ratio);
                };
                img.src = savedSignature;
            }

            // Mouse/Touch Events
            function getPos(e) {
                const rect = canvas.getBoundingClientRect();
                const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                const clientY = e.touches ? e.touches[0].clientY : e.clientY;
                return { x: clientX - rect.left, y: clientY - rect.top };
            }

            canvas.addEventListener('mousedown', (e) => { drawing = true; ctx.beginPath(); const p = getPos(e); ctx.moveTo(p.x, p.y); });
            canvas.addEventListener('mousemove', (e) => { if (!drawing) return; const p = getPos(e); ctx.lineTo(p.x, p.y); ctx.stroke(); });
            canvas.addEventListener('mouseup', () => drawing = false);
            canvas.addEventListener('mouseleave', () => drawing = false);

            canvas.addEventListener('touchstart', (e) => { e.preventDefault(); drawing = true; ctx.beginPath(); const p = getPos(e); ctx.moveTo(p.x, p.y); });
            canvas.addEventListener('touchmove', (e) => { e.preventDefault(); if (!drawing) return; const p = getPos(e); ctx.lineTo(p.x, p.y); ctx.stroke(); });
            canvas.addEventListener('touchend', () => drawing = false);
        }

        // Clear Canvas manually
        function clearProfileCanvas() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            document.getElementById('signatureDataInput').value = '';
        }

        // Handle Image Upload
        document.getElementById('signatureImageUpload').addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function (event) {
                const img = new Image();
                img.onload = function () {
                    // Clear existing canvas
                    ctx.clearRect(0, 0, canvas.width, canvas.height);

                    // Draw uploaded image
                    const hRatio = canvas.width / img.width;
                    const vRatio = canvas.height / img.height;
                    const ratio = Math.min(hRatio, vRatio);

                    const centerShift_x = (canvas.width - img.width * ratio) / 2;
                    const centerShift_y = (canvas.height - img.height * ratio) / 2;

                    ctx.drawImage(img, 0, 0, img.width, img.height,
                        centerShift_x, centerShift_y, img.width * ratio, img.height * ratio);
                }
                img.src = event.target.result;
            }
            reader.readAsDataURL(file);
        });

        function isCanvasBlank() {
            const blank = document.createElement('canvas');
            blank.width = canvas.width;
            blank.height = canvas.height;
            return canvas.toDataURL() === blank.toDataURL();
        }

        function getCanvasDataWithWhiteBg() {
            const tmp = document.createElement('canvas');
            tmp.width = canvas.width;
            tmp.height = canvas.height;
            const tmpCtx = tmp.getContext('2d');
            tmpCtx.fillStyle = '#ffffff';
            tmpCtx.fillRect(0, 0, tmp.width, tmp.height);
            tmpCtx.drawImage(canvas, 0, 0);
            return tmp.toDataURL('image/png');
        }

        function saveSignature() {
            if (isCanvasBlank()) {
                // Allows clearing the signature completely
                document.getElementById('signatureDataInput').value = '';
            } else {
                document.getElementById('signatureDataInput').value = getCanvasDataWithWhiteBg();
            }
            return true;
        }

        // Initialize on load and resize
        window.addEventListener('load', initProfileCanvas);
        // window.addEventListener('resize', initProfileCanvas); // disabled resize auto-clear for profile to preserve loaded image
        
        // Live preview for email signature image upload
        var sigFileInput = document.getElementById('signatureImageFile');
        if (sigFileInput) {
            sigFileInput.addEventListener('change', function(e) {
                var file = e.target.files[0];
                var preview = document.getElementById('newSigPreview');
                var img = document.getElementById('newSigImg');
                if (file && file.type.startsWith('image/')) {
                    var reader = new FileReader();
                    reader.onload = function(ev) {
                        img.src = ev.target.result;
                        preview.classList.remove('d-none');
                    };
                    reader.readAsDataURL(file);
                } else {
                    preview.classList.add('d-none');
                }
            });
        }

        function toggleProfilePassword(inputId, button) {
            const input = document.getElementById(inputId);
            if (!input) return;
            const icon = button.querySelector('i');
            const show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            if (icon) {
                icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
            }
        }
    </script>
}




                            <div>
                                <i class="bi bi-lock-fill d-block mb-1 fs-5" aria-hidden="true"></i>
                                <span class="fw-bold text-uppercase" style="letter-spacing: 0.5px; font-size: 0.7rem;">Pending internal approvals</span>
                            </div>
                        </div>

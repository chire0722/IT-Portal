@* Project comment: Delete.cshtml renders part of the IT Form web user interface. *@

@model IT_Form.Models.OnboardingRequest
@{
    ViewData["Title"] = $"Delete — {Model.FullName}";
}

<div class="animate-in" style="max-width: 600px; margin: 2rem auto;">
    <div class="card">
        <div class="card-header"
            style="background: rgba(239, 83, 80, 0.1); border-bottom-color: rgba(239, 83, 80, 0.2);">
            <h5 class="mb-0" style="color: var(--danger);">
                <i class="fas fa-exclamation-triangle me-2" aria-hidden="true"></i>Confirm Delete
            </h5>
        </div>
        <div class="card-body">
            <p style="color: var(--text-secondary);">
                Are you sure you want to <strong style="color: var(--danger);">permanently delete</strong> this
                onboarding request?
            </p>

            <div class="p-3 mb-4"
                style="background: var(--bg-secondary); border-radius: 12px; border: 1px solid var(--border);">
                <table class="table table-sm mb-0" style="border: none;">
                    <tr>
                        <td style="color: var(--text-muted); width: 40%;">Name</td>
                        <td><strong>@Model.FullName</strong></td>
                    </tr>
                    <tr>
                        <td style="color: var(--text-muted);">Department</td>
                        <td>@Model.Department</td>
                    </tr>
                    <tr>
                        <td style="color: var(--text-muted);">Submitted</td>
                        <td>@Model.RequestDate.ToString("dd/MM/yyyy")</td>
                    </tr>
                    <tr>
                        <td style="color: var(--text-muted);">Status</td>
                        <td>@Model.Status</td>
                    </tr>
                </table>
            </div>

            <div class="alert alert-danger">
                <i class="fas fa-info-circle me-2" aria-hidden="true"></i>
                This action cannot be undone. All associated assets, permissions, and signatures will also be removed.
            </div>

            <div class="mb-4 text-center">
                <label for="deleteConfirmation" class="form-label text-danger">Type <strong>DELETE</strong> below to
                    confirm:</label>
                <input type="text" class="form-control text-center text-danger fw-bold mx-auto" id="deleteConfirmation"
                    autocomplete="off" style="max-width: 200px;" />
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1" aria-hidden="true"></i>Cancel
                </a>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger" id="btnConfirmDelete" disabled>
                        <i class="fas fa-trash-alt me-2" aria-hidden="true"></i>Delete Permanently
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const deleteInput = document.getElementById('deleteConfirmation');
            const deleteBtn = document.getElementById('btnConfirmDelete');

            deleteInput.addEventListener('input', function () {
                if (this.value === 'DELETE') {
                    deleteBtn.disabled = false;
                } else {
                    deleteBtn.disabled = true;
                }
            });

            // Focus input automatically
            deleteInput.focus();
        });
    </script>
}



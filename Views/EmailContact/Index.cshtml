@* Project comment: Index.cshtml renders part of the IT Form web user interface. *@

@model IEnumerable<IT_Form.Application.Features.EmailContact.EmailContactIndexListItem>
@{
    ViewData["Title"] = "Email Directory";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 text-primary fw-bold">Email Directory</h2>
            <p class="text-muted mb-0">Manage external and internal email contacts for quick sending.</p>
        </div>
        <div class="d-flex gap-2">
            @if (User.HasClaim("UserTitle", "IT"))
            {
                <button type="button" class="btn btn-success shadow-sm rounded-pill px-4 py-2 fw-bold text-white" data-bs-toggle="modal" data-bs-target="#importModal">
                    <i class="bi bi-upload me-1"></i> Bulk Import
                </button>
            }
            <a asp-action="Create" class="btn btn-primary shadow-sm d-inline-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-person-plus me-1"></i> Add Contact
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-info-circle-fill me-2" aria-hidden="true"></i>@TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="contactsTable" class="table table-hover align-middle mb-0 datatable-dynamic">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 text-secondary fw-semibold py-3 border-bottom-0">Name</th>
                            <th class="text-secondary fw-semibold py-3 border-bottom-0">Email Address</th>
                            <th class="text-secondary fw-semibold py-3 border-bottom-0">Department/Notes</th>
                            @if (User.HasClaim("UserTitle", "IT"))
                            {
                                <th class="text-secondary fw-semibold py-3 border-bottom-0 text-center">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-medium text-dark">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-sm bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 35px; height: 35px; font-weight: bold;">
                                            @(item.Name.Length > 0 ? item.Name.Substring(0, 1).ToUpper() : "?")
                                        </div>
                                        @item.Name
                                    </div>
                                </td>
                                <td><a href="mailto:@item.EmailAddress" class="text-decoration-none">@item.EmailAddress</a></td>
                                <td class="text-muted">@(item.Department ?? "—")</td>
                                @if (User.HasClaim("UserTitle", "IT"))
                                {
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <a class="btn btn-action-circle btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id" title="Edit">
                                                <i class="bi bi-pencil" aria-hidden="true"></i>
                                            </a>
                                            <button type="button" class="btn btn-action-circle btn-outline-danger" title="Delete"
                                                    data-csp-click="openDeleteModal" data-csp-arg0="@item.Id" data-csp-arg1="@item.Name">
                                                <i class="bi bi-trash" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Bulk Import Modal -->
<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 480px;">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header text-white border-0 py-3"
                style="background: linear-gradient(135deg,#1a9c56,#15803d);">
                <h5 class="modal-title fw-bold" id="importModalLabel">
                    <i class="bi bi-upload me-2" aria-hidden="true"></i>Email Contact Bulk Import
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-info d-flex gap-2 py-2 px-3 rounded-3 mb-4" style="font-size:0.88rem;">
                    <i class="bi bi-info-circle-fill mt-1 flex-shrink-0" aria-hidden="true"></i>
                    <div>
                        <strong>Professional Template:</strong> Download the template — columns have the correct format
                        ready to fill.
                        <br />
                        <a asp-action="DownloadImportTemplate" class="fw-semibold text-decoration-none mt-1 d-inline-block">
                            <i class="bi bi-file-earmark-arrow-down me-1" aria-hidden="true"></i>Download Template (.xlsx)
                        </a>
                    </div>
                </div>
                <form asp-action="BulkImport" method="post" enctype="multipart/form-data" id="importForm">
                    @Html.AntiForgeryToken()
                    <div class="mb-1">
                        <label class="form-label text-uppercase fw-bold"
                            style="font-size:0.72rem;letter-spacing:.08em;color:#6b7280;">
                            Select Excel File
                        </label>
                        <input type="file" name="file" accept=".xlsx" required data-drag-upload="true"
                            class="form-control border rounded-3" />
                    </div>
                    <p class="text-muted mb-0" style="font-size:0.78rem;">Maximum file size: 5MB. Only .xlsx files are
                        supported.</p>
                </form>
            </div>
            <div class="modal-footer border-0 px-4 pb-4 pt-0 gap-2">
                <button type="button" class="btn btn-light px-4 rounded-3" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="importForm" class="btn px-4 rounded-3 text-white fw-semibold"
                    style="background:linear-gradient(135deg,#1a9c56,#15803d);">
                    <i class="bi bi-cloud-upload me-2" aria-hidden="true"></i>Start Import
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg" style="border-radius:12px;">
            <div class="modal-header py-2 bg-danger bg-opacity-25 border-0" style="border-radius:12px 12px 0 0;">
                <h6 class="modal-title fw-bold text-danger" id="deleteModalLabel"><i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>Delete Contact</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">Are you sure you want to delete this contact?</p>
                <div class="bg-light rounded px-3 py-2">
                    <span class="fw-bold text-danger" id="deleteItemName"></span>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger">
                        <i class="bi bi-trash me-1" aria-hidden="true"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
        function openDeleteModal(id, name) {
            document.getElementById('deleteItemName').textContent = name;
            document.getElementById('deleteForm').action = '/EmailContact/Delete/' + id;
            deleteModal.show();
        }
    </script>
}


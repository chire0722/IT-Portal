@model IT_Form.Application.Features.Account.Writes.ForceChangePassword.ForceChangePasswordPageViewModel
@{
    ViewData["Title"] = "Change Password";

    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Change Password - YTC IT Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .force-pw-banner {
            background: linear-gradient(135deg, #fff3cd 0%, #ffe69c 100%);
            border-left: 4px solid #f0ad4e;
            border-radius: 8px;
            padding: 1rem 1.25rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
        }

        .force-pw-banner i {
            color: #b8860b;
            margin-top: 2px;
            flex-shrink: 0;
        }

        .force-pw-banner p {
            margin: 0;
            color: #664d03;
            font-size: 0.92rem;
            line-height: 1.5;
        }
    </style>
</head>

<body>
    <div class="auth-container">
        <div class="auth-card animate-in">
            <div class="auth-header">
                <div style="margin-bottom: 0.75rem;">
                    <img src="~/images/logo-combined.png" alt="PYT & YTC" style="max-width: 280px; height: auto;" />
                </div>
                <h1>IT Portal</h1>
                <p>IT Asset &amp; Access Management System</p>
            </div>
            <div class="auth-body">

                <div class="force-pw-banner">
                    <i class="fas fa-shield-alt fa-lg" aria-hidden="true"></i>
                    <p>
                        <strong>Password change required.</strong><br />
                        Your current password was set by the IT Administrator. For security purposes,
                        please choose a new personal password before continuing.
                    </p>
                </div>

                <form asp-action="ForceChangePassword" method="post">
                    <div asp-validation-summary="All" class="alert alert-danger"
                        style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label">
                            <i class="fas fa-lock me-1" aria-hidden="true"></i> @Html.DisplayNameFor(m => m.CurrentPassword)
                        </label>
                        <div class="input-group">
                            <input asp-for="CurrentPassword" class="form-control" placeholder="Enter current password"
                                id="currentPasswordInput" />
                            <button class="btn btn-outline-secondary" type="button" id="toggleCurrentPassword">
                                <i class="fas fa-eye" id="toggleCurrentIcon" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger" aria-live="polite"
                            aria-atomic="true"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label">
                            <i class="fas fa-lock me-1" aria-hidden="true"></i> @Html.DisplayNameFor(m => m.NewPassword)
                        </label>
                        <div class="input-group">
                            <input asp-for="NewPassword" class="form-control" placeholder="Enter new password"
                                id="newPasswordInput" />
                            <button class="btn btn-outline-secondary" type="button" id="toggleNewPassword">
                                <i class="fas fa-eye" id="toggleNewIcon" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger" aria-live="polite"
                            aria-atomic="true"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label">
                            <i class="fas fa-lock me-1" aria-hidden="true"></i> @Html.DisplayNameFor(m =>
                            m.ConfirmPassword)
                        </label>
                        <div class="input-group">
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm new password"
                                id="confirmPasswordInput" />
                            <button class="btn btn-outline-secondary" type="button" id="toggleConfirmPassword">
                                <i class="fas fa-eye" id="toggleConfirmIcon" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger" aria-live="polite"
                            aria-atomic="true"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100">
                        <i class="fas fa-key me-2" aria-hidden="true"></i>Set New Password
                    </button>
                </form>

            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>

    <script>
        function toggleVisibility(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        }
        document.getElementById('toggleCurrentPassword').addEventListener('click', () => toggleVisibility('currentPasswordInput', 'toggleCurrentIcon'));
        document.getElementById('toggleNewPassword').addEventListener('click', () => toggleVisibility('newPasswordInput', 'toggleNewIcon'));
        document.getElementById('toggleConfirmPassword').addEventListener('click', () => toggleVisibility('confirmPasswordInput', 'toggleConfirmIcon'));
    </script>
</body>

</html>
